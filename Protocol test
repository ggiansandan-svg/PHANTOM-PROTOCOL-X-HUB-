	function Win:ToggleVisibility(force)
		local target = force
		if target == nil then target = not self.Visible end
		if target == self.Visible then return end
		self.Visible = target
		if target then
			Main.Visible = true
			SetFade(Main, 1)
			TwFade(Main, 0, TS)
		else
			ClosePopups()
			TwFade(Main, 1, TS)
			task.delay(0.3, function()
				if not self.Visible then Main.Visible = false end
			end)
		end
		for _, wm in ipairs(self.Watermarks) do wm:UpdatePosition() end
	end
