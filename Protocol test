		--// TOGGLE ----------------------------------------------------
		function TabObj:Toggle(tOpts)
			tOpts = tOpts or {}                       -- FIX #16
			local compTitle = tOpts.Title    or "Toggle"
			local Default   = tOpts.Default and true or false
			local Desc      = tOpts.Description
			local Callback  = tOpts.Callback or function() end
			local FlagName  = tOpts.Flag     or (TabTitle .. "/" .. compTitle)

			local rowH = Desc and (IsMobile and 54 or 62) or (IsMobile and 42 or 50)
			local Row  = CreateRow(compTitle, rowH, Desc)
			local State = Default

			local PillW = IsMobile and 36 or 40
			local PillH = IsMobile and 20 or 22
			local CircleSz = PillH - 4

			local TextArea = New("Frame", {
				Size = UDim2.new(1, -(PillW + 26), 1, 0), Position = UDim2.fromOffset(6, 0),
				BackgroundTransparency = 1, ZIndex = 5, Parent = Row,
			})
			List(TextArea, 2, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)

			local TLbl = New("TextLabel", {
				Size = UDim2.new(1, 0, 0, IsMobile and 16 or 18),
				BackgroundTransparency = 1, Text = compTitle,
				TextColor3 = Theme.TextPrimary, Font = Theme.Font,
				TextSize = IsMobile and 12 or 14, TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 1, ZIndex = 5, Parent = TextArea,
			})
			local DLbl
			if Desc then
				DLbl = New("TextLabel", {
					Size = UDim2.new(1, 0, 0, 12), BackgroundTransparency = 1, Text = Desc,
					TextColor3 = Theme.TextSecondary, Font = Theme.Font,
					TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 2, ZIndex = 5, Parent = TextArea,
				})
			end

			local Pill = New("Frame", {
				Size = UDim2.fromOffset(PillW, PillH),
				Position = UDim2.new(1, -(PillW + 8), 0.5, -(PillH / 2)),
				BackgroundColor3 = State and Theme.Accent or Theme.Border,
				BorderSizePixel = 0, ZIndex = 5, Parent = Row,
			})
			Corner(Pill, PillH / 2)

			local Circle = New("Frame", {
				Size = UDim2.fromOffset(CircleSz, CircleSz),
				Position = State and UDim2.fromOffset(PillW - CircleSz - 2, 2) or UDim2.fromOffset(2, 2),
				BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 6, Parent = Pill,
			})
			Corner(Circle, CircleSz / 2)

			-- whole row is tappable: much friendlier on phones
			local ToggleBtn = New("TextButton", {
				Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
				Text = "", AutoButtonColor = false, ZIndex = 7, Parent = Row,
			})

			local function SetState(s, fire)
				State = s and true or false
				Tw(Pill, { BackgroundColor3 = State and Theme.Accent or Theme.Border }, TF)
				Tw(Circle, {
					Position = State and UDim2.fromOffset(PillW - CircleSz - 2, 2) or UDim2.fromOffset(2, 2),
				}, TF)
				if fire then
					local ok, err = pcall(Callback, State)
					if not ok then warn(("[PXHub] toggle %q callback error: %s"):format(compTitle, tostring(err))) end
				end
			end

			ToggleBtn.MouseButton1Click:Connect(function() SetState(not State, true) end)

			OnTheme(function()
				TLbl.TextColor3 = Theme.TextPrimary
				if DLbl then DLbl.TextColor3 = Theme.TextSecondary end
				Tw(Pill, { BackgroundColor3 = State and Theme.Accent or Theme.Border }, TF)
			end, Row)

			local obj = {}
			function obj:GetComponentType() return "Toggle" end
			function obj:GetValue() return State end
			function obj:SetValue(v, silent) SetState(v, not silent) end
			function obj:SetTitle(t) TLbl.Text = tostring(t) end
			function obj:SetDescription(t) if DLbl then DLbl.Text = tostring(t) end end
			function obj:Reset() SetState(Default, true) end

			-- FIX #16: honour a `true` default by firing the callback once
			if Default and tOpts.FireOnLoad ~= false then
				task.defer(function() SetState(true, true) end)
			end

			return RegisterFlag(FlagName, obj, Default)
		end

