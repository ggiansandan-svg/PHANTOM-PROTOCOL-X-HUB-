		function TabObj:SetButtonActive(active)
			if IsConfig then
				Tw(SaveBtn, { BackgroundColor3 = active and Theme.Accent or Theme.Search }, TF)
				return
			end
			if active then
				Tw(TabBtnBg, { BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.78 }, TF)
				Tw(TabBtnImg, { ImageColor3 = Color3.new(1, 1, 1) }, TF)
				Tw(TabBtnFallback, { TextColor3 = Theme.TextPrimary }, TF)
				ActiveBar.BackgroundColor3 = Theme.Accent
				ActiveBar.BackgroundTransparency = 0
			else
				Tw(TabBtnBg, { BackgroundTransparency = 1 }, TF)
				Tw(TabBtnImg, { ImageColor3 = Theme.TextSecondary }, TF)
				Tw(TabBtnFallback, { TextColor3 = Theme.TextSecondary }, TF)
