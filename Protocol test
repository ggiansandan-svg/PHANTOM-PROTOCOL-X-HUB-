				TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 1, ZIndex = 5, Parent = DBInner,
			})
			local Chevron = New("TextLabel", {
				Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, Text = "▾",
				TextColor3 = Theme.TextSecondary, Font = Enum.Font.GothamBold,
				TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right,
				LayoutOrder = 2, ZIndex = 5, Parent = DBInner,
			})

			--// FIX #6: scrollable menu, so long option lists are reachable
			local MenuW = IsMobile and 170 or 210
			local Menu = New("ScrollingFrame", {
				Name = compTitle .. "Menu",
				Size = UDim2.fromOffset(MenuW, 0),
				BackgroundColor3 = Theme.Main, Visible = false, ClipsDescendants = true,
				BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Border,
				CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ZIndex = 6000, Parent = ScreenGui,
			})
			Corner(Menu, 7)
			local MenuStroke = Stroke(Menu, Theme.Border, 1)
			Pad(Menu, 4, 4, 4, 4)
			local MLayout = List(Menu, 2)

			local MSearchF, MSearchBox
			if UseSearch then
				MSearchF = New("Frame", {
					Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = Theme.Search,
					LayoutOrder = 0, ZIndex = 6001, Parent = Menu,
				})
				Corner(MSearchF, 5)
				MSearchBox = New("TextBox", {
					Size = UDim2.new(1, -12, 1, 0), Position = UDim2.fromOffset(6, 0),
					BackgroundTransparency = 1, Text = "", PlaceholderText = "Search...",
					TextColor3 = Theme.TextPrimary, PlaceholderColor3 = Theme.TextSecondary,
					Font = Theme.Font, TextSize = 11, ClearTextOnFocus = false,
					ZIndex = 6002, Parent = MSearchF,
				})
			end

			local OptBtns = {}
			local IsOpen, RenderConn = false, nil

			local function UpdateText()
				if #SelItems == 0 then
					DropText.Text = "Select..."
					DropText.TextColor3 = Theme.TextSecondary
				else
					local s = table.concat(SelItems, ", ")
					DropText.Text = s
					DropText.TextColor3 = Theme.TextPrimary
				end
			end

			local function MenuHeight()
				local content = MLayout.AbsoluteContentSize.Y + 10
				local vp = Viewport()
				return math.clamp(content, 30, math.min(240, vp.Y * 0.45))
			end

			local function CloseMenu()
				if not IsOpen then return end
				IsOpen = false
				Tw(Chevron, { Rotation = 0 }, TF)
				Tw(DropStroke, { Color = Theme.Border }, TF)
				Tw(Menu, { Size = UDim2.fromOffset(MenuW, 0) }, TS)
				task.delay(0.3, function()
					if not IsOpen then
						Menu.Visible = false
						if RenderConn then RenderConn:Disconnect(); RenderConn = nil end
					end
				end)
			end

			local function ApplyVisual(opt, selected)
				local r = OptBtns[opt]
				if not r then return end
				r.ck.Visible = selected
				Tw(r.f, { BackgroundTransparency = selected and 0.8 or 1 }, TF)
				Tw(r.l, { TextColor3 = selected and Theme.Accent or Theme.TextPrimary }, TF)
			end

			local function BuildOpts(list)
				for _, c in ipairs(Menu:GetChildren()) do
					if c:IsA("Frame") and c ~= MSearchF then c:Destroy() end
				end
				table.clear(OptBtns)
				for idx, opt in ipairs(list) do
					local sel = table.find(SelItems, opt) ~= nil
					local of = New("Frame", {
						Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = Theme.Accent,
						BackgroundTransparency = sel and 0.8 or 1, LayoutOrder = idx, ZIndex = 6001, Parent = Menu,
					})
					Corner(of, 5)
					Pad(of, 0, 0, 8, 8)
					local ol = New("TextLabel", {
						Size = UDim2.new(1, -16, 1, 0), BackgroundTransparency = 1, Text = tostring(opt),
						TextColor3 = sel and Theme.Accent or Theme.TextPrimary, Font = Theme.Font,
						TextSize = IsMobile and 11 or 12, TextXAlignment = Enum.TextXAlignment.Left,
						TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 6002, Parent = of,
					})
					local ck = New("ImageLabel", {
						Size = UDim2.fromOffset(12, 12), Position = UDim2.new(1, -14, 0.5, -6),
						BackgroundTransparency = 1, Image = "rbxassetid://10709790644",
						ImageColor3 = Theme.Accent, Visible = sel, ZIndex = 6002, Parent = of,
					})
					local ob = New("TextButton", {
						Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "",
						AutoButtonColor = false, ZIndex = 6003, Parent = of,
					})

					ob.MouseEnter:Connect(function()
						if not table.find(SelItems, opt) then Tw(of, { BackgroundTransparency = 0.88 }, TF) end
					end)
					ob.MouseLeave:Connect(function()
						if not table.find(SelItems, opt) then Tw(of, { BackgroundTransparency = 1 }, TF) end
					end)
					ob.MouseButton1Click:Connect(function()
						if Multi then
							local i = table.find(SelItems, opt)
							if i then table.remove(SelItems, i) else table.insert(SelItems, opt) end
							ApplyVisual(opt, table.find(SelItems, opt) ~= nil)
							UpdateText()
							pcall(Callback, SelItems)
						else
							local previous = SelItems[1]
							table.clear(SelItems)
							table.insert(SelItems, opt)
							if previous then ApplyVisual(previous, false) end
							ApplyVisual(opt, true)
							UpdateText()
							pcall(Callback, opt)
							CloseMenu()
						end
					end)

					OptBtns[opt] = { f = of, l = ol, ck = ck }
				end
			end

			if MSearchBox then
				MSearchBox:GetPropertyChangedSignal("Text"):Connect(function()
					local q = string.lower(MSearchBox.Text)
					for name, r in pairs(OptBtns) do
						r.f.Visible = q == "" or string.find(string.lower(tostring(name)), q, 1, true) ~= nil
					end
				end)
			end

			BuildOpts(Options)
			UpdateText()

			local function UpdateMenuPosition()
				local bp, bs = DropBtn.AbsolutePosition, DropBtn.AbsoluteSize
				local vp = Viewport()
				local tH = MenuHeight()
				local x = math.clamp(bp.X, 4, math.max(4, vp.X - MenuW - 4))
				local y = bp.Y + bs.Y + 4
				if y + tH > vp.Y - 10 then y = math.max(4, bp.Y - tH - 4) end
				Menu.Position = UDim2.fromOffset(x, y)
			end

			local function OpenMenu()
				if IsOpen then return end
				IsOpen = true
				Tw(Chevron, { Rotation = 180 }, TF)
				Tw(DropStroke, { Color = Theme.Accent }, TF)
				UpdateMenuPosition()
				Menu.Visible = true
				Tw(Menu, { Size = UDim2.fromOffset(MenuW, MenuHeight()) }, TS)
				if RenderConn then RenderConn:Disconnect() end
				RenderConn = RunService.RenderStepped:Connect(UpdateMenuPosition)
			end

			DropBtn.MouseButton1Click:Connect(function()
				if IsOpen then CloseMenu() else OpenMenu() end
			end)

			--// FIX #5: touch closes the menu too
			Bind(UserInputService.InputBegan, function(i)
				if i.UserInputType ~= Enum.UserInputType.MouseButton1
					and i.UserInputType ~= Enum.UserInputType.Touch then return end
				if not IsOpen then return end
				local mp = Vector2.new(i.Position.X, i.Position.Y)
				if not PointInside(mp, Menu) and not PointInside(mp, DropBtn) then CloseMenu() end
			end)

			OnTheme(function()
				TLbl.TextColor3 = Theme.TextPrimary
				DropBtn.BackgroundColor3 = Theme.Search
				DropStroke.Color = Theme.Border
				Menu.BackgroundColor3 = Theme.Main
				MenuStroke.Color = Theme.Border
				Menu.ScrollBarImageColor3 = Theme.Border
				if MSearchF then
					MSearchF.BackgroundColor3 = Theme.Search
					MSearchBox.TextColor3 = Theme.TextPrimary
					MSearchBox.PlaceholderColor3 = Theme.TextSecondary
				end
				UpdateText()
				for name, r in pairs(OptBtns) do
					local sel = table.find(SelItems, name) ~= nil
					r.f.BackgroundColor3 = Theme.Accent
					r.f.BackgroundTransparency = sel and 0.8 or 1
					r.l.Font = Theme.Font
					r.l.TextColor3 = sel and Theme.Accent or Theme.TextPrimary
					r.ck.ImageColor3 = Theme.Accent
				end
			end, Row)

			table.insert(Win.Popups, { Close = CloseMenu })

			local obj = {}
			function obj:GetComponentType() return "Dropdown" end
			function obj:GetValue() return Multi and SelItems or SelItems[1] end
			function obj:SetValue(val, silent)
				table.clear(SelItems)
				if Multi then
					if type(val) == "table" then
						for _, v in ipairs(val) do table.insert(SelItems, v) end
					end
				elseif val ~= nil then
					table.insert(SelItems, val)
				end
				for name in pairs(OptBtns) do
					ApplyVisual(name, table.find(SelItems, name) ~= nil)
				end
				UpdateText()
				if not silent then pcall(Callback, Multi and SelItems or SelItems[1]) end
			end
			function obj:SetOptions(list)
				Options = list or {}
				BuildOpts(Options)
				UpdateText()
			end
			function obj:AddOption(opt)
				if not table.find(Options, opt) then
					table.insert(Options, opt)
					BuildOpts(Options)
				end
			end
			function obj:RemoveOption(opt)
				local i = table.find(Options, opt)
				if not i then return end
				table.remove(Options, i)
				local si = table.find(SelItems, opt)
				if si then table.remove(SelItems, si) end
				BuildOpts(Options)
				UpdateText()
			end
			function obj:GetOptions() return Options end
			function obj:Open() OpenMenu() end
			function obj:Close() CloseMenu() end
			function obj:Clear() obj:SetValue(Multi and {} or nil) end
			function obj:Reset() obj:SetValue(Multi and DefaultSelection() or DefaultSelection()[1], true) end
			return RegisterFlag(FlagName, obj, Multi and DefaultSelection() or DefaultSelection()[1])
		end

