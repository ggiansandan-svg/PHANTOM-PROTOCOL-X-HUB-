			Scroll.ScrollBarImageColor3 = Theme.Border
			TabObj:SetButtonActive(Win.CurrentTab == TabObj)
		end, Canvas)

		local function ActivateTab()
			if Win.CurrentTab == TabObj and SearchBox.Text == "" then return end
			if SearchBox.Text ~= "" then SearchBox.Text = "" end

			HomePage.Visible = false
			SearchContent.Visible = false
			Tw(HomeBtn, { BackgroundTransparency = 1 }, TF)

			for _, t in ipairs(Win.Tabs) do
				if t ~= TabObj then
					if t == Win.CurrentTab then
						TwFade(t.Canvas, 1, TS)
						local closing = t
						task.delay(0.3, function()
							if Win.CurrentTab ~= closing then closing.Canvas.Visible = false end
						end)
					else
						t.Canvas.Visible = false
						SetFade(t.Canvas, 1)
					end
					t:SetButtonActive(false)
				end
			end

			Canvas.Visible = true
			SetFade(Canvas, Win.CurrentTab and 1 or 0)
			TwFade(Canvas, 0, TS)
			TabObj:SetButtonActive(true)

			Win.CurrentTab = TabObj
			HeaderTitle.Text = TabTitle
		end

		function TabObj:Activate() ActivateTab() end
		TabBtn.MouseButton1Click:Connect(ActivateTab)

