local _FloatBtn = nil

local function CreateFloatingButton(opts)
	if _FloatBtn and _FloatBtn.Gui and _FloatBtn.Gui.Parent then
		-- already exists: re-wire the click handler instead of stacking a copy
		if opts and opts.OnClick then _FloatBtn:SetCallback(opts.OnClick) end
		return _FloatBtn
	end

	opts = opts or {}
	local Logo     = opts.Logo     or ""
	local Title    = opts.Title    or "Protocol X Hub"
	local OnClick  = opts.OnClick  or function() end

	DestroyOld("PXH_FloatBtn")

	local FBGui = New("ScreenGui", {
		Name = "PXH_FloatBtn", ResetOnSpawn = false, IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 900,
	})
	FBGui.Parent = GuiParent()

	local BtnSize = IsMobile and 58 or 72
	local vp = Viewport()

	local GlowFrame = New("Frame", {
		Size = UDim2.fromOffset(BtnSize + 20, BtnSize + 20),
		Position = UDim2.fromOffset(math.floor(vp.X * 0.02), math.floor(vp.Y * 0.45)),
		BackgroundTransparency = 1, Parent = FBGui,
	})

	local GlowImg = New("ImageLabel", {
		Size = UDim2.new(1, 20, 1, 20), Position = UDim2.new(0, -10, 0, -10),
		BackgroundTransparency = 1, Image = "rbxassetid://6015897843",
		ImageColor3 = Theme.Accent, ImageTransparency = 0.6,
		ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(49, 49, 450, 450),
		ZIndex = 0, Parent = GlowFrame,
	})

	local MainBtn = New("ImageButton", {
		Size = UDim2.fromOffset(BtnSize, BtnSize),
		Position = UDim2.new(0.5, -(BtnSize / 2), 0.5, -(BtnSize / 2)),
		BackgroundColor3 = Theme.Main, Image = "", AutoButtonColor = false,
		ZIndex = 2, Parent = GlowFrame,
	})
	Corner(MainBtn, IsMobile and 14 or 16)
	local BtnStroke = Stroke(MainBtn, Theme.Accent, 2)

	local LogoImg = New("ImageLabel", {
		Size = UDim2.fromOffset(BtnSize - 22, BtnSize - 26),
		Position = UDim2.fromOffset(11, 8),
		BackgroundTransparency = 1, Image = Logo,
		ScaleType = Enum.ScaleType.Fit, ZIndex = 4, Parent = MainBtn,
	})

	local TitleLbl = New("TextLabel", {
		Size = UDim2.new(1, -6, 0, 12), Position = UDim2.new(0, 3, 1, -14),
		BackgroundTransparency = 1, Text = Title,
		TextColor3 = Color3.new(1, 1, 1), TextTransparency = 0.15,
		Font = Enum.Font.GothamBold, TextSize = IsMobile and 7 or 8,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 5, Parent = MainBtn,
	})

	local LockDot = New("Frame", {
		Size = UDim2.fromOffset(14, 14), Position = UDim2.new(1, -4, 0, -4),
		BackgroundColor3 = Color3.fromRGB(255, 200, 0),
		BorderSizePixel = 0, ZIndex = 6, Visible = false, Parent = MainBtn,
	})
	Corner(LockDot, 7)

	local isLocked, isDragging, moved = false, false, false
	local holdStart, holdConn = 0, nil
	local dragOffset = Vector2.new()
	local callback = OnClick

	local function SetLock(locked, silent)
		isLocked = locked
		LockDot.Visible = locked
		BtnStroke.Color = locked and Color3.fromRGB(255, 200, 0) or Theme.Accent
		GlowImg.ImageColor3 = locked and Color3.fromRGB(255, 200, 0) or Theme.Accent
		if not silent then
			Notify({
				Title = locked and "Button Locked" or "Button Unlocked",
				Content = locked and "Hold 5s again to unlock." or "You can drag it again.",
				Type = "Warning", Duration = 2,
			})
		end
	end

	local function ClampIntoScreen()
		local sc = FBGui.AbsoluteSize
		if sc.X < 1 then return end
		local gsz = GlowFrame.AbsoluteSize
		local p = GlowFrame.AbsolutePosition
		GlowFrame.Position = UDim2.fromOffset(
			math.clamp(p.X, 0, math.max(0, sc.X - gsz.X)),
			math.clamp(p.Y, 0, math.max(0, sc.Y - gsz.Y))
		)
	end

	MainBtn.InputBegan:Connect(function(inp)
		if inp.UserInputType ~= Enum.UserInputType.MouseButton1
			and inp.UserInputType ~= Enum.UserInputType.Touch then return end

		moved = false
		holdStart = tick()
		if holdConn then holdConn:Disconnect() end
		holdConn = RunService.RenderStepped:Connect(function()
			if (tick() - holdStart) >= 5 then
				if holdConn then holdConn:Disconnect(); holdConn = nil end
				isDragging = false          -- FIX #17: stop dragging when it locks
				SetLock(not isLocked)
			end
		end)

		if not isLocked then
			isDragging = true
			local gp = GlowFrame.AbsolutePosition
			dragOffset = Vector2.new(inp.Position.X - gp.X, inp.Position.Y - gp.Y)
		end
	end)

	--// FIX #17: release is tracked globally, not only over the button.
	Bind(UserInputService.InputEnded, function(inp)
		if inp.UserInputType ~= Enum.UserInputType.MouseButton1
			and inp.UserInputType ~= Enum.UserInputType.Touch then return end
		if holdConn then holdConn:Disconnect(); holdConn = nil end
		local wasDragging = isDragging
		isDragging = false
		if not wasDragging and holdStart == 0 then return end
		local elapsed = tick() - holdStart
		holdStart = 0
		if elapsed < 0.35 and not moved then
			local ok, err = pcall(callback)
			if not ok then warn("[PXHub] floating button callback error: " .. tostring(err)) end
		else
			ClampIntoScreen()
		end
	end)

	Bind(UserInputService.InputChanged, function(inp)
		if not isDragging or isLocked then return end
		if inp.UserInputType ~= Enum.UserInputType.MouseMovement
			and inp.UserInputType ~= Enum.UserInputType.Touch then return end
		local sc  = FBGui.AbsoluteSize
		local gsz = GlowFrame.AbsoluteSize
		local nx  = math.clamp(inp.Position.X - dragOffset.X, 0, math.max(0, sc.X - gsz.X))
		local ny  = math.clamp(inp.Position.Y - dragOffset.Y, 0, math.max(0, sc.Y - gsz.Y))
		if math.abs(nx - GlowFrame.AbsolutePosition.X) > 2
			or math.abs(ny - GlowFrame.AbsolutePosition.Y) > 2 then
			moved = true
		end
		GlowFrame.Position = UDim2.fromOffset(nx, ny)
	end)

	Bind(RunService.RenderStepped, function()
		if not isDragging and not isLocked and GlowImg.Parent then
			GlowImg.ImageTransparency = 0.6 + math.sin(tick() * 2) * 0.15
		end
	end)

	OnTheme(function()
		GlowImg.ImageColor3      = isLocked and Color3.fromRGB(255, 200, 0) or Theme.Accent
		BtnStroke.Color          = isLocked and Color3.fromRGB(255, 200, 0) or Theme.Accent
		MainBtn.BackgroundColor3 = Theme.Main
	end, MainBtn)

	local cam = GetCamera()
	if cam then Bind(cam:GetPropertyChangedSignal("ViewportSize"), ClampIntoScreen) end

	local FBObj = { Frame = GlowFrame, Gui = FBGui, Button = MainBtn }
	function FBObj:SetLogo(img)      LogoImg.Image = img end
	function FBObj:SetTitle(t)       TitleLbl.Text = t end
	function FBObj:SetVisible(v)     FBGui.Enabled = v end
	function FBObj:SetCallback(fn)   callback = type(fn) == "function" and fn or callback end
	function FBObj:SetLocked(v)      SetLock(v and true or false, true) end
	function FBObj:IsLocked()        return isLocked end
	function FBObj:Destroy()
		if holdConn then holdConn:Disconnect(); holdConn = nil end
		FBGui:Destroy()
		_FloatBtn = nil -- FIX #11: allow creating a new one afterwards
	end

	_FloatBtn = FBObj
	return FBObj
end

Library.CreateFloatingButton = function(a, b)
	if a == Library then return CreateFloatingButton(b) end
	return CreateFloatingButton(a)
end

