	--// ── Window dragging (FIX #1) ─────────────────────────────────
	-- v3.1 used UIDragDetector, which does not exist on many clients (the
	-- script died right there) and made the whole window a drag surface, so
	-- sliders/toggles fought the drag. Header-only manual drag instead.
	do
		local dragging, dragStartPos, windowStart = false, nil, nil

		local function beginDrag(input)
			dragging = true
			dragStartPos = Vector2.new(input.Position.X, input.Position.Y)
			windowStart = Vector2.new(Main.AbsolutePosition.X, Main.AbsolutePosition.Y)
		end

		local function dragZone(inst)
			if not inst then return end
			inst.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					beginDrag(input)
				end
			end)
		end
		dragZone(Header)
		dragZone(HLeft)
		dragZone(SideLogoBox)

		Bind(UserInputService.InputChanged, function(input)
			if not dragging then return end
			if input.UserInputType ~= Enum.UserInputType.MouseMovement
				and input.UserInputType ~= Enum.UserInputType.Touch then return end
			local vp = Viewport()
			local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStartPos
			local size = Main.AbsoluteSize
			local nx = math.clamp(windowStart.X + delta.X, 0, math.max(0, vp.X - size.X))
			local ny = math.clamp(windowStart.Y + delta.Y, 0, math.max(0, vp.Y - size.Y))
			Main.Position = UDim2.fromOffset(nx, ny)
		end)

		Bind(UserInputService.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
	end

