				Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Theme.Accent,
				BorderSizePixel = 0, ZIndex = 6, Parent = Track,
			})
			Corner(Fill, 3)

			local CircSz = IsMobile and 13 or 15
			local H1 = New("Frame", {
				Size = UDim2.fromOffset(CircSz, CircSz), AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0, ZIndex = 7, Parent = Track,
			})
			Corner(H1, CircSz / 2)
			--// FIX #3: keep ONE stroke per handle and recolour it on theme change
			local H1Stroke = Stroke(H1, Theme.Accent, 2)

			local H2, H2Stroke
			if Dual then
				H2 = New("Frame", {
					Size = UDim2.fromOffset(CircSz, CircSz), AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1),
					BorderSizePixel = 0, ZIndex = 7, Parent = Track,
				})
				Corner(H2, CircSz / 2)
				H2Stroke = Stroke(H2, Theme.Accent, 2)
			end

			OnTheme(function()
				TLbl.TextColor3 = Theme.TextPrimary
				ValLbl.TextColor3 = Theme.Accent
				Track.BackgroundColor3 = Theme.Border
				Fill.BackgroundColor3 = Theme.Accent
				H1Stroke.Color = Theme.Accent
				if H2Stroke then H2Stroke.Color = Theme.Accent end
			end, Row)

			local function Fmt(v) return Prefix .. string.format("%." .. Decimal .. "f", v) .. Suffix end
			local function SnapV(v)
				v = tonumber(v) or Min
				if not Step or Step <= 0 then return v end
				return math.clamp(math.floor((v - Min) / Step + 0.5) * Step + Min, Min, Max)
			end
			local function UpdVis(v)
				if Dual then
					local a1 = math.clamp((v[1] - Min) / (Max - Min), 0, 1)
					local a2 = math.clamp((v[2] - Min) / (Max - Min), 0, 1)
					Tw(Fill, { Position = UDim2.new(a1, 0, 0, 0), Size = UDim2.new(a2 - a1, 0, 1, 0) }, T0)
					Tw(H1, { Position = UDim2.new(a1, 0, 0.5, 0) }, T0)
					if H2 then Tw(H2, { Position = UDim2.new(a2, 0, 0.5, 0) }, T0) end
					ValLbl.Text = Fmt(v[1]) .. " – " .. Fmt(v[2])
				else
					local a = math.clamp((v - Min) / (Max - Min), 0, 1)
					Tw(Fill, { Size = UDim2.new(a, 0, 1, 0) }, T0)
					Tw(H1, { Position = UDim2.new(a, 0, 0.5, 0) }, T0)
					ValLbl.Text = Fmt(v)
				end
			end
			local function SetVal(v, fire)
				if Dual then
					local a = type(v) == "table" and v or { Min, Max }
					CurVal = { math.clamp(SnapV(a[1] or Min), Min, Max), math.clamp(SnapV(a[2] or Max), Min, Max) }
					if CurVal[1] > CurVal[2] then CurVal[1] = CurVal[2] end
				else
					CurVal = math.clamp(SnapV(v), Min, Max)
				end
				UpdVis(CurVal)
				if fire then
					local ok, err = pcall(Callback, CurVal)
					if not ok then warn(("[PXHub] slider %q callback error: %s"):format(compTitle, tostring(err))) end
				end
			end

			local dragging, activeHandle = false, 1
			local function DoDrag(inp)
				local sz = Track.AbsoluteSize.X
				if sz <= 0 then return end
				local rel = math.clamp((inp.Position.X - Track.AbsolutePosition.X) / sz, 0, 1)
				local sv = SnapV(Min + rel * (Max - Min))
				if Dual then
					local nv = { CurVal[1], CurVal[2] }
					nv[activeHandle] = sv
					if activeHandle == 1 and nv[1] > nv[2] then nv[1] = nv[2]
					elseif activeHandle == 2 and nv[2] < nv[1] then nv[2] = nv[1] end
					CurVal = nv
				else
					CurVal = sv
				end
				UpdVis(CurVal)
				pcall(Callback, CurVal)
			end

			TrackBtn.InputBegan:Connect(function(i)
				if i.UserInputType ~= Enum.UserInputType.MouseButton1
					and i.UserInputType ~= Enum.UserInputType.Touch then return end
				dragging = true
				if Dual then
					local sz = Track.AbsoluteSize.X
					local rel = sz > 0 and math.clamp((i.Position.X - Track.AbsolutePosition.X) / sz, 0, 1) or 0
					local a1 = (CurVal[1] - Min) / (Max - Min)
					local a2 = (CurVal[2] - Min) / (Max - Min)
					activeHandle = math.abs(rel - a1) <= math.abs(rel - a2) and 1 or 2
				end
				DoDrag(i)
				Tw((Dual and activeHandle == 2) and H2 or H1, { Size = UDim2.fromOffset(CircSz + 3, CircSz + 3) }, TF)
			end)

			Bind(UserInputService.InputEnded, function(i)
				if not dragging then return end
				if i.UserInputType == Enum.UserInputType.MouseButton1
					or i.UserInputType == Enum.UserInputType.Touch then
					dragging = false
					Tw((Dual and activeHandle == 2) and H2 or H1, { Size = UDim2.fromOffset(CircSz, CircSz) }, TF)
				end
			end)

			Bind(UserInputService.InputChanged, function(i)
				if not dragging then return end
				if i.UserInputType == Enum.UserInputType.MouseMovement
					or i.UserInputType == Enum.UserInputType.Touch then
					DoDrag(i)
				end
			end)

			SetVal(CurVal, false)
			if sOpts.FireOnLoad then task.defer(function() SetVal(CurVal, true) end) end

			local obj = {}
			function obj:GetComponentType() return "Slider" end
			function obj:GetValue() return CurVal end
			function obj:SetValue(v, silent) SetVal(v, not silent) end
			function obj:SetMin(v) Min = tonumber(v) or Min; SetVal(CurVal, false) end
			function obj:SetMax(v) Max = tonumber(v) or Max; SetVal(CurVal, false) end
			function obj:Reset() SetVal(Dual and { DefaultVal[1], DefaultVal[2] } or DefaultVal, true) end
			return RegisterFlag(FlagName, obj, DefaultVal)
		end

		--// DROPDOWN --------------------------------------------------
		function TabObj:Dropdown(dOpts)
			dOpts = dOpts or {}
			local compTitle = dOpts.Title    or "Dropdown"
			local Options   = dOpts.Options  or {}
			local Multi     = dOpts.Multi    or false
			local UseSearch = dOpts.Search   or false      -- FIX #6: actually implemented
			local Default   = dOpts.Default
			local Callback  = dOpts.Callback or function() end
			local FlagName  = dOpts.Flag     or (TabTitle .. "/" .. compTitle)

			local function DefaultSelection()
				local sel = {}
				if Multi then
					if type(Default) == "table" then
