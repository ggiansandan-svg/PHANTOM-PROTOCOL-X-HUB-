				TextSize = IsMobile and 10 or 12, TextXAlignment = Enum.TextXAlignment.Right,
				TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 5, Parent = Row,
			})

			local TrackBtn = New("TextButton", {
				Size = UDim2.fromOffset(TrackW, 20),
				Position = UDim2.new(1, -(TrackW + 8), 0.5, -10),
				BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 5, Parent = Row,
