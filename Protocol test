local _NotifGui, _NotifList

local function EnsureNotif()
	if _NotifGui and _NotifGui.Parent then return end
	DestroyOld("PXH_Notifs") -- FIX #11: never stack two notification layers
	_NotifGui = New("ScreenGui", {
		Name = "PXH_Notifs", ResetOnSpawn = false, IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 1000, -- above the window (the window uses 100)
	})
	_NotifGui.Parent = GuiParent()

	local width = math.min(300, math.max(180, Viewport().X * 0.42))
	_NotifList = New("Frame", {
		Name = "Stack",
		Size = UDim2.new(0, width, 1, -20),
		Position = UDim2.new(1, -(width + 10), 0, 10),
		BackgroundTransparency = 1, Parent = _NotifGui,
	})
	List(_NotifList, 8, Enum.FillDirection.Vertical,
		Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)

	local cam = GetCamera()
	if cam then
		Bind(cam:GetPropertyChangedSignal("ViewportSize"), function()
			if not _NotifList or not _NotifList.Parent then return end
			local w = math.min(300, math.max(180, Viewport().X * 0.42))
			_NotifList.Size = UDim2.new(0, w, 1, -20)
			_NotifList.Position = UDim2.new(1, -(w + 10), 0, 10)
		end)
	end
end

local function Notify(opts)
	if type(opts) == "string" then opts = { Content = opts } end
	opts = opts or {}
	EnsureNotif()

	local title   = opts.Title    or "Notice"
	local content = opts.Content  or ""
	local dur     = tonumber(opts.Duration) or 3
	local ntype   = opts.Type     or "Info"
	local cols = {
		Info    = Color3.fromRGB(47, 129, 247),
		Success = Color3.fromRGB(46, 200, 110),
		Warning = Color3.fromRGB(240, 190, 0),
		Error   = Color3.fromRGB(230, 70, 60),
	}
	local col = cols[ntype] or cols.Info

	local cardW = _NotifList.AbsoluteSize.X
	if cardW < 50 then cardW = math.min(300, math.max(180, Viewport().X * 0.42)) end

	-- height follows the content instead of clipping it
	local _, textH = TextWidth(content, 11, Theme.Font, cardW - 40)
	local cardH = math.clamp(38 + math.max(textH, 14), 58, 160)

	local card = New(CanvasClass, {
		Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Theme.Main,
		GroupTransparency = 0, ClipsDescendants = true, Parent = _NotifList,
	})
	Corner(card, 8)
	Stroke(card, Theme.Border, 1)

	local topLine = New("Frame", { Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = col,
		BorderSizePixel = 0, ZIndex = 2, Parent = card })
	New("UIGradient", { Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.1, 0),
		NumberSequenceKeypoint.new(0.9, 0), NumberSequenceKeypoint.new(1, 1) }), Parent = topLine })

	local sideBar = New("Frame", { Size = UDim2.new(0, 3, 1, -16), Position = UDim2.new(0, 8, 0, 8),
		BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = 2, Parent = card })
	Corner(sideBar, 2)

	New("TextLabel", { Size = UDim2.new(1, -46, 0, 18), Position = UDim2.new(0, 20, 0, 9),
		BackgroundTransparency = 1, Text = title, TextColor3 = Theme.TextPrimary,
		Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 2, Parent = card })

	New("TextLabel", { Size = UDim2.new(1, -30, 0, cardH - 36), Position = UDim2.new(0, 20, 0, 29),
		BackgroundTransparency = 1, Text = content, TextColor3 = Theme.TextSecondary,
		Font = Theme.Font, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, ZIndex = 2, Parent = card })

	local closeB = New("TextButton", { Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(1, -26, 0, 8),
		BackgroundTransparency = 1, Text = "✕", TextColor3 = Theme.TextSecondary,
		Font = Enum.Font.GothamBold, TextSize = 12, ZIndex = 3, Parent = card })

	local prog = New("Frame", { Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2),
		BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = 2, Parent = card })

	Tw(card, { Size = UDim2.new(1, 0, 0, cardH) }, TB)
	Tw(prog, { Size = UDim2.new(0, 0, 0, 2) }, TweenInfo.new(dur, Enum.EasingStyle.Linear))

	local closed = false
	local function Close()
		if closed then return end
		closed = true
		-- FIX: a UIListLayout owns Position, so fade + collapse instead.
		TwFade(card, 1, TS)
		Tw(card, { Size = UDim2.new(1, 0, 0, 0) }, TS)
		task.delay(0.3, function()
			if card and card.Parent then card:Destroy() end
		end)
	end
	closeB.MouseButton1Click:Connect(Close)
	task.delay(dur, Close)

	return { Close = Close, Card = card }
end

--// tolerate both Library.Notify(opts) and Library:Notify(opts)
Library.Notify = function(a, b)
	if a == Library then return Notify(b) end
	return Notify(a)
end

