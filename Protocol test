				KBtn.Text = "..."
				Tw(KBtn, { TextColor3 = Theme.Accent }, TF)
				Tw(KStroke, { Color = Theme.Accent }, TF)
				if ListenConn then ListenConn:Disconnect() end
				ListenConn = UserInputService.InputBegan:Connect(function(i)
					if i.UserInputType == Enum.UserInputType.Keyboard then
						if i.KeyCode == Enum.KeyCode.Escape then
							CurKey = nil
						else
							CurKey = i.KeyCode
							pcall(Callback, CurKey)
						end
					elseif tostring(i.UserInputType):find("MouseButton") then
						CurKey = i.UserInputType
						pcall(Callback, CurKey)
					else
						return -- ignore touch/movement while binding
					end
					StopListening()
				end)
			end)

			Bind(UserInputService.InputBegan, function(i, processed)
				if processed or Listening or not CurKey then return end
				if i.KeyCode == CurKey or i.UserInputType == CurKey then
					pcall(Callback, CurKey)
				end
			end)

			OnTheme(function()
				TLbl.TextColor3 = Theme.TextPrimary
				KBtn.BackgroundColor3 = Theme.Search
				KBtn.TextColor3 = Listening and Theme.Accent or Theme.TextSecondary
				KStroke.Color = Listening and Theme.Accent or Theme.Border
			end, Row)

			local obj = {}
			function obj:GetComponentType() return "Keybind" end
			function obj:GetValue() return CurKey end
			function obj:SetValue(v, silent)
				if type(v) == "string" and v ~= "None" then
					local ok, key = pcall(function() return Enum.KeyCode[v] end)
					if not ok or not key then
						ok, key = pcall(function() return Enum.UserInputType[v] end)
					end
					v = ok and key or nil
				elseif v == "None" then
					v = nil
				elseif v ~= nil and typeof(v) ~= "EnumItem" then
					-- a corrupted config must not brick the keybind
					warn("[PXHub] ignoring invalid keybind value: " .. tostring(v))
					return
				end
				CurKey = v
				KBtn.Text = FormatKey(v)
				if not silent and v then pcall(Callback, v) end
			end
			function obj:Clear() CurKey = nil; KBtn.Text = "None" end
			function obj:Reset() obj:SetValue(Default, true) end
			return RegisterFlag(FlagName, obj, Default)
		end

		--// CODE ------------------------------------------------------
		function TabObj:Code(cOpts)
			cOpts = cOpts or {}
			local code = cOpts.Code or ""
			local lang = cOpts.Language or "Lua"
			TabObj.LayoutOrder += 1
			local cf = New("Frame", {
				Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = Theme.Body, LayoutOrder = TabObj.LayoutOrder, ZIndex = 4, Parent = Scroll,
			})
			Corner(cf, 8)
			local cStroke = Stroke(cf, Theme.Border, 1)
			local ch = New("Frame", { Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = Theme.Search,
				BorderSizePixel = 0, ZIndex = 4, Parent = cf })
			Corner(ch, 8)
			local chFlat = New("Frame", { Size = UDim2.new(1, 0, 0.5, 0), Position = UDim2.new(0, 0, 0.5, 0),
				BackgroundColor3 = Theme.Search, BorderSizePixel = 0, ZIndex = 4, Parent = ch })
			local clang = New("TextLabel", { Size = UDim2.new(1, -60, 1, 0), Position = UDim2.fromOffset(8, 0),
				BackgroundTransparency = 1, Text = lang, TextColor3 = Theme.TextSecondary,
				Font = Enum.Font.Code, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5, Parent = ch })
			local cpb = New("TextButton", { Size = UDim2.fromOffset(38, 16), Position = UDim2.new(1, -44, 0.5, -8),
				BackgroundColor3 = Theme.Border, Text = "Copy", TextColor3 = Theme.TextSecondary,
				Font = Theme.Font, TextSize = 10, AutoButtonColor = false, ZIndex = 5, Parent = ch })
			Corner(cpb, 4)
			local ct = New("TextLabel", {
				Size = UDim2.new(1, -16, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
				Position = UDim2.fromOffset(8, 30),
				BackgroundTransparency = 1, Text = code, RichText = true,
				TextColor3 = Theme.TextPrimary, Font = Enum.Font.Code, TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true, ZIndex = 5, Parent = cf,
			})
			Pad(cf, 0, 34, 0, 0)

			cpb.MouseButton1Click:Connect(function()
				local ok = pcall(function() setclipboard(code) end)
				cpb.Text = ok and "✓" or "n/a"
				task.delay(1.5, function() cpb.Text = "Copy" end)
			end)

			OnTheme(function()
				cf.BackgroundColor3 = Theme.Body
				cStroke.Color = Theme.Border
				ch.BackgroundColor3 = Theme.Search
				chFlat.BackgroundColor3 = Theme.Search
				clang.TextColor3 = Theme.TextSecondary
				ct.TextColor3 = Theme.TextPrimary
				cpb.BackgroundColor3 = Theme.Border
				cpb.TextColor3 = Theme.TextSecondary
			end, cf)

			return { Frame = cf, SetCode = function(c) code = c; ct.Text = c end }
		end

		return TabObj
	end

	--// ── CONFIG TAB ───────────────────────────────────────────────
	local ConfigTab = Win:Tab({ Title = "Config", Icon = "rbxassetid://11419703493", IsConfig = true })
	Win.ConfigTab = ConfigTab

	ConfigTab:Paragraph({
		Title = "Configuration",
		Content = "Save, load and reset every toggle / slider / dropdown / textbox / keybind in this hub.",
	})
	ConfigTab:Section({ Title = "SAVE & LOAD" })

	local function CollectConfig()
		local data = { __theme = Library.CurrentTheme, __togglekey = FormatKey(Library.ToggleKey), values = {} }
		for flag, comp in pairs(Library.Flags) do
			if type(comp.GetValue) == "function" then
				local ok, val = pcall(comp.GetValue, comp)
				if ok then
					local t = type(val)
					-- EnumItem must be tested first: type() reports it as userdata/table
					if typeof(val) == "EnumItem" then
						data.values[flag] = val.Name
					elseif t == "boolean" or t == "number" or t == "string" then
						data.values[flag] = val
					elseif t == "table" then
						-- multi dropdown / dual slider
						local clean = {}
						for i, v in ipairs(val) do
							if type(v) == "number" or type(v) == "string" then clean[i] = v end
						end
						data.values[flag] = clean
					end
				end
			end
		end
		return data
	end

	local function FileExists(path)
		if isfile then
			local ok, res = pcall(isfile, path)
			if ok then return res end
		end
		local ok = pcall(readfile, path)
		return ok
	end

	ConfigTab:Button({
		Title = "Save Config", Action = "Save",
		Description = "Writes " .. Library.ConfigFile,
		Callback = function()
			local data = CollectConfig()
			local ok, err = pcall(function()
				writefile(Library.ConfigFile, HttpService:JSONEncode(data))
			end)
			if ok then
				Notify({ Title = "Config Saved", Content = Library.ConfigFile, Type = "Success", Duration = 3 })
			else
				-- FIX #15: tell the user instead of silently doing nothing
				Notify({ Title = "Save Failed",
					Content = "This executor has no file access (" .. tostring(err) .. ")",
					Type = "Error", Duration = 5 })
			end
		end,
	})

	local function LoadConfig(silent)
		if not FileExists(Library.ConfigFile) then
			if not silent then
				Notify({ Title = "No Config Found", Content = "Save a config first.", Type = "Warning", Duration = 3 })
			end
			return false
		end
		local ok, data = pcall(function()
			return HttpService:JSONDecode(readfile(Library.ConfigFile))
		end)
		if not ok or type(data) ~= "table" then
			if not silent then
				Notify({ Title = "Config Error", Content = "The config file is corrupted.", Type = "Error", Duration = 4 })
			end
			return false
		end
		local values = data.values or data -- accept v3.1 files too
		for flag, v in pairs(values) do
			local comp = Library.Flags[flag]
			if comp and type(comp.SetValue) == "function" then
				pcall(comp.SetValue, comp, v)
			end
		end
		if data.__theme then ApplyTheme(data.__theme) end
		if not silent then
			Notify({ Title = "Config Loaded", Content = "Settings restored.", Type = "Success", Duration = 3 })
		end
		return true
	end
	Win.LoadConfig = function(_, silent) return LoadConfig(silent) end
	Win.SaveConfig = function()
		return pcall(function() writefile(Library.ConfigFile, HttpService:JSONEncode(CollectConfig())) end)
	end

	ConfigTab:Button({
		Title = "Load Config", Action = "Load",
		Callback = function() LoadConfig(false) end,
	})

	--// FIX #14: a reset that really resets
	ConfigTab:Button({
		Title = "Reset All", Action = "Reset",
		Description = "Restores every component to its default value",
		Callback = function()
			local n = 0
			for _, comp in pairs(Library.Flags) do
				if type(comp.Reset) == "function" then
					local ok = pcall(comp.Reset, comp)
					if ok then n += 1 end
				end
			end
			Notify({ Title = "Reset", Content = n .. " components restored to defaults.", Type = "Info", Duration = 3 })
		end,
	})

	ConfigTab:Section({ Title = "THEME" })
	ThemeDropdownRef = ConfigTab:Dropdown({
		Title = "Theme", Options = Library:GetThemes(), Search = true,
		Default = Library.CurrentTheme,
		Callback = function(v)
			if type(v) == "string" then ApplyTheme(v, true) end
		end,
	})

	ConfigTab:Section({ Title = "INFO" })
	local AboutPara = ConfigTab:Paragraph({
		Title = "About",
		Content = "Protocol X Hub v" .. tostring(Library.Version)
			.. "\nToggle key: " .. FormatKey(Library.ToggleKey)
			.. (IsMobile and "\nMobile layout active — use the floating button or ✕ to hide."
				or "\nDrag the window by its header."),
	})

	ConfigTab:Keybind({
		Title = "Toggle GUI Key", Default = Library.ToggleKey,
		Callback = function(key)
			Library.ToggleKey = key
			AboutPara.SetContent("Protocol X Hub v" .. tostring(Library.Version)
				.. "\nToggle key: " .. FormatKey(key))
		end,
	})

	SaveBtn.MouseButton1Click:Connect(function() ConfigTab:Activate() end)

	--// ── Optional floating button ─────────────────────────────────
	if opts.FloatingButton ~= false and (IsMobile or opts.FloatingButton) then
		Win.FloatingButton = CreateFloatingButton({
			Logo = Logo, Title = Title,
			OnClick = function() Win:ToggleVisibility() end,
		})
	end

	--// ── Cleanup ──────────────────────────────────────────────────
	function Win:Destroy()
		ClosePopups()
		for _, wm in ipairs(self.Watermarks) do pcall(function() wm:Destroy() end) end
		if self.FloatingButton then pcall(function() self.FloatingButton:Destroy() end) end
		ScreenGui:Destroy()
		for i, w in ipairs(Library.Windows) do
			if w == self then table.remove(Library.Windows, i); break end
		end
	end
	Win.Unload = Win.Destroy

	--// ── First paint ──────────────────────────────────────────────
	task.defer(function()
		if opts.StartTab ~= false then
			for _, t in ipairs(Win.Tabs) do
				if not t.IsConfig then
					t:Activate()
					break
				end
			end
		end
		if opts.LoadConfigOnStart then LoadConfig(true) end
		task.delay(0.8, function()
			Notify({
				Title = Title,
				Content = IsMobile
					and "Loaded! Tap the floating button to show/hide."
					or ("Loaded! Press " .. FormatKey(Library.ToggleKey) .. " to toggle."),
				Type = "Success", Duration = 3,
			})
		end)
	end)

	return Win
end

--// ================================================================
--//  GLOBAL CLEANUP
--// ================================================================
function Library:Unload()
	for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
	table.clear(Connections)
	for i = #self.Windows, 1, -1 do
		pcall(function() self.Windows[i]:Destroy() end)
	end
	if _FloatBtn then pcall(function() _FloatBtn:Destroy() end) end
	if _NotifGui then pcall(function() _NotifGui:Destroy() end) end
	table.clear(self.Flags)
	table.clear(ThemeCBs)
end

return Library
