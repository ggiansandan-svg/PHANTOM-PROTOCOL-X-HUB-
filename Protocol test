--// ================================================================
--//  HELPERS
--// ================================================================
local function New(cls, props)
	local ok, o = pcall(Instance.new, cls)
	if not ok or not o then
		warn(("[PXHub] this client cannot create a %q instance"):format(tostring(cls)))
		return nil
	end
	props = props or {}
	for k, v in pairs(props) do
		if k ~= "Parent" then
			local set = pcall(function() o[k] = v end)
			if not set then
				warn(("[PXHub] could not set %s.%s"):format(cls, tostring(k)))
			end
		end
	end
	if props.Parent then o.Parent = props.Parent end
	return o
end

--// Very old clients have no CanvasGroup: fall back to a plain Frame and skip
--// the group fades instead of erroring on GroupTransparency.
local CanvasOK = pcall(function()
	local probe = Instance.new("CanvasGroup")
	probe:Destroy()
end)
local CanvasClass = CanvasOK and "CanvasGroup" or "Frame"

local function SetFade(obj, v)
	if not obj then return end
	if CanvasOK then obj.GroupTransparency = v else obj.Visible = v < 1 end
end

function TwFade(obj, v, info)
	if not obj then return nil end
	if CanvasOK then return Tw(obj, { GroupTransparency = v }, info) end
	obj.Visible = v < 1
	return nil
end

local function Corner(p, r)    return New("UICorner",  { CornerRadius = UDim.new(0, r or 8), Parent = p }) end
local function Stroke(p, c, t) return New("UIStroke",  { Color = c or Color3.new(), Thickness = t or 1, Parent = p }) end
local function Pad(p, t, b, l, r)
	return New("UIPadding", {
		PaddingTop = UDim.new(0, t or 0), PaddingBottom = UDim.new(0, b or 0),
		PaddingLeft = UDim.new(0, l or 0), PaddingRight = UDim.new(0, r or 0), Parent = p,
	})
end
local function List(p, pad, fd, ha, va)
	return New("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, pad or 0),
		FillDirection = fd or Enum.FillDirection.Vertical,
		HorizontalAlignment = ha or Enum.HorizontalAlignment.Left,
		VerticalAlignment = va or Enum.VerticalAlignment.Top, Parent = p,
	})
end

--// FIX #2: typeof(), not type() — Roblox enums are userdata to type().
local function FormatKey(k)
	if not k then return "None" end
	local n
	if typeof(k) == "EnumItem" then
		n = k.Name
	else
		n = tostring(k):gsub("^Enum%.%w+%.", "")
	end
	local m = {
		MouseButton1 = "MB1", MouseButton2 = "MB2", MouseButton3 = "MB3",
		LeftShift = "LShift", RightShift = "RShift",
		LeftControl = "LCtrl", RightControl = "RCtrl",
		LeftAlt = "LAlt", RightAlt = "RAlt",
	}
	return m[n] or n
end

--// FIX #13: readable text on top of any accent colour.
local function Luminance(c)
	return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
end
local function ContrastOn(color)
	return Luminance(color) > 0.6 and Color3.fromRGB(12, 12, 14) or Color3.fromRGB(255, 255, 255)
end

local function TextWidth(text, size, font, maxW)
	local ok, res = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(maxW or 10000, 10000))
	end)
	if ok and res then return res.X, res.Y end
	return #tostring(text) * size * 0.55, size + 4
end

--// Every connection the library makes is tracked so :Unload() is clean.
local Connections = {}
local function Bind(signal, fn)
	local c = signal:Connect(fn)
	table.insert(Connections, c)
	return c
end

--// ================================================================
--//  LIBRARY STATE
--// ================================================================
local Library = {
	ToggleKey    = Enum.KeyCode.RightControl,
	Flags        = {},
	CurrentTheme = "GitHub Dark",
	Version      = "3.2.0",
	IsMobile     = IsMobile,
	Windows      = {},
	ConfigFile   = "ProtocolXHub_Config.json",
}

local Theme    = Themes["GitHub Dark"]
local ThemeCBs = {}

--// FIX #12: theme listeners can be released, dead ones are pruned and a
--// throwing listener no longer aborts the remaining ones.
local function OnTheme(fn, guard)
	local entry = { fn = fn, guard = guard }
	table.insert(ThemeCBs, entry)
	return entry
end

local function FireTheme()
	for i = #ThemeCBs, 1, -1 do
		local e = ThemeCBs[i]
		local dead = false
		if e.guard then
			local ok, parent = pcall(function() return e.guard.Parent end)
			dead = (not ok) or parent == nil
		end
		if dead then
			table.remove(ThemeCBs, i)
		else
			local ok, err = pcall(e.fn)
			if not ok then
				warn("[PXHub] theme listener failed: " .. tostring(err))
				table.remove(ThemeCBs, i)
			end
		end
	end
end

function Library:SetTheme(name)
	if not Themes[name] then
		warn("[PXHub] unknown theme: " .. tostring(name))
		return false
	end
	Theme = Themes[name]
	self.CurrentTheme = name
	FireTheme()
	return true
end

function Library:GetTheme() return Theme end

function Library:GetThemes()
	local t = {}
	for k in pairs(Themes) do table.insert(t, k) end
	table.sort(t)
	return t
end

function Library:AddTheme(name, def)
	if type(name) ~= "string" or type(def) ~= "table" then return false end
	local base = Themes["GitHub Dark"]
	local merged = {}
	for k, v in pairs(base) do merged[k] = v end
	for k, v in pairs(def) do merged[k] = v end
	Themes[name] = merged
	return true
end

function Library:SetWindowKeybind(k) self.ToggleKey = k end

--// Convenience: Library:GetFlag("Main/Aimbot") -> current value
function Library:GetFlag(name)
	local f = self.Flags[name]
	if f and type(f.GetValue) == "function" then
		local ok, v = pcall(f.GetValue, f)
		if ok then return v end
	end
	return nil
end

function Library:SetFlag(name, value)
	local f = self.Flags[name]
	if f and type(f.SetValue) == "function" then
		return pcall(f.SetValue, f, value)
	end
	return false
end

