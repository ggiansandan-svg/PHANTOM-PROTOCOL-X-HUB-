				TLbl.TextColor3 = Theme.TextPrimary
				if DLbl then DLbl.TextColor3 = Theme.TextSecondary end
				Btn.BackgroundColor3 = Theme.Accent
				Btn.TextColor3 = ContrastOn(Theme.Accent)
			end, Row)

			local obj = {}
			function obj:GetComponentType() return "Button" end
			function obj:Fire() Callback() end
			function obj:SetTitle(t) TLbl.Text = tostring(t) end
			function obj:SetAction(a) Btn.Text = tostring(a) end
			return RegisterFlag(FlagName, obj, nil)
