		local wTxt = New("TextLabel", {
			Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
			Text = initText or "", RichText = true, TextColor3 = Theme.TextPrimary,
			Font = Enum.Font.Code, TextSize = 12, ZIndex = 9502, Parent = wf,
		})
		Pad(wTxt, 0, 0, 10, 10)

		OnTheme(function()
			wf.BackgroundColor3 = Theme.Main
			ws.Color = Theme.Border
			wTop.BackgroundColor3 = Theme.Accent
			wTxt.TextColor3 = Theme.TextPrimary
		end, wf)

		local wmO = { Frame = wf, Pos = "TopLeft", Text = initText or "" }
		function wmO:UpdateSize()
			local clean = tostring(self.Text):gsub("<[^>]->", "")
			local w = TextWidth(clean, 12, Enum.Font.Code)
			wf.Size = UDim2.fromOffset(w + 20, 26)
		end
		function wmO:UpdatePosition()
			local mp, ms = Main.AbsolutePosition, Main.AbsoluteSize
			local wsz = wf.AbsoluteSize
			local pd = 6
			local posTbl
			if Win.Visible then
				posTbl = {
					TopLeft     = { UDim2.fromOffset(mp.X, mp.Y - wsz.Y - pd), Vector2.new(0, 0) },
					TopRight    = { UDim2.fromOffset(mp.X + ms.X, mp.Y - wsz.Y - pd), Vector2.new(1, 0) },
					BottomLeft  = { UDim2.fromOffset(mp.X, mp.Y + ms.Y + pd), Vector2.new(0, 0) },
					BottomRight = { UDim2.fromOffset(mp.X + ms.X, mp.Y + ms.Y + pd), Vector2.new(1, 0) },
				}
			else
				posTbl = {
					TopLeft     = { UDim2.new(0, 8, 0, 8), Vector2.new(0, 0) },
					TopRight    = { UDim2.new(1, -8, 0, 8), Vector2.new(1, 0) },
					BottomLeft  = { UDim2.new(0, 8, 1, -8), Vector2.new(0, 1) },
					BottomRight = { UDim2.new(1, -8, 1, -8), Vector2.new(1, 1) },
				}
			end
			local p = posTbl[self.Pos] or posTbl.TopLeft
			wf.Position = p[1]
			wf.AnchorPoint = p[2]
		end
		function wmO:SetText(t) self.Text = t; wTxt.Text = t; self:UpdateSize(); self:UpdatePosition() end
		function wmO:SetPosition(p) self.Pos = p; self:UpdatePosition() end
		function wmO:SetVisible(v) wf.Visible = v end
		function wmO:Destroy() wf:Destroy() end
		wf:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() wmO:UpdatePosition() end)
		Main:GetPropertyChangedSignal("AbsolutePosition"):Connect(function() wmO:UpdatePosition() end)
		Main:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() wmO:UpdatePosition() end)
		wmO:UpdateSize()
		wmO:SetPosition("TopLeft")
		task.defer(function() wmO:UpdatePosition() end)
		table.insert(Win.Watermarks, wmO)
		return wmO
	end

