		--// SLIDER ----------------------------------------------------
		function TabObj:Slider(sOpts)
			sOpts = sOpts or {}
			local compTitle = sOpts.Title    or "Slider"
			local Min       = tonumber(sOpts.Min) or 0
			local Max       = tonumber(sOpts.Max) or 100
			local Decimal   = tonumber(sOpts.Decimal) or 0
			local Suffix    = sOpts.Suffix   or ""
			local Prefix    = sOpts.Prefix   or ""
			local Dual      = sOpts.Dual     or false
			local Step      = tonumber(sOpts.Step)
			local Callback  = sOpts.Callback or function() end
			local FlagName  = sOpts.Flag     or (TabTitle .. "/" .. compTitle)
			if Max <= Min then Max = Min + 1 end  -- FIX: divide-by-zero in UpdVis

			local DefaultVal
			if Dual then
				DefaultVal = type(sOpts.Default) == "table"
					and { math.clamp(sOpts.Default[1] or Min, Min, Max), math.clamp(sOpts.Default[2] or Max, Min, Max) }
					or { Min, Max }
			else
				DefaultVal = math.clamp(tonumber(sOpts.Default) or Min, Min, Max)
			end
			local CurVal = Dual and { DefaultVal[1], DefaultVal[2] } or DefaultVal

			local Row = CreateRow(compTitle, IsMobile and 46 or 52, sOpts.Description)

			local TrackW = IsMobile and 104 or 150
			local labelW = IsMobile and 90 or 130

			local TLbl = New("TextLabel", {
