--// Viewport helpers -------------------------------------------------
local function GetCamera()
	return workspace and workspace.CurrentCamera or nil
end

local function Viewport()
	local cam = GetCamera()
	local vp = cam and cam.ViewportSize
	if not vp or vp.X < 1 or vp.Y < 1 then
		return Vector2.new(1280, 720)
	end
	return vp
end

--// FIX #9: treat small viewports as mobile too (tablets / emulators / small
--// windows), instead of relying on TouchEnabled alone.
local function DetectMobile()
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local vp = Viewport()
	return touch or math.min(vp.X, vp.Y) < 460
end

local IsMobile = DetectMobile()

--// FIX #11: some executors cannot parent to CoreGui; and re-running the
--// script must not stack a second UI on top of the old one.
local function GuiParent()
	local ok, hidden = pcall(function()
		return gethui and gethui() or nil
	end)
	if ok and hidden then return hidden end
	local canCore = pcall(function() return CoreGui:GetChildren() end)
	if canCore then return CoreGui end
	return LocalPlayer:WaitForChild("PlayerGui")
end

local function DestroyOld(name)
	for _, container in ipairs({ GuiParent(), LocalPlayer:FindFirstChild("PlayerGui") }) do
		if container then
			local old = container:FindFirstChild(name)
			while old do
				old:Destroy()
				old = container:FindFirstChild(name)
			end
		end
	end
end

