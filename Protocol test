			local busy = false
			Btn.MouseButton1Click:Connect(function()
				if busy then return end
				busy = true
				local orig = Btn.Text
				Btn.Text = "✓"
				Tw(Btn, { BackgroundColor3 = Color3.fromRGB(46, 200, 110) }, TF)
				task.delay(0.35, function()
					Btn.Text = orig
					Tw(Btn, { BackgroundColor3 = Theme.Accent }, TF)
