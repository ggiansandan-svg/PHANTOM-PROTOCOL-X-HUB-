        local WMObj = {
            Frame      = WM,
            PosString  = "TopLeft",
            CurrentText= InitText or ""
        }

        function WMObj:UpdateSize()
            local clean = self.CurrentText:gsub("<[^>]->", "")
            local w = TextService:GetTextSize(clean, 13, Enum.Font.Code, Vector2.new(10000, 28)).X
            WM.Size = UDim2.fromOffset(w + 24, 28)
        end

        function WMObj:SetText(txt)
            self.CurrentText = txt
            WMText.Text = txt
            self:UpdateSize()
            self:UpdatePosition()
        end

        function WMObj:SetVisible(v)
            WM.Visible = v
        end

        function WMObj:UpdatePosition()
            local pos = self.PosString
            if WinObj.Visible then
                local mp = MainFrame.AbsolutePosition
                local ms = MainFrame.AbsoluteSize
                local ws = WM.AbsoluteSize
                local pd = 8
                if pos == "TopLeft"     then WM.Position = UDim2.fromOffset(mp.X, mp.Y - ws.Y - pd) WM.AnchorPoint = Vector2.new(0,0)
                elseif pos == "TopRight"    then WM.Position = UDim2.fromOffset(mp.X + ms.X, mp.Y - ws.Y - pd) WM.AnchorPoint = Vector2.new(1,0)
                elseif pos == "BottomLeft"  then WM.Position = UDim2.fromOffset(mp.X, mp.Y + ms.Y + pd) WM.AnchorPoint = Vector2.new(0,0)
                elseif pos == "BottomRight" then WM.Position = UDim2.fromOffset(mp.X + ms.X, mp.Y + ms.Y + pd) WM.AnchorPoint = Vector2.new(1,0)
                end
            else
                if pos == "TopLeft"     then WM.Position = UDim2.new(0,15,0,15)   WM.AnchorPoint = Vector2.new(0,0)
                elseif pos == "TopRight"    then WM.Position = UDim2.new(1,-15,0,15) WM.AnchorPoint = Vector2.new(1,0)
                elseif pos == "BottomLeft"  then WM.Position = UDim2.new(0,15,1,-15) WM.AnchorPoint = Vector2.new(0,1)
                elseif pos == "BottomRight" then WM.Position = UDim2.new(1,-15,1,-15) WM.AnchorPoint = Vector2.new(1,1)
                end
            end
        end

        function WMObj:SetPosition(p)
            self.PosString = p
            self:UpdatePosition()
        end

        WM:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() WMObj:UpdatePosition() end)
        WMObj:UpdateSize()
        WMObj:SetPosition("TopLeft")
        task.defer(function() WMObj:UpdatePosition() end)
        table.insert(WinObj.Watermarks, WMObj)
        return WMObj
    end

