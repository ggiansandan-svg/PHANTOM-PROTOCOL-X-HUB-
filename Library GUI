        if ThemeOpen then CloseThemePopup() else OpenThemePopup() end
    end)

    UserInputService.InputBegan:Connect(function(Input)
        if Input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if not ThemeOpen then return end
        local mp  = Vector2.new(Input.Position.X, Input.Position.Y)
        local tp  = ThemePopup.AbsolutePosition
        local ts  = ThemePopup.AbsoluteSize
        local bp  = ThemeBtn.AbsolutePosition
        local bs  = ThemeBtn.AbsoluteSize
        local inP = mp.X >= tp.X and mp.X <= tp.X+ts.X and mp.Y >= tp.Y and mp.Y <= tp.Y+ts.Y
        local inB = mp.X >= bp.X and mp.X <= bp.X+bs.X and mp.Y >= bp.Y and mp.Y <= bp.Y+bs.Y
        if not inP and not inB then CloseThemePopup() end
    end)

