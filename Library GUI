--// ================================================================
--//  CREATOR MODULE
--// ================================================================
local Creator = {}

function Creator.New(Class, Properties)
    local Inst = Instance.new(Class)
    for Key, Value in pairs(Properties or {}) do
        if Key ~= "Parent" then
            pcall(function() Inst[Key] = Value end)
        end
    end
    if Properties and Properties.Parent then
        Inst.Parent = Properties.Parent
    end
    return Inst
end

function Creator.AddCorner(Parent, Radius)
    return Creator.New("UICorner", {
        CornerRadius = UDim.new(0, Radius or 8),
        Parent       = Parent
    })
end

function Creator.AddStroke(Parent, Color, Thickness, Mode)
    return Creator.New("UIStroke", {
        Color            = Color or Color3.fromRGB(63, 63, 70),
        Thickness        = Thickness or 1,
        ApplyStrokeMode  = Mode or Enum.ApplyStrokeMode.Border,
        Parent           = Parent
    })
end

function Creator.AddPadding(Parent, Top, Bottom, Left, Right)
    return Creator.New("UIPadding", {
        PaddingTop    = UDim.new(0, Top    or 0),
        PaddingBottom = UDim.new(0, Bottom or 0),
        PaddingLeft   = UDim.new(0, Left   or 0),
        PaddingRight  = UDim.new(0, Right  or 0),
        Parent        = Parent
    })
end

function Creator.AddList(Parent, Padding, Sort, Direction)
    return Creator.New("UIListLayout", {
        SortOrder        = Sort      or Enum.SortOrder.LayoutOrder,
        FillDirection    = Direction or Enum.FillDirection.Vertical,
        Padding          = UDim.new(0, Padding or 0),
        Parent           = Parent
    })
end

function Creator.AddGrid(Parent, CellSize, Padding)
    return Creator.New("UIGridLayout", {
        CellSize         = CellSize or UDim2.new(0, 50, 0, 50),
        CellPaddingH     = UDim.new(0, Padding or 4),
        CellPaddingV     = UDim.new(0, Padding or 4),
        Parent           = Parent
    })
end

function Creator.AddSizeConstraint(Parent, Min, Max)
    return Creator.New("UISizeConstraint", {
        MinSize = Min or Vector2.new(0, 0),
        MaxSize = Max or Vector2.new(math.huge, math.huge),
        Parent  = Parent
    })
end

