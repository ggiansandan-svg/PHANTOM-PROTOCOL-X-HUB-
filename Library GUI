            if WinObj.CurrentTab == TabObj then return end

            HomePage.Visible = false

            -- Deactivate all
            for _, t in ipairs(WinObj.Tabs) do
                if t == TabObj then continue end

                if t == WinObj.CurrentTab then
                    Anim.Fade(t.Canvas, 0, 1, 0.18)
                    task.delay(0.18, function()
                        if WinObj.CurrentTab ~= t then
                            t.Canvas.Visible = false
                        end
