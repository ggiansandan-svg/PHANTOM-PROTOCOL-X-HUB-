                ApplyBtn.BackgroundColor3 = Theme.Accent
                ApplyBtn.TextColor3 = Theme.Main
                if AlphaLbl then AlphaLbl.TextColor3 = Theme.TextSecondary end
            end)

            local CPObj = {}
            function CPObj:GetComponentType() return "Colorpicker" end
            function CPObj:GetValue()         return CurColor       end
            function CPObj:GetTransparency()  return 1 - Alpha      end
            function CPObj:SetValue(c)   H,S,V = Color3.toHSV(c) CurColor=c ApplyCP(true) end
            function CPObj:SetTransparency(t) Alpha = 1-math.clamp(t,0,1) ApplyCP(true) end
            function CPObj:Open()  OpenPicker()  end
            function CPObj:Close() ClosePicker() end
            Library.Flags[FlagName] = CPObj
            return CPObj
        end

