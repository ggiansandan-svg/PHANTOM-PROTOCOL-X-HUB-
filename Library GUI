--// ================================================================
--//  UTILS MODULE
--// ================================================================
local Utils = {}

function Utils.FormatKeyName(KeyEnum)
    if not KeyEnum then return "" end
    local n = KeyEnum.Name
    if n == "MouseButton1"  then return "MB1"    end
    if n == "MouseButton2"  then return "MB2"    end
    if n == "MouseButton3"  then return "MB3"    end
    if n == "LeftShift"     then return "LShift" end
    if n == "RightShift"    then return "RShift" end
    if n == "LeftControl"   then return "LCtrl"  end
    if n == "RightControl"  then return "RCtrl"  end
    if n == "LeftAlt"       then return "LAlt"   end
    if n == "RightAlt"      then return "RAlt"   end
    return n
end

function Utils.Clamp(v, mn, mx)   return math.max(mn, math.min(mx, v))  end
function Utils.Lerp(a, b, t)      return a + (b - a) * t                end
function Utils.IsMobile()         return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled end
function Utils.GetScreenSize()    return workspace.CurrentCamera.ViewportSize end

function Utils.Round(n, dec)
    dec = dec or 0
    local m = 10^dec
    return math.floor(n * m + 0.5) / m
end

function Utils.Copy(tbl)
    local t = {}
    for k, v in pairs(tbl) do t[k] = v end
    return t
end

--// ================================================================
--//  ANIMATION MODULE
--// ================================================================
local Anim = {}
local ShineConns = {}

local TweenFast   = TweenInfo.new(0.15, Enum.EasingStyle.Quad,  Enum.EasingDirection.Out)
local TweenSmooth = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local TweenSpring = TweenInfo.new(0.35, Enum.EasingStyle.Back,  Enum.EasingDirection.Out)
local TweenInstant= TweenInfo.new(0)

function Anim.Tween(Obj, Props, Info)
    local tw = TweenService:Create(Obj, Info or TweenSmooth, Props)
    tw:Play()
    return tw
end

function Anim.TweenFast(Obj, Props)   return Anim.Tween(Obj, Props, TweenFast)   end
function Anim.TweenSpring(Obj, Props) return Anim.Tween(Obj, Props, TweenSpring) end
function Anim.TweenInstant(Obj, Props)return Anim.Tween(Obj, Props, TweenInstant)end

function Anim.Fade(Obj, From, To, Duration)
    Obj.GroupTransparency = From
    Anim.Tween(Obj, {GroupTransparency = To},
        TweenInfo.new(Duration or 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
end

function Anim.FadeIn(Obj)
    Obj.Visible = true
    Anim.Fade(Obj, 1, 0, 0.25)
end

function Anim.FadeOut(Obj, Callback)
    Anim.Fade(Obj, 0, 1, 0.25)
    task.delay(0.25, function()
        Obj.Visible = false
        if Callback then Callback() end
    end)
end

function Anim.SlideOpen(Obj, TargetSize, Duration)
    Obj.Visible = true
    Anim.Tween(Obj, {Size = TargetSize},
        TweenInfo.new(Duration or 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out))
end

function Anim.SlideClose(Obj, CloseSize, Duration, Callback)
    Anim.Tween(Obj, {Size = CloseSize},
        TweenInfo.new(Duration or 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out))
    task.delay(Duration or 0.25, function()
        Obj.Visible = false
        if Callback then Callback() end
    end)
end

function Anim.ApplyShine(Theme, Root)
    for _, c in ipairs(ShineConns) do pcall(function() c:Disconnect() end) end
    table.clear(ShineConns)

    if not Theme or not Root then return end
    if not Theme.Shine or not Theme.Shine.Enabled then return end

    local Cfg   = Theme.Shine
    local Speed = Cfg.Speed or 0.5
    local RotSp = Cfg.RotationSpeed or 25
    local ColSeq= Cfg.ColorSequence or ColorSequence.new({
        ColorSequenceKeypoint.new(0,   Theme.Accent),
        ColorSequenceKeypoint.new(0.5, Color3.new(1,1,1)),
        ColorSequenceKeypoint.new(1,   Theme.Accent),
    })

    for _, obj in ipairs(Root:GetDescendants()) do
        if obj:IsA("UIGradient") then
            local conn = RunService.RenderStepped:Connect(function(dt)
                local t = (obj:GetAttribute("_t") or 0) + dt * Speed
                obj:SetAttribute("_t", t)
                obj.Rotation = (t * RotSp) % 360
                obj.Color     = ColSeq
            end)
            table.insert(ShineConns, conn)
        end
    end
end

