        TextSize        = 12,
        TextXAlignment  = Enum.TextXAlignment.Left,
        TextWrapped     = true,
        Parent          = Inner
    })

    --// Progress bar
    local ProgBG = Creator.New("Frame", {
        Size            = UDim2.new(1, -16, 0, 3),
        Position        = UDim2.new(0, 8, 1, -8),
        BackgroundColor3= Theme and Theme.Border or Color3.fromRGB(63,63,70),
        BorderSizePixel = 0,
        Parent          = NF
    })
    Creator.AddCorner(ProgBG, 2)

    local ProgFill = Creator.New("Frame", {
        Size            = UDim2.new(1, 0, 1, 0),
        BackgroundColor3= AccentColor,
        BorderSizePixel = 0,
        Parent          = ProgBG
    })
    Creator.AddCorner(ProgFill, 2)

    --// Close button
    local CloseBtn = Creator.New("TextButton", {
        Size            = UDim2.new(0, 16, 0, 16),
        Position        = UDim2.new(1, -22, 0, 6),
        BackgroundTransparency = 1,
        Text            = "×",
        TextColor3      = Theme and Theme.TextSecondary or Color3.fromRGB(161,161,170),
        Font            = Enum.Font.GothamBold,
        TextSize        = 16,
        Parent          = NF
    })

    --// Animate in
    local contentH = 16 + 18 + 4 + ContentLbl.TextBounds.Y + 11 + 8
    contentH = math.max(contentH, 70)

    Anim.Tween(NF, {Size = UDim2.new(1, 0, 0, contentH)},
        TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))

    --// Progress
    Anim.Tween(ProgFill, {Size = UDim2.new(0, 0, 1, 0)},
        TweenInfo.new(Duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out))

    local function Dismiss()
        Anim.Tween(NF, {Size = UDim2.new(1, 0, 0, 0)},
            TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In))
        task.delay(0.3, function() NF:Destroy() end)
    end

    CloseBtn.MouseButton1Click:Connect(Dismiss)
    task.delay(Duration, Dismiss)

    return {Dismiss = Dismiss, Frame = NF}
end

