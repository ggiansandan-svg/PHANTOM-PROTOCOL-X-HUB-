                Anim.SlideClose(Picker, UDim2.new(0, 240, 0, 0), 0.2)
            end)

            --// Slider drag helper
            local function SliderDrag(track, onDrag)
                local drag = false
                track.InputBegan:Connect(function(I)
                    if I.UserInputType == Enum.UserInputType.MouseButton1 or I.UserInputType == Enum.UserInputType.Touch then
                        drag = true
                        onDrag(math.clamp((I.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1))
                    end
                end)
                UserInputService.InputEnded:Connect(function(I)
                    if I.UserInputType == Enum.UserInputType.MouseButton1 or I.UserInputType == Enum.UserInputType.Touch then drag = false end
                end)
                UserInputService.InputChanged:Connect(function(I)
                    if drag and (I.UserInputType == Enum.UserInputType.MouseMovement or I.UserInputType == Enum.UserInputType.Touch) then
                        onDrag(math.clamp((I.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1))
                    end
                end)
            end

            --// Color map drag
            local mapDrag = false
            CMap.InputBegan:Connect(function(I)
                if I.UserInputType == Enum.UserInputType.MouseButton1 or I.UserInputType == Enum.UserInputType.Touch then
                    mapDrag = true
                    local function Upd(p)
                        S = math.clamp((p.X - CMap.AbsolutePosition.X) / CMap.AbsoluteSize.X, 0, 1)
                        V = 1 - math.clamp((p.Y - CMap.AbsolutePosition.Y) / CMap.AbsoluteSize.Y, 0, 1)
                        ApplyCP(true)
                    end
                    Upd(I.Position)
                    local mc, ec
                    mc = UserInputService.InputChanged:Connect(function(Mv)
                        if Mv.UserInputType == Enum.UserInputType.MouseMovement or Mv.UserInputType == Enum.UserInputType.Touch then Upd(Mv.Position) end
                    end)
                    ec = UserInputService.InputEnded:Connect(function(E)
                        if E.UserInputType == Enum.UserInputType.MouseButton1 or E.UserInputType == Enum.UserInputType.Touch then
                            mc:Disconnect() ec:Disconnect() mapDrag = false
                        end
                    end)
                end
            end)

            SliderDrag(HueSl.Track, function(r) H = r ApplyCP(true) end)
            SliderDrag(SatSl.Track, function(r) S = r ApplyCP(true) end)
            SliderDrag(ValSl.Track, function(r) V = r ApplyCP(true) end)
            if AlpSl then SliderDrag(AlpSl.Track, function(r) Alpha = r ApplyCP(true) end) end

            --// Toggle picker
            local PickerOpen = false

            local function ClosePicker()
                PickerOpen = false
                Anim.SlideClose(Picker, UDim2.new(0, 240, 0, 0), 0.2)
            end

            local function OpenPicker()
                PickerOpen = true
                local bp  = Preview.AbsolutePosition
                local sc  = ScreenGui.AbsoluteSize
                local X   = bp.X - 240 + 24
                local Y   = bp.Y + 28
                if X < 10 then X = 10 end
                if Y + PICKER_TOT > sc.Y - 10 then Y = bp.Y - PICKER_TOT - 6 end
                Picker.Position = UDim2.fromOffset(X, Y)
                Picker.Size     = UDim2.new(0, 240, 0, 0)
                Picker.Visible  = true
                Anim.SlideOpen(Picker, UDim2.new(0, 240, 0, PICKER_TOT), 0.2)
            end

            table.insert(WinObj.Popups, {Close = ClosePicker})

            Preview.MouseButton1Click:Connect(function()
                if PickerOpen then ClosePicker() else OpenPicker() end
            end)

            UserInputService.InputBegan:Connect(function(I)
                if I.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                if not PickerOpen then return end
                local mp  = Vector2.new(I.Position.X, I.Position.Y)
                local pp  = Picker.AbsolutePosition
                local ps  = Picker.AbsoluteSize
                local bp  = Preview.AbsolutePosition
                local bs  = Preview.AbsoluteSize
                local inP = mp.X>=pp.X and mp.X<=pp.X+ps.X and mp.Y>=pp.Y and mp.Y<=pp.Y+ps.Y
                local inB = mp.X>=bp.X and mp.X<=bp.X+bs.X and mp.Y>=bp.Y and mp.Y<=bp.Y+bs.Y
                if not inP and not inB then ClosePicker() end
            end)

