                Position         = UDim2.new(1, -(TrackW + 5), 0.5, -12),
                BackgroundTransparency = 1,
                Text             = "",
                AutoButtonColor  = false,
                Parent           = Row
            })

            local Track = Creator.New("Frame", {
                Size             = UDim2.new(1, 0, 0, 6),
                Position         = UDim2.new(0, 0, 0.5, -3),
                BackgroundColor3 = Theme.Border,
                BorderSizePixel  = 0,
                Parent           = TrackBtn
            })
            Creator.AddCorner(Track, 3)

            local Fill = Creator.New("Frame", {
                Size             = UDim2.new(0, 0, 1, 0),
                BackgroundColor3 = Theme.Accent,
                BorderSizePixel  = 0,
                Parent           = Track
            })
            Creator.AddCorner(Fill, 3)

            local H1 = Creator.New("Frame", {
                Size             = UDim2.new(0, 16, 0, 16),
                AnchorPoint      = Vector2.new(0.5, 0.5),
                Position         = UDim2.new(0, 0, 0.5, 0),
                BackgroundColor3 = Color3.new(1,1,1),
                BorderSizePixel  = 0,
                ZIndex           = 2,
                Parent           = Track
            })
            Creator.AddCorner(H1, 8)
            Creator.AddStroke(H1, Theme.Accent, 2)

            local H2 = nil
            if Dual then
                H2 = Creator.New("Frame", {
                    Size             = UDim2.new(0, 16, 0, 16),
                    AnchorPoint      = Vector2.new(0.5, 0.5),
                    Position         = UDim2.new(1, 0, 0.5, 0),
                    BackgroundColor3 = Color3.new(1,1,1),
                    BorderSizePixel  = 0,
                    ZIndex           = 2,
                    Parent           = Track
                })
                Creator.AddCorner(H2, 8)
                Creator.AddStroke(H2, Theme.Accent, 2)
            end

            --// Tooltip
            local Tip = Creator.New("Frame", {
                Size             = UDim2.new(0, 50, 0, 22),
                AnchorPoint      = Vector2.new(0.5, 1),
                BackgroundColor3 = Theme.Sidebar,
                Visible          = false,
                ZIndex           = 100,
                Parent           = Track
            })
            Creator.AddCorner(Tip, 4)
            Creator.AddStroke(Tip, Theme.Border, 1)
            local TipText = Creator.New("TextLabel", {
                Size             = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text             = "",
                TextColor3       = Theme.TextPrimary,
                Font             = Enum.Font.Code,
                TextSize         = 11,
                ZIndex           = 101,
                Parent           = Tip
            })

            --// Optional input box
            local InputBox = nil
            if ShowInput then
                InputBox = Creator.New("TextBox", {
                    Size             = UDim2.new(0, 44, 0, 24),
                    Position         = UDim2.new(1, 0, 0.5, 0),
                    AnchorPoint      = Vector2.new(1, 0.5),
                    BackgroundColor3 = Theme.Search,
                    Text             = "",
                    TextColor3       = Theme.TextPrimary,
                    Font             = Enum.Font.Code,
                    TextSize         = 12,
                    TextXAlignment   = Enum.TextXAlignment.Center,
                    ClearTextOnFocus = false,
                    Parent           = Row
                })
                Creator.AddCorner(InputBox, 4)
                local IS = Creator.AddStroke(InputBox, Theme.Border, 1)

                InputBox.Focused:Connect(function()   Anim.TweenFast(IS, {Color = Theme.Accent}) end)
                InputBox.FocusLost:Connect(function()
                    Anim.TweenFast(IS, {Color = Theme.Border})
                    local n = tonumber(InputBox.Text)
                    if n then
                        SetVal(Dual and {math.clamp(n, Min, CurVal[2]), CurVal[2]} or n, true)
                    else
                        InputBox.Text = tostring(Dual and CurVal[1] or CurVal)
                    end
                end)

                OnThemeUpdate(function()
                    InputBox.BackgroundColor3 = Theme.Search
                    InputBox.TextColor3       = Theme.TextPrimary
                    IS.Color                  = Theme.Border
                end)
            end

            --// Step markers
            if Step and Step > 0 then
                local total = math.floor((Max - Min) / Step)
                for i = 0, total do
                    local m = Creator.New("Frame", {
                        Size             = UDim2.new(0, 2, 0, 6),
                        Position         = UDim2.new(i/total, -1, 0.5, -3),
                        BackgroundColor3 = Theme.Border,
                        BorderSizePixel  = 0,
                        ZIndex           = 1,
                        Parent           = Track
                    })
                    Creator.AddCorner(m, 1)
                    OnThemeUpdate(function() m.BackgroundColor3 = Theme.Border end)
                end
            end

            OnThemeUpdate(function()
                TL.TextColor3    = Theme.TextPrimary
                TL.Font          = Theme.Font
                ValLbl.TextColor3= Theme.Accent
                Track.BackgroundColor3 = Theme.Border
                Fill.BackgroundColor3  = Theme.Accent
                Tip.BackgroundColor3   = Theme.Sidebar
                TipText.TextColor3     = Theme.TextPrimary
            end)

            local ZeroA = math.clamp((ZeroNum - Min) / (Max - Min), 0, 1)

            local function Fmt(v)
                return Prefix .. string.format("%." .. Decimal .. "f", v) .. Suffix
            end

            local function SnapV(v)
                if not Step or Step <= 0 then return v end
                return math.clamp(math.round((v - Min) / Step) * Step + Min, Min, Max)
            end

            local TI0 = TweenInfo.new(0.05)

            local function UpdVis(v)
                if Dual then
                    local a1 = math.clamp((v[1]-Min)/(Max-Min), 0, 1)
                    local a2 = math.clamp((v[2]-Min)/(Max-Min), 0, 1)
                    TweenService:Create(Fill, TI0, {Position = UDim2.new(a1,0,0,0), Size = UDim2.new(a2-a1,0,1,0)}):Play()
                    TweenService:Create(H1, TI0, {Position = UDim2.new(a1,0,0.5,0)}):Play()
                    if H2 then TweenService:Create(H2, TI0, {Position = UDim2.new(a2,0,0.5,0)}):Play() end
                    ValLbl.Text = Fmt(v[1]) .. " – " .. Fmt(v[2])
                    if InputBox then InputBox.Text = tostring(v[1]) end
                else
                    local a = math.clamp((v-Min)/(Max-Min), 0, 1)
                    local sA = math.min(a, ZeroA)
                    local szA= math.abs(a - ZeroA)
                    TweenService:Create(Fill, TI0, {Position = UDim2.new(sA,0,0,0), Size = UDim2.new(szA,0,1,0)}):Play()
                    TweenService:Create(H1, TI0, {Position = UDim2.new(a,0,0.5,0)}):Play()
                    ValLbl.Text = Fmt(v)
                    if InputBox then InputBox.Text = tostring(v) end
                    Tip.Position = UDim2.new(a, 0, 0, -6)
                    TipText.Text = Fmt(v)
                end
            end

            function SetVal(v, fire)
                if Dual then
                    if type(v) == "table" then
                        CurVal = {math.clamp(SnapV(v[1]), Min, Max), math.clamp(SnapV(v[2]), Min, Max)}
                        if CurVal[1] > CurVal[2] then CurVal[1] = CurVal[2] end
                    end
                else
                    CurVal = math.clamp(SnapV(v), Min, Max)
                end
                UpdVis(CurVal)
                if fire then Callback(CurVal) end
            end

            UpdVis(CurVal)

            local IsDrag = false
            local ActH   = 1

            local function DoDrag(Input)
                local rel = math.clamp((Input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                local raw = Min + rel * (Max - Min)
                local sv  = SnapV(raw)

                if Dual then
                    local nv = {CurVal[1], CurVal[2]}
                    nv[ActH] = sv
                    if ActH == 1 and nv[1] > nv[2] then nv[1] = nv[2]
                    elseif ActH == 2 and nv[2] < nv[1] then nv[2] = nv[1] end
                    CurVal = nv
                else
                    CurVal = sv
                end

                UpdVis(CurVal)
                Callback(CurVal)

                if not Dual then
                    Tip.Visible  = true
                    Tip.Position = UDim2.new(rel, 0, 0, -6)
                    TipText.Text = Fmt(CurVal)
                end
            end

            TrackBtn.InputBegan:Connect(function(I)
                if I.UserInputType == Enum.UserInputType.MouseButton1 or I.UserInputType == Enum.UserInputType.Touch then
                    IsDrag = true
                    if Dual then
                        local rel = math.clamp((I.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                        local a1  = (CurVal[1]-Min)/(Max-Min)
                        local a2  = (CurVal[2]-Min)/(Max-Min)
                        local d1  = math.abs(rel-a1)
                        local d2  = math.abs(rel-a2)
                        ActH = (d1 == d2) and (rel > a1 and 2 or 1) or (d1 < d2 and 1 or 2)
                    end
                    DoDrag(I)
                    local h = (Dual and ActH == 2) and H2 or H1
                    if h then Anim.TweenFast(h, {Size = UDim2.new(0, 20, 0, 20)}) end
                end
            end)

            UserInputService.InputEnded:Connect(function(I)
                if (I.UserInputType == Enum.UserInputType.MouseButton1 or I.UserInputType == Enum.UserInputType.Touch) and IsDrag then
                    IsDrag = false
                    Tip.Visible = false
                    local h = (Dual and ActH == 2) and H2 or H1
                    if h then Anim.TweenFast(h, {Size = UDim2.new(0, 16, 0, 16)}) end
                end
            end)

            UserInputService.InputChanged:Connect(function(I)
                if IsDrag and (I.UserInputType == Enum.UserInputType.MouseMovement or I.UserInputType == Enum.UserInputType.Touch) then
                    DoDrag(I)
                end
            end)

            --// Scroll wheel
            TrackBtn.MouseEnter:Connect(function()
                local sc
                sc = UserInputService.InputChanged:Connect(function(I)
                    if I.UserInputType == Enum.UserInputType.MouseWheel then
                        local dir   = I.Position.Z > 0 and 1 or -1
                        local delta = (Step or (Decimal > 0 and 0.1 or 1)) * dir
                        if Dual then
                            SetVal({math.clamp(CurVal[1]+delta, Min, CurVal[2]), math.clamp(CurVal[2]+delta, CurVal[1], Max)}, true)
                        else
                            SetVal(CurVal + delta, true)
                        end
                    end
                end)
                TrackBtn.MouseLeave:Connect(function() if sc then sc:Disconnect() end end)
            end)

            local Obj = {}
            function Obj:GetComponentType()  return "Slider"  end
            function Obj:GetValue()          return CurVal    end
            function Obj:SetValue(v)         SetVal(v, true)  end
            function Obj:SetMin(m)           Min = m SetVal(CurVal, true) end
            function Obj:SetMax(m)           Max = m SetVal(CurVal, true) end
            function Obj:SetRange(mn, mx)    Min=mn Max=mx SetVal(CurVal, true) end
            function Obj:SetStep(s)          Step = s         end
            Library.Flags[FlagName] = Obj
            return Obj
        end

