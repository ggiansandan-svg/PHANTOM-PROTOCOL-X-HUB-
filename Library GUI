        function TabObj:Slider(Opts)
            local Title     = Opts.Title     or "Slider"
            local Min       = Opts.Min       or 0
            local Max       = Opts.Max       or 100
            local Default   = Opts.Default
            local Decimal   = Opts.Decimal   or 0
            local Prefix    = Opts.Prefix    or ""
            local Suffix    = Opts.Suffix    or ""
            local Step      = Opts.Step      or nil
            local Dual      = Opts.Dual      or false
            local ZeroNum   = Opts.ZeroNumber or Min
            local ShowInput = Opts.ShowInput or false
            local Callback  = Opts.Callback  or function() end
