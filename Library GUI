    local function OpenThemePopup()
        ThemeOpen = true
        local bp  = ThemeBtn.AbsolutePosition
        local bs  = ThemeBtn.AbsoluteSize
        local sc  = ScreenGui.AbsoluteSize
        local tgt = math.min(#themeNames * 34 + 38, 280)

        local X = bp.X + bs.X - 210
        local Y = bp.Y + bs.Y + 6
        if Y + tgt > sc.Y - 10 then Y = bp.Y - tgt - 6 end
        if X < 10 then X = 10 end

        ThemePopup.Position = UDim2.fromOffset(X, Y)
        ThemePopup.Visible  = true
        ThemePopup.Size     = UDim2.new(0, 210, 0, 0)
        Anim.SlideOpen(ThemePopup, UDim2.new(0, 210, 0, tgt), 0.2)
        ThemeSearchInput.Text = ""
    end

