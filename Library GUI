            MainFrame.Visible = true
            Anim.Fade(MainFrame, 1, 0, 0.2)
        else
            for _, p in ipairs(self.Popups) do
                if type(p.Close) == "function" then p.Close() end
            end
            Anim.Fade(MainFrame, 0, 1, 0.2)
