                Creator.AddList(TagCont, 4, Enum.SortOrder.LayoutOrder, Enum.FillDirection.Horizontal)
            end

            local function MakeTag(item)
                if not Multi then return end
                local T = Creator.New("Frame", {
                    Size             = UDim2.new(0, 0, 1, 0),
                    AutomaticSize    = Enum.AutomaticSize.X,
                    BackgroundColor3 = Theme.Accent,
                    BackgroundTransparency = 0.7,
                    Parent           = TagCont
                })
                Creator.AddCorner(T, 4)
                Creator.AddPadding(T, 0, 0, 6, 6)

                Creator.New("TextLabel", {
                    Size             = UDim2.new(0, 0, 1, 0),
                    AutomaticSize    = Enum.AutomaticSize.X,
                    BackgroundTransparency = 1,
                    Text             = item,
                    TextColor3       = Theme.Accent,
                    Font             = Theme.Font,
                    TextSize         = 11,
                    Parent           = T
                })

                local XBtn = Creator.New("TextButton", {
                    Size             = UDim2.new(0, 12, 0, 12),
                    BackgroundTransparency = 1,
                    Text             = "×",
                    TextColor3       = Theme.Accent,
                    Font             = Enum.Font.GothamBold,
                    TextSize         = 11,
                    Parent           = T
                })

                XBtn.MouseButton1Click:Connect(function()
                    local idx = table.find(Selected, item)
                    if idx then
                        table.remove(Selected, idx)
                        T:Destroy()
                        TagRefs[item] = nil
                        if OptBtns[item] then
                            OptBtns[item].Ck.Visible = false
                            Anim.TweenFast(OptBtns[item].Frame, {BackgroundTransparency = 1})
                            Anim.TweenFast(OptBtns[item].Text, {TextColor3 = Theme.TextPrimary})
                        end
                        Callback(Selected)
                        UpdDrop()
                    end
                end)

                return T
            end

            function UpdDrop()
                if Multi then
                    if #Selected == 0 then
                        if TagCont then TagCont.Visible = false end
                        DropBtn.Visible = true
                        DropText.Text   = "None"
                        DropText.TextColor3 = Theme.TextSecondary
                    else
                        if TagCont then TagCont.Visible = true end
                        DropBtn.Visible = false
                    end
                else
                    if #Selected > 0 then
                        local d = table.concat(Selected, ", ")
                        if #d > 22 then d = d:sub(1, 19) .. "..." end
                        DropText.Text = d
                        DropText.TextColor3 = Theme.TextPrimary
                    else
                        DropText.Text = "None"
                        DropText.TextColor3 = Theme.TextSecondary
                    end
                end
            end

            local function BuildOpt(name, parent, indent)
                local OF = Creator.New("Frame", {
                    Size             = UDim2.new(1, 0, 0, 32),
                    BackgroundColor3 = Theme.Accent,
                    BackgroundTransparency = table.find(Selected, name) and 0.75 or 1,
                    ZIndex           = 3001,
                    Parent           = parent
                })
                Creator.AddCorner(OF, 5)
                Creator.AddPadding(OF, 0, 0, 8 + (indent or 0), 8)

                local OB = Creator.New("TextButton", {
                    Size             = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text             = "",
                    ZIndex           = 3002,
                    Parent           = OF
                })

                local OT = Creator.New("TextLabel", {
                    Size             = UDim2.new(1, -22, 1, 0),
                    BackgroundTransparency = 1,
                    Text             = name,
                    TextColor3       = table.find(Selected, name) and Theme.Accent or Theme.TextPrimary,
                    Font             = Theme.Font,
                    TextSize         = 13,
                    TextXAlignment   = Enum.TextXAlignment.Left,
                    ZIndex           = 3002,
                    Parent           = OF
                })

                local OCk = Creator.New("ImageLabel", {
                    Size             = UDim2.new(0, 14, 0, 14),
                    Position         = UDim2.new(1, -20, 0.5, -7),
                    BackgroundTransparency = 1,
                    Image            = Icons.Assets.Checkmark,
                    ImageColor3      = Theme.Accent,
                    Visible          = table.find(Selected, name) ~= nil,
                    ZIndex           = 3002,
                    Parent           = OF
                })

                OB.MouseEnter:Connect(function()
                    if not table.find(Selected, name) then
                        Anim.TweenFast(OF, {BackgroundTransparency = 0.88})
                    end
                end)
                OB.MouseLeave:Connect(function()
                    if not table.find(Selected, name) then
                        Anim.TweenFast(OF, {BackgroundTransparency = 1})
                    end
                end)

                OB.MouseButton1Click:Connect(function()
                    if Multi then
                        local idx = table.find(Selected, name)
                        if idx then
                            table.remove(Selected, idx)
                            OCk.Visible = false
                            Anim.TweenFast(OF, {BackgroundTransparency = 1})
                            Anim.TweenFast(OT, {TextColor3 = Theme.TextPrimary})
                            if TagRefs[name] then TagRefs[name]:Destroy() TagRefs[name] = nil end
                        else
                            table.insert(Selected, name)
                            OCk.Visible = true
                            Anim.TweenFast(OF, {BackgroundTransparency = 0.75})
                            Anim.TweenFast(OT, {TextColor3 = Theme.Accent})
                            TagRefs[name] = MakeTag(name)
                        end
                        UpdDrop()
                        Callback(Selected)
                    else
                        for n, r in pairs(OptBtns) do
                            r.Ck.Visible = false
                            Anim.TweenFast(r.Frame, {BackgroundTransparency = 1})
                            Anim.TweenFast(r.Text, {TextColor3 = Theme.TextPrimary})
                        end
                        table.clear(Selected)
                        table.insert(Selected, name)
                        OCk.Visible = true
                        Anim.TweenFast(OF, {BackgroundTransparency = 0.75})
                        Anim.TweenFast(OT, {TextColor3 = Theme.Accent})
                        UpdDrop()
                        Callback(Selected[1])
                        CloseDD()
                    end
                end)

                OptBtns[name] = {Frame = OF, Btn = OB, Text = OT, Ck = OCk}
                table.insert(AllOpts, name)
            end

            local function BuildOpts(list)
                for _, c in OptScroll:GetChildren() do
                    if not c:IsA("UIListLayout") then c:Destroy() end
                end
                table.clear(OptBtns)
                table.clear(AllOpts)

                if Groups then
                    for gName, gOpts in pairs(Groups) do
                        local GH = Creator.New("TextLabel", {
                            Size             = UDim2.new(1, 0, 0, 22),
                            BackgroundTransparency = 1,
                            Text             = gName,
                            TextColor3       = Theme.TextSecondary,
                            Font             = Enum.Font.GothamBold,
                            TextSize         = 11,
                            TextXAlignment   = Enum.TextXAlignment.Left,
                            ZIndex           = 3001,
                            Parent           = OptScroll
                        })
                        Creator.AddPadding(GH, 0, 0, 10)
                        Creator.New("Frame", {Size = UDim2.new(1,0,0,1), BackgroundColor3 = Theme.Border, BorderSizePixel = 0, ZIndex = 3001, Parent = OptScroll})
                        for _, o in ipairs(gOpts) do BuildOpt(o, OptScroll, 8) end
                    end
                else
                    for _, o in ipairs(list) do BuildOpt(o, OptScroll, 0) end
                end

                UpdDrop()
            end

            BuildOpts(Options)

            if SrchInput then
                SrchInput:GetPropertyChangedSignal("Text"):Connect(function()
                    local q = string.lower(SrchInput.Text)
                    for name, refs in pairs(OptBtns) do
                        refs.Frame.Visible = q == "" or string.find(string.lower(name), q, 1, true) ~= nil
                    end
                end)
            end

            function CloseDD()
                IsOpen = false
                Anim.TweenFast(Chev, {Rotation = 0})
                Anim.TweenFast(DropStr, {Color = Theme.Border})
                Anim.SlideClose(Menu, UDim2.new(0, 220, 0, 0), 0.2)
                if RenConn then RenConn:Disconnect() RenConn = nil end
            end

            local function OpenDD()
                IsOpen = true

                local function UpdPos()
                    local bp  = DropBtn.AbsolutePosition
                    local bs  = DropBtn.AbsoluteSize
                    local sc  = ScreenGui.AbsoluteSize
                    local ch  = math.min(OptLayout.AbsoluteContentSize.Y + (Searchable and 46 or 14), MaxH)
                    local X   = bp.X
                    local Y   = bp.Y + bs.Y + 4
                    if Y + ch > sc.Y - 10 then Y = bp.Y - ch - 4 end
                    if X + 220 > sc.X then X = sc.X - 226 end
                    if X < 4 then X = 4 end
                    Menu.Position = UDim2.fromOffset(X, Y)
                    Menu.Size     = UDim2.new(0, math.max(bs.X, 200), 0, ch)
                end

                UpdPos()
                Menu.Visible = true
                Menu.Size    = UDim2.new(0, math.max(DropBtn.AbsoluteSize.X, 200), 0, 0)

                local ch = math.min(OptLayout.AbsoluteContentSize.Y + (Searchable and 46 or 14), MaxH)
                Anim.SlideOpen(Menu, UDim2.new(0, math.max(DropBtn.AbsoluteSize.X, 200), 0, ch), 0.2)
                Anim.TweenFast(Chev, {Rotation = 180})
                Anim.TweenFast(DropStr, {Color = Theme.Accent})

                RenConn = RunService.RenderStepped:Connect(UpdPos)
                if SrchInput then SrchInput.Text = "" SrchInput:CaptureFocus() end
            end

            table.insert(WinObj.Popups, {Close = CloseDD})

            DropBtn.MouseButton1Click:Connect(function()
                if IsOpen then CloseDD() else OpenDD() end
            end)

            UserInputService.InputBegan:Connect(function(I)
                if I.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                if not IsOpen then return end
                local mp  = Vector2.new(I.Position.X, I.Position.Y)
                local mp_ = Menu.AbsolutePosition
                local ms  = Menu.AbsoluteSize
                local bp  = DropBtn.AbsolutePosition
                local bs  = DropBtn.AbsoluteSize
                local inM = mp.X>=mp_.X and mp.X<=mp_.X+ms.X and mp.Y>=mp_.Y and mp.Y<=mp_.Y+ms.Y
                local inB = mp.X>=bp.X  and mp.X<=bp.X+bs.X  and mp.Y>=bp.Y  and mp.Y<=bp.Y+bs.Y
                if not inM and not inB then CloseDD() end
            end)

            OnThemeUpdate(function()
                DropBtn.BackgroundColor3 = Theme.Search
                DropStr.Color            = Theme.Border
                DropText.TextColor3      = #Selected > 0 and Theme.TextPrimary or Theme.TextSecondary
                Chev.ImageColor3         = Theme.TextSecondary
                Menu.BackgroundColor3    = Theme.Main
                OptScroll.ScrollBarImageColor3 = Theme.Border

                for name, r in pairs(OptBtns) do
                    local sel = table.find(Selected, name) ~= nil
                    r.Text.TextColor3  = sel and Theme.Accent or Theme.TextPrimary
                    r.Text.Font        = Theme.Font
                    r.Ck.ImageColor3   = Theme.Accent
                    r.Frame.BackgroundColor3 = Theme.Accent
                    r.Frame.BackgroundTransparency = sel and 0.75 or 1
                end
            end)

            local Obj = {}
            function Obj:GetComponentType() return "Dropdown" end
            function Obj:GetValue()         return Multi and Selected or Selected[1] end
            function Obj:SetValue(v)
                table.clear(Selected)
                if Multi then
                    if type(v) == "table" then for _, i in v do table.insert(Selected, i) end end
                else
                    if type(v) == "string" then table.insert(Selected, v) end
                end
                for name, r in pairs(OptBtns) do
                    local sel = table.find(Selected, name) ~= nil
                    r.Ck.Visible = sel
                    r.Frame.BackgroundTransparency = sel and 0.75 or 1
                    r.Text.TextColor3 = sel and Theme.Accent or Theme.TextPrimary
                end
                UpdDrop()
                Callback(Multi and Selected or Selected[1])
            end
            function Obj:SetOptions(list) BuildOpts(list) end
            function Obj:AddOption(name)
                if not table.find(AllOpts, name) then
                    table.insert(Options, name)
                    BuildOpt(name, OptScroll, 0)
                end
            end
            function Obj:RemoveOption(name)
                local idx = table.find(Options, name)
                if idx then
                    table.remove(Options, idx)
                    if OptBtns[name] then OptBtns[name].Frame:Destroy() OptBtns[name] = nil end
                    local si = table.find(Selected, name)
                    if si then table.remove(Selected, si) UpdDrop() end
                end
            end
            function Obj:GetOptions() return Options   end
            function Obj:Open()       OpenDD()         end
            function Obj:Close()      CloseDD()        end
            function Obj:Clear()      Obj:SetValue(Multi and {} or "") end
            Library.Flags[FlagName] = Obj
            return Obj
        end

        --// TEXTBOX
        function TabObj:Textbox(Opts)
            local Title     = Opts.Title     or "Textbox"
            local Default   = Opts.Default   or ""
            local Placeholder= Opts.Placeholder or "Type here"
            local Callback  = Opts.Callback  or function() end
            local FlagName  = Opts.Flag      or string.format("%s/Textbox/%s", TabTitle, Title)
            local NumericOnly= Opts.Numeric  or false

            local Row = CreateRow(Title)

            Creator.New("TextLabel", {
                Size             = UDim2.new(1, -220, 1, 0),
                Position         = UDim2.new(0, 36, 0, 0),
                BackgroundTransparency = 1,
                Text             = Title,
                TextColor3       = Theme.TextPrimary,
                Font             = Theme.Font,
                TextSize         = 15,
                TextXAlignment   = Enum.TextXAlignment.Left,
                Parent           = Row
            })

            local IB = Creator.New("TextBox", {
                Size             = UDim2.new(0, 100, 0, 30),
                Position         = UDim2.new(1, 0, 0.5, 0),
                AnchorPoint      = Vector2.new(1, 0.5),
                BackgroundColor3 = Theme.Search,
                Text             = Default,
                PlaceholderText  = Placeholder,
                TextColor3       = Theme.TextPrimary,
                PlaceholderColor3= Theme.TextSecondary,
                Font             = Enum.Font.Code,
                TextSize         = 13,
                TextXAlignment   = Enum.TextXAlignment.Left,
                AutomaticSize    = Enum.AutomaticSize.X,
                ClearTextOnFocus = false,
                ClipsDescendants = true,
                Parent           = Row
            })
            Creator.AddCorner(IB, 6)
            local IStr = Creator.AddStroke(IB, Theme.Border, 1)
            Creator.AddPadding(IB, 0, 0, 10, 10)
            Creator.AddSizeConstraint(IB, Vector2.new(100, 30), Vector2.new(280, 30))

            if NumericOnly then
                IB:GetPropertyChangedSignal("Text"):Connect(function()
                    local t = IB.Text:gsub("[^%d%.%-]", "")
                    if t ~= IB.Text then IB.Text = t end
                end)
            end

            IB.Focused:Connect(function()    Anim.TweenFast(IStr, {Color = Theme.Accent}) end)
            IB.FocusLost:Connect(function(enter)
                Anim.TweenFast(IStr, {Color = Theme.Border})
                Callback(IB.Text, enter)
            end)

            OnThemeUpdate(function()
                IB.BackgroundColor3    = Theme.Search
                IB.TextColor3          = Theme.TextPrimary
                IB.PlaceholderColor3   = Theme.TextSecondary
                IB.Font                = Enum.Font.Code
                IStr.Color             = Theme.Border
            end)

            local Obj = {}
            function Obj:GetComponentType() return "Textbox"    end
            function Obj:GetValue()         return IB.Text      end
            function Obj:SetValue(v)        IB.Text = tostring(v) Callback(IB.Text, false) end
            function Obj:SetPlaceholder(p)  IB.PlaceholderText = p end
            Library.Flags[FlagName] = Obj
            return Obj
        end

        --// KEYBIND
        function TabObj:Keybind(Opts)
            local Title     = Opts.Title     or "Keybind"
            local Default   = Opts.Default
            local Callback  = Opts.Callback  or function() end
            local FlagName  = Opts.Flag      or string.format("%s/Keybind/%s", TabTitle, Title)

            local CurKey = Default
            local Binding = false
            local Row = CreateRow(Title)

            Creator.New("TextLabel", {
                Size             = UDim2.new(1, -200, 1, 0),
                Position         = UDim2.new(0, 36, 0, 0),
                BackgroundTransparency = 1,
                Text             = Title,
                TextColor3       = Theme.TextPrimary,
                Font             = Theme.Font,
                TextSize         = 15,
                TextXAlignment   = Enum.TextXAlignment.Left,
                Parent           = Row
            })

            local KCont = Creator.New("TextButton", {
                Size             = UDim2.new(0, 160, 1, 0),
                Position         = UDim2.new(1, -165, 0, 0),
                BackgroundTransparency = 1,
                Text             = "",
                AutoButtonColor  = false,
                Parent           = Row
            })
            Creator.AddList(KCont, 8, Enum.SortOrder.LayoutOrder, Enum.FillDirection.Horizontal)

            local KbIcon = Creator.New("ImageLabel", {
                Size             = UDim2.new(0, 20, 0, 20),
                BackgroundTransparency = 1,
                Image            = Icons.Assets.Keyboard,
                ImageColor3      = Theme.TextSecondary,
                LayoutOrder      = 1,
                Parent           = KCont
            })

            local KbText = Creator.New("TextLabel", {
                Size             = UDim2.new(0, 0, 0, 20),
                AutomaticSize    = Enum.AutomaticSize.X,
                BackgroundTransparency = 1,
                Text             = Default and Utils.FormatKeyName(Default) or "None",
                TextColor3       = Theme.TextSecondary,
                Font             = Theme.Font,
                TextSize         = 13,
                TextXAlignment   = Enum.TextXAlignment.Right,
                LayoutOrder      = 2,
                Parent           = KCont
            })

            --// Visual keybind badge
            local KBadge = Creator.New("Frame", {
                Size             = UDim2.new(0, 0, 0, 22),
                AutomaticSize    = Enum.AutomaticSize.X,
                BackgroundColor3 = Theme.Search,
                LayoutOrder      = 3,
                Parent           = KCont
            })
            Creator.AddCorner(KBadge, 4)
            Creator.AddStroke(KBadge, Theme.Border, 1)
            Creator.AddPadding(KBadge, 0, 0, 8, 8)

            local KBadgeText = Creator.New("TextLabel", {
                Size             = UDim2.new(0, 0, 1, 0),
                AutomaticSize    = Enum.AutomaticSize.X,
                BackgroundTransparency = 1,
                Text             = Default and Utils.FormatKeyName(Default) or "—",
                TextColor3       = Theme.TextPrimary,
                Font             = Enum.Font.Code,
                TextSize         = 12,
                Parent           = KBadge
            })

            local BindConn = nil

            OnThemeUpdate(function()
                KbIcon.ImageColor3 = Binding and Theme.Accent or Theme.TextSecondary
                KbText.TextColor3  = Binding and Theme.Accent or Theme.TextSecondary
                KBadge.BackgroundColor3 = Theme.Search
                KBadgeText.TextColor3   = Theme.TextPrimary
            end)

            local function SetKey(k, fire)
                CurKey = k
                local display = k and Utils.FormatKeyName(k) or "None"
                KbText.Text     = display
                KBadgeText.Text = k and Utils.FormatKeyName(k) or "—"
                Anim.TweenFast(KbIcon, {ImageColor3 = Theme.TextSecondary})
                Anim.TweenFast(KbText, {TextColor3  = Theme.TextSecondary})
                if fire then Callback(CurKey) end
            end

            KCont.MouseButton1Click:Connect(function()
                Binding     = true
                KbText.Text = "..."
                KBadgeText.Text = "..."
                Anim.TweenFast(KbIcon, {ImageColor3 = Theme.Accent})
                Anim.TweenFast(KbText, {TextColor3  = Theme.Accent})

                if BindConn then BindConn:Disconnect() end
                BindConn = UserInputService.InputBegan:Connect(function(I, proc)
                    if proc then return end
                    if I.UserInputType == Enum.UserInputType.Keyboard or I.UserInputType.Name:find("MouseButton") then
                        Binding = false
                        BindConn:Disconnect()
                        BindConn = nil
                        local k = I.KeyCode.Name ~= "Unknown" and I.KeyCode or I.UserInputType
                        SetKey(k, true)
                    end
                end)
            end)

            UserInputService.InputBegan:Connect(function(I, proc)
                if proc then return end
                if CurKey and (I.KeyCode == CurKey or I.UserInputType == CurKey) then
                    Callback(CurKey)
                end
            end)

            local Obj = {}
            function Obj:GetComponentType() return "Keybind"          end
            function Obj:GetValue()         return CurKey             end
            function Obj:SetValue(k)        SetKey(k, true)           end
            function Obj:Clear()            SetKey(nil, true)         end
            Library.Flags[FlagName] = Obj
            return Obj
        end

        --// COLORPICKER (standalone)
        function TabObj:Colorpicker(Opts)
            local Title = Opts.Title or "Color"
            local Row   = CreateRow(Title)

            Creator.New("TextLabel", {
                Size             = UDim2.new(0.45, 0, 1, 0),
                Position         = UDim2.new(0, 36, 0, 0),
                BackgroundTransparency = 1,
                Text             = Title,
                TextColor3       = Theme.TextPrimary,
                Font             = Theme.Font,
                TextSize         = 15,
                TextXAlignment   = Enum.TextXAlignment.Left,
                Parent           = Row
            })

            local CPObj = AttachColorPicker(Row, Title, Opts)
            CPObj.Row   = Row
            return CPObj
        end

        return TabObj
    end

    --// CONFIG TAB
    WinObj.ConfigTab = WinObj:Tab({
        Title    = "Configuration",
        Icon     = Icons.Assets.Save,
        IsConfig = true
    })

    SaveBtn.MouseButton1Click:Connect(function()
        WinObj.ConfigTab:Activate()
    end)

    --// Animate shine on startup
    task.defer(function()
        Anim.ApplyShine(Theme, MainFrame)
    end)

    --// Welcome notif
    task.delay(0.8, function()
        Library:Notify({
            Title   = WinTitle,
            Content = "Loaded! Press " .. Utils.FormatKeyName(Library.ToggleKey) .. " to toggle.",
            Type    = "Success",
            Duration= 4
        })
    end)

    return WinObj
end

return Library
