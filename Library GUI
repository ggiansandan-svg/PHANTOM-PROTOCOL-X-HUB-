local Library = {
    ToggleKey    = Enum.KeyCode.RightControl,
    Flags        = {},
    CurrentTheme = "GitHub Dark",
    Version      = "2.0.0",
}

local Theme           = Themes["GitHub Dark"]
local ThemeCallbacks  = {}

local function OnThemeUpdate(fn) table.insert(ThemeCallbacks, fn) end

local function FireThemeUpdate()
    for _, fn in ipairs(ThemeCallbacks) do task.spawn(fn) end
end

function Library:SetWindowKeybind(Key) self.ToggleKey = Key end
function Library:GetTheme()            return Theme         end
function Library:GetThemeNames()
    local names = {}
    for k in pairs(Themes) do table.insert(names, k) end
    table.sort(names)
    return names
end

function Library:SetTheme(Name)
    if not Themes[Name] then return end
    Theme = Themes[Name]
    self.CurrentTheme = Name
    FireThemeUpdate()
end

function Library:Notify(Opts)
    Opts.Theme = Theme
    return Notification.New(Opts)
end

