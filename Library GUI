            --// UPDATE GRADIENTS
            local TI0 = TweenInfo.new(0.05)

            local function UpdSatGrad()
                local pH = Color3.fromHSV(H, 1, 1)
                for _, c in SatSl.GradFrame:GetChildren() do
                    if c:IsA("UIGradient") then c:Destroy() end
                end
                Creator.New("UIGradient", {
                    Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.new(1,1,1)),
                        ColorSequenceKeypoint.new(1, pH)
                    }),
                    Parent = SatSl.GradFrame
                })
            end

            local function UpdValGrad()
                local pHS = Color3.fromHSV(H, S, 1)
                for _, c in ValSl.GradFrame:GetChildren() do
                    if c:IsA("UIGradient") then c:Destroy() end
                end
                Creator.New("UIGradient", {
                    Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.new(0,0,0)),
                        ColorSequenceKeypoint.new(1, pHS)
                    }),
                    Parent = ValSl.GradFrame
                })
            end

            local function UpdAlpGrad()
                if not AlpSl then return end
                for _, c in AlpSl.GradFrame:GetChildren() do
                    if c:IsA("UIGradient") then c:Destroy() end
                end
                Creator.New("UIGradient", {
                    Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.new(0,0,0)),
                        ColorSequenceKeypoint.new(1, CurColor)
                    }),
                    Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 1),
                        NumberSequenceKeypoint.new(1, 0)
                    }),
                    Parent = AlpSl.GradFrame
                })
            end

            function ApplyCP(trigger)
                CurColor = Color3.fromHSV(H, S, V)

                CMap.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
                TweenService:Create(CMapCursor, TI0, {Position = UDim2.new(S, 0, 1-V, 0)}):Play()

                TweenService:Create(HueSl.Cursor, TI0, {Position = UDim2.new(H, 0, 0.5, 0)}):Play()
                HueSl.Label.Text = tostring(math.floor(H * 360)) .. "°"

                UpdSatGrad()
                TweenService:Create(SatSl.Cursor, TI0, {Position = UDim2.new(S, 0, 0.5, 0)}):Play()
                SatSl.Label.Text = tostring(math.floor(S * 100)) .. "%"

                UpdValGrad()
                TweenService:Create(ValSl.Cursor, TI0, {Position = UDim2.new(V, 0, 0.5, 0)}):Play()
                ValSl.Label.Text = tostring(math.floor(V * 100)) .. "%"

                if AlpSl then
                    UpdAlpGrad()
                    TweenService:Create(AlpSl.Cursor, TI0, {Position = UDim2.new(Alpha, 0, 0.5, 0)}):Play()
                    AlpSl.Label.Text = tostring(math.floor(Alpha * 100)) .. "%"
                    if AlphaLbl then AlphaLbl.Text = tostring(math.floor(Alpha * 100)) .. "%" end
                end

                Preview.BackgroundColor3 = CurColor
                HexBox.Text              = CurColor:ToHex():upper()

                if trigger then Callback(CurColor, 1 - Alpha) end
            end

            ApplyCP(false)

