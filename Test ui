                LayoutOrder=2, ZIndex=5, Parent=DBInner
            })

            local Menu = New("Frame", {
                Size=UDim2.fromOffset(IsMobile and 160 or 200,0),
                BackgroundColor3=Theme.Main, Visible=false, ClipsDescendants=true,
                ZIndex=6000, BorderSizePixel=0, Parent=ScreenGui
            })
