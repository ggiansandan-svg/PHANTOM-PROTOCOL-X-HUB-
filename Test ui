        Font=Enum.Font.GothamBold, TextSize=IsMobile and 7 or 8,
        TextXAlignment=Enum.TextXAlignment.Center, ZIndex=5, Parent=MainBtn
    })

    -- Lock indicator
    local LockDot = New("Frame", {
        Size=UDim2.fromOffset(14,14),
        Position=UDim2.new(1,-4,0,-4),
        BackgroundColor3=Color3.fromRGB(255,200,0),
        BorderSizePixel=0, ZIndex=6, Visible=false, Parent=MainBtn
    })
    Corner(LockDot, 7)

    -- ── State ──
    local isLocked   = false
    local isDragging = false
    local holdStart  = 0
    local holdConn   = nil
    local dragOffset = Vector2.new()

    local function SetLock(locked)
        isLocked = locked
        LockDot.Visible   = locked
        BtnStroke.Color   = locked and Color3.fromRGB(255,200,0) or Theme.Accent
        GlowImg.ImageColor3 = locked and Color3.fromRGB(255,200,0) or Theme.Accent
        Notify({
            Title = locked and "Button Locked 🔒" or "Button Unlocked 🔓",
            Content = locked and "Hold 5s to unlock." or "You can now drag.",
            Type = "Warning", Duration = 2
        })
    end

    -- Drag
    local function StartDrag(pos)
        if isLocked then return end
        isDragging = true
        local gp = GlowFrame.AbsolutePosition
        dragOffset = Vector2.new(pos.X - gp.X, pos.Y - gp.Y)
    end

    local function DoDrag(pos)
        if not isDragging or isLocked then return end
        local sc  = FBGui.AbsoluteSize
        local gsz = GlowFrame.AbsoluteSize
        local nx  = math.clamp(pos.X - dragOffset.X, 0, sc.X - gsz.X)
        local ny  = math.clamp(pos.Y - dragOffset.Y, 0, sc.Y - gsz.Y)
        GlowFrame.Position = UDim2.fromOffset(nx, ny)
    end

    -- Input
    MainBtn.InputBegan:Connect(function(inp)
        if inp.UserInputType ~= Enum.UserInputType.MouseButton1
        and inp.UserInputType ~= Enum.UserInputType.Touch then return end

        holdStart = tick()
        holdConn = RunService.RenderStepped:Connect(function()
            local progress = math.min((tick() - holdStart) / 5, 1)
            if progress >= 1 then
                if holdConn then holdConn:Disconnect(); holdConn = nil end
                SetLock(not isLocked)
            end
        end)
        if not isLocked then
            StartDrag(Vector2.new(inp.Position.X, inp.Position.Y))
        end
    end)

    MainBtn.InputEnded:Connect(function(inp)
        if inp.UserInputType ~= Enum.UserInputType.MouseButton1
        and inp.UserInputType ~= Enum.UserInputType.Touch then return end

        local elapsed = tick() - holdStart
        if holdConn then holdConn:Disconnect(); holdConn = nil end
        isDragging = false

        if elapsed < 0.3 then
            OnClick()
        end
    end)

    UserInputService.InputChanged:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseMovement
        or inp.UserInputType == Enum.UserInputType.Touch then
            DoDrag(Vector2.new(inp.Position.X, inp.Position.Y))
        end
    end)

    -- Pulse
    RunService.RenderStepped:Connect(function()
        if not isDragging and not isLocked then
            local pulse = math.sin(tick() * 2) * 0.15
            GlowImg.ImageTransparency = 0.6 + pulse
        end
    end)

    -- Theme sync
    OnTheme(function()
        GlowImg.ImageColor3      = isLocked and Color3.fromRGB(255,200,0) or Theme.Accent
        BtnStroke.Color          = isLocked and Color3.fromRGB(255,200,0) or Theme.Accent
        MainBtn.BackgroundColor3 = Theme.Main
    end)

    local FBObj = {Frame=GlowFrame, Gui=FBGui}
    function FBObj:SetLogo(img)     LogoImg.Image = img end
    function FBObj:SetTitle(t)      TitleLbl.Text = t   end
    function FBObj:SetVisible(v)    FBGui.Enabled = v   end
    function FBObj:Destroy()        FBGui:Destroy()     end
    return FBObj
end

