        local function ActivateTab()
            if Win.CurrentTab == TabObj then return end
            HomePage.Visible = false

            for _, t in ipairs(Win.Tabs) do
                if t == TabObj then continue end
                if t == Win.CurrentTab then
                    Tw(t.Canvas, {GroupTransparency=1}, TS)
                    task.delay(0.3, function()
                        if Win.CurrentTab ~= t then t.Canvas.Visible = false end
                    end)
                else
                    t.Canvas.Visible = false
                    t.Canvas.GroupTransparency = 1
                end
                if not t.IsConfig then
                    Tw(t.TabButton:FindFirstChildWhichIsA("Frame"), {BackgroundTransparency=1}, TF)
                    Tw(t.TabButton:FindFirstChildOfClass("ImageLabel"), {ImageColor3=Theme.TextSecondary}, TF)
                else
                    Tw(SaveBtn, {BackgroundColor3=Theme.Search}, TF)
                    SaveBtn.Text = "💾"
                end
            end

            Canvas.Visible = true
            Canvas.GroupTransparency = Win.CurrentTab and 1 or 0
            Tw(Canvas, {GroupTransparency=0}, TS)

            if IsConfig then
                Tw(SaveBtn, {BackgroundColor3=Theme.Accent}, TF)
            else
                Tw(TabBtnBg, {BackgroundColor3=Theme.Accent, BackgroundTransparency=0.78}, TF)
                Tw(TabBtnImg, {ImageColor3=Color3.new(1,1,1)}, TF)
                ActiveBar.BackgroundColor3 = Theme.Accent
                ActiveBar.BackgroundTransparency = 0
            end

            Win.CurrentTab = TabObj

            if SearchBox.Text == "" then
                HeaderTitle.Text = TabTitle
            else
