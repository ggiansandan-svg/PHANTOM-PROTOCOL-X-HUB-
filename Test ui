    ConfigTab:Dropdown({
        Title="Theme", Options=Library:GetThemes(),
        Default=Library.CurrentTheme,
        Callback=function(v)
            if v then Library:SetTheme(v) end
        end
    })

    ConfigTab:Section({Title="INFO"})
    ConfigTab:Paragraph({
        Title="ℹ️ About",
        Content="Protocol X Hub v"..Library.Version.."\nPress "..FormatKey(Library.ToggleKey).." to toggle GUI."
    })

    -- FIX: Save button properly opens config tab
    SaveBtn.MouseButton1Click:Connect(function()
        Win.ConfigTab:Activate()
    end)

    -- FIX: Auto-activate first non-config tab after a frame
    task.defer(function()
        for _, t in ipairs(Win.Tabs) do
            if not t.IsConfig then
                t:Activate()
                break
            end
        end
        task.delay(1, function()
            Notify({
                Title=Title,
                Content="Loaded! Press "..FormatKey(Library.ToggleKey).." to toggle.",
                Type="Success", Duration=3
            })
        end)
    end)

    return Win
end

return Library
