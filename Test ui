            Stroke(Menu, Theme.Border, 1)
            Pad(Menu, 4, 4, 4, 4)
            local MLayout = List(Menu, 2)

            local OptBtns={}
            local IsOpen=false; local RC=nil

            local function UpdateText()
                if #SelItems==0 then DropText.Text="Select..."; DropText.TextColor3=Theme.TextSecondary
                else
                    local s=table.concat(SelItems,", ")
                    if #s>18 then s=s:sub(1,15).."..." end
                    DropText.Text=s; DropText.TextColor3=Theme.TextPrimary
                end
            end

            local function CloseMenu()
                IsOpen=false
                Tw(Chevron, {Rotation=0}, TF)
                Tw(DropStroke, {Color=Theme.Border}, TF)
                Tw(Menu, {Size=UDim2.fromOffset(IsMobile and 160 or 200,0)}, TS)
                task.delay(0.3, function()
                    if not IsOpen then Menu.Visible=false if RC then RC:Disconnect() RC=nil end end
                end)
            end

            local function BuildOpts(list)
                for _,c in ipairs(Menu:GetChildren()) do
                    if c:IsA("Frame") then c:Destroy() end
                end
                table.clear(OptBtns)
                for _,opt in ipairs(list) do
                    local sel = table.find(SelItems,opt)~=nil
                    local of=New("Frame", {
                        Size=UDim2.new(1,0,0,28), BackgroundColor3=Theme.Accent,
                        BackgroundTransparency=sel and 0.8 or 1, ZIndex=6001, Parent=Menu
                    })
                    Corner(of, 5)
                    Pad(of, 0, 0, 8, 8)
                    local ol=New("TextLabel", {
                        Size=UDim2.new(1,-16,1,0), BackgroundTransparency=1, Text=opt,
                        TextColor3=sel and Theme.Accent or Theme.TextPrimary, Font=Theme.Font,
                        TextSize=IsMobile and 11 or 12, TextXAlignment=Enum.TextXAlignment.Left,
                        ZIndex=6002, Parent=of
                    })
                    local ck=New("ImageLabel", {
                        Size=UDim2.fromOffset(12,12), Position=UDim2.new(1,-14,0.5,-6),
                        BackgroundTransparency=1, Image="rbxassetid://10709790644",
                        ImageColor3=Theme.Accent, Visible=sel, ZIndex=6002, Parent=of
                    })
                    local ob=New("TextButton", {
                        Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text="", ZIndex=6003, Parent=of
                    })

                    ob.MouseEnter:Connect(function()
                        if not table.find(SelItems,opt) then Tw(of, {BackgroundTransparency=0.88}, TF) end
                    end)
                    ob.MouseLeave:Connect(function()
                        if not table.find(SelItems,opt) then Tw(of, {BackgroundTransparency=1}, TF) end
                    end)
                    ob.MouseButton1Click:Connect(function()
                        if Multi then
                            local idx=table.find(SelItems,opt)
                            if idx then
                                table.remove(SelItems,idx); ck.Visible=false
                                Tw(of, {BackgroundTransparency=1}, TF)
                                Tw(ol, {TextColor3=Theme.TextPrimary}, TF)
                            else
                                table.insert(SelItems,opt); ck.Visible=true
                                Tw(of, {BackgroundTransparency=0.8}, TF)
                                Tw(ol, {TextColor3=Theme.Accent}, TF)
                            end
                            UpdateText(); Callback(SelItems)
                        else
                            for n,r in pairs(OptBtns) do
                                r.ck.Visible=false
                                Tw(r.f, {BackgroundTransparency=1}, TF)
                                Tw(r.l, {TextColor3=Theme.TextPrimary}, TF)
                            end
                            table.clear(SelItems); table.insert(SelItems,opt)
                            ck.Visible=true
                            Tw(of, {BackgroundTransparency=0.8}, TF)
                            Tw(ol, {TextColor3=Theme.Accent}, TF)
                            UpdateText(); Callback(SelItems[1]); CloseMenu()
                        end
                    end)
                    OptBtns[opt]={f=of,l=ol,ck=ck}
                end
            end

            BuildOpts(Options); UpdateText()

            local function OpenMenu()
                IsOpen=true
                Tw(Chevron, {Rotation=180}, TF)
                Tw(DropStroke, {Color=Theme.Accent}, TF)
                local function updPos()
                    local bp=DropBtn.AbsolutePosition; local bs=DropBtn.AbsoluteSize; local sc=ScreenGui.AbsoluteSize
                    local mW=IsMobile and 160 or 200
                    local tH=math.min(MLayout.AbsoluteContentSize.Y+10, 200)
                    local x=bp.X; local y=bp.Y+bs.Y+4
                    if y+tH>sc.Y-10 then y=bp.Y-tH-4 end
                    if x+mW>sc.X then x=sc.X-mW-4 end; if x<4 then x=4 end
                    Menu.Position=UDim2.fromOffset(x,y)
                end
                updPos(); Menu.Visible=true
                Tw(Menu, {Size=UDim2.fromOffset(IsMobile and 160 or 200, math.min(MLayout.AbsoluteContentSize.Y+10,200))}, TS)
                RC=RunService.RenderStepped:Connect(updPos)
            end

            DropBtn.MouseButton1Click:Connect(function() if IsOpen then CloseMenu() else OpenMenu() end end)

            UserInputService.InputBegan:Connect(function(i)
                if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
                if not IsOpen then return end
                local mp=Vector2.new(i.Position.X,i.Position.Y)
                local mp_=Menu.AbsolutePosition; local ms=Menu.AbsoluteSize
                local bp=DropBtn.AbsolutePosition; local bs=DropBtn.AbsoluteSize
                local inM=mp.X>=mp_.X and mp.X<=mp_.X+ms.X and mp.Y>=mp_.Y and mp.Y<=mp_.Y+ms.Y
                local inB=mp.X>=bp.X  and mp.X<=bp.X+bs.X  and mp.Y>=bp.Y  and mp.Y<=bp.Y+bs.Y
                if not inM and not inB then CloseMenu() end
            end)

            OnTheme(function()
                TLbl.TextColor3=Theme.TextPrimary
                DropBtn.BackgroundColor3=Theme.Search; DropStroke.Color=Theme.Border
                Menu.BackgroundColor3=Theme.Main; UpdateText()
                for _,r in pairs(OptBtns) do
                    r.f.BackgroundColor3=Theme.Accent
                    r.l.Font=Theme.Font
                    r.ck.ImageColor3=Theme.Accent
                end
            end)

            table.insert(Win.Popups, {Close=CloseMenu})

            local obj={}
            function obj:GetComponentType() return "Dropdown" end
            function obj:GetValue()         return Multi and SelItems or SelItems[1] end
            function obj:SetValue(val)
                table.clear(SelItems)
                if Multi then if type(val)=="table" then for _,v in ipairs(val) do table.insert(SelItems,v) end end
                else if val then table.insert(SelItems,val) end end
                for n,r in pairs(OptBtns) do
                    local s=table.find(SelItems,n)~=nil
                    r.ck.Visible=s
                    Tw(r.f, {BackgroundTransparency=s and 0.8 or 1}, TF)
                    Tw(r.l, {TextColor3=s and Theme.Accent or Theme.TextPrimary}, TF)
                end
                UpdateText(); Callback(Multi and SelItems or SelItems[1])
            end
            function obj:SetOptions(list) Options=list BuildOpts(list) UpdateText() end
            function obj:AddOption(opt)
                if not table.find(Options,opt) then table.insert(Options,opt) BuildOpts(Options) end
            end
            function obj:RemoveOption(opt)
                local i=table.find(Options,opt)
                if i then table.remove(Options,i) BuildOpts(Options)
                    local si=table.find(SelItems,opt) if si then table.remove(SelItems,si) UpdateText() end end
            end
            function obj:GetOptions() return Options end
            function obj:Open()  OpenMenu()  end
            function obj:Close() CloseMenu() end
            function obj:Clear() obj:SetValue(Multi and {} or nil) end
            Library.Flags[FlagName]=obj
            return obj
        end

