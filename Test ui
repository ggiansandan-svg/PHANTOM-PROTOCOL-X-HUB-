            wf.Size = UDim2.fromOffset(w+20, 26)
        end
        function wmO:UpdatePosition()
            local mp = Main.AbsolutePosition
            local ms = Main.AbsoluteSize
            local ws_ = wf.AbsoluteSize
            local pd = 6
            local posTbl
            if Win.Visible then
                posTbl = {
                    TopLeft    = {UDim2.fromOffset(mp.X, mp.Y-ws_.Y-pd), Vector2.new(0,0)},
                    TopRight   = {UDim2.fromOffset(mp.X+ms.X, mp.Y-ws_.Y-pd), Vector2.new(1,0)},
                    BottomLeft = {UDim2.fromOffset(mp.X, mp.Y+ms.Y+pd), Vector2.new(0,0)},
                    BottomRight= {UDim2.fromOffset(mp.X+ms.X, mp.Y+ms.Y+pd), Vector2.new(1,0)},
                }
            else
