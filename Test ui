            local H2 = nil
            if Dual then
                H2 = New("Frame", {
                    Size=UDim2.fromOffset(CircSz,CircSz),
                    AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.new(1,0,0.5,0),
                    BackgroundColor3=Color3.new(1,1,1), BorderSizePixel=0, ZIndex=7, Parent=Track
                })
                Corner(H2, CircSz/2)
                Stroke(H2, Theme.Accent, 2)
            end

            OnTheme(function()
                TLbl.TextColor3 = Theme.TextPrimary; ValLbl.TextColor3 = Theme.Accent
                Track.BackgroundColor3 = Theme.Border; Fill.BackgroundColor3 = Theme.Accent
                Stroke(H1, Theme.Accent, 2); if H2 then Stroke(H2, Theme.Accent, 2) end
            end)

            local function Fmt(v)
                return Prefix..string.format("%."..Decimal.."f",v)..Suffix
            end
            local function SnapV(v)
                if not Step or Step<=0 then return v end
                return math.clamp(math.round((v-Min)/Step)*Step+Min, Min, Max)
            end
            local function UpdVis(v)
                if Dual then
                    local a1 = math.clamp((v[1]-Min)/(Max-Min),0,1)
                    local a2 = math.clamp((v[2]-Min)/(Max-Min),0,1)
                    Tw(Fill, {Position=UDim2.new(a1,0,0,0), Size=UDim2.new(a2-a1,0,1,0)}, T0)
                    Tw(H1, {Position=UDim2.new(a1,0,0.5,0)}, T0)
                    if H2 then Tw(H2, {Position=UDim2.new(a2,0,0.5,0)}, T0) end
                    ValLbl.Text = Fmt(v[1]).." – "..Fmt(v[2])
                else
                    local a = math.clamp((v-Min)/(Max-Min),0,1)
                    Tw(Fill, {Size=UDim2.new(a,0,1,0)}, T0)
                    Tw(H1, {Position=UDim2.new(a,0,0.5,0)}, T0)
                    ValLbl.Text = Fmt(v)
                end
            end
            local function SetVal(v, fire)
                if Dual then
                    CurVal = {math.clamp(SnapV(v[1] or Min),Min,Max), math.clamp(SnapV(v[2] or Max),Min,Max)}
                    if CurVal[1]>CurVal[2] then CurVal[1]=CurVal[2] end
                else
                    CurVal = math.clamp(SnapV(v),Min,Max)
                end
                UpdVis(CurVal)
                if fire then Callback(CurVal) end
            end

            local drag=false; local ah=1
            local function DoDrag(inp)
                local rel = math.clamp((inp.Position.X-Track.AbsolutePosition.X)/Track.AbsoluteSize.X,0,1)
                local sv  = SnapV(Min+rel*(Max-Min))
                if Dual then
                    local nv = {CurVal[1],CurVal[2]}; nv[ah]=sv
                    if ah==1 and nv[1]>nv[2] then nv[1]=nv[2] elseif ah==2 and nv[2]<nv[1] then nv[2]=nv[1] end
                    CurVal=nv
                else CurVal=sv end
                UpdVis(CurVal); Callback(CurVal)
            end

            TrackBtn.InputBegan:Connect(function(i)
                if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
                    drag=true
                    if Dual then
                        local rel=math.clamp((i.Position.X-Track.AbsolutePosition.X)/Track.AbsoluteSize.X,0,1)
                        local a1=(CurVal[1]-Min)/(Max-Min); local a2=(CurVal[2]-Min)/(Max-Min)
                        ah=math.abs(rel-a1)<=math.abs(rel-a2) and 1 or 2
                    end
                    DoDrag(i)
                    Tw((Dual and ah==2) and H2 or H1, {Size=UDim2.fromOffset(CircSz+3,CircSz+3)}, TF)
                end
            end)
            UserInputService.InputEnded:Connect(function(i)
                if (i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch) and drag then
                    drag=false
                    Tw((Dual and ah==2) and H2 or H1, {Size=UDim2.fromOffset(CircSz,CircSz)}, TF)
                end
            end)
            UserInputService.InputChanged:Connect(function(i)
                if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then DoDrag(i) end
            end)

            SetVal(CurVal, false)

            local obj={}
            function obj:GetComponentType() return "Slider" end
            function obj:GetValue()         return CurVal    end
            function obj:SetValue(v)        SetVal(v,true)   end
            function obj:SetMin(v)          Min=v SetVal(CurVal,true) end
            function obj:SetMax(v)          Max=v SetVal(CurVal,true) end
            Library.Flags[FlagName]=obj
            return obj
        end

