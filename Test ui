local Library = {
    ToggleKey    = Enum.KeyCode.RightControl,
    Flags        = {},
    CurrentTheme = "GitHub Dark",
    Version      = "3.1.0",
}

local Theme     = Themes["GitHub Dark"]
local ThemeCBs  = {}

local function OnTheme(fn) table.insert(ThemeCBs, fn) end
local function FireTheme() for _, fn in ipairs(ThemeCBs) do task.spawn(fn) end end

function Library:SetTheme(name)
    if not Themes[name] then return end
    Theme = Themes[name]
    self.CurrentTheme = name
    FireTheme()
end

function Library:GetThemes()
    local t = {}
    for k in pairs(Themes) do table.insert(t, k) end
    table.sort(t)
    return t
end

function Library:SetWindowKeybind(k) self.ToggleKey = k end

