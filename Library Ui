    -- ── State ──
    local isLocked   = false
    local isDragging = false
    local holdTimer  = nil
    local holdStart  = 0
    local dragOffset = Vector2.new()

    -- Progress ring for hold (visual feedback)
    local HoldRing = New("Frame",{
        Size=UDim2.new(1,8,1,8),
        Position=UDim2.new(0,-4,0,-4),
        BackgroundTransparency=1,
        ZIndex=8,
        Parent=MainBtn,
    })
    local RingLabel = New("TextLabel",{
        Size=UDim2.new(1,0,1,0),
        BackgroundTransparency=1,
        Text="",
        TextColor3=Theme.Accent,
        Font=Enum.Font.GothamBold,
        TextSize=14,
        ZIndex=9,
        Parent=HoldRing,
    })

    local function SetLock(locked)
        isLocked = locked
        LockIndicator.Visible = locked
        BtnStroke.Color = locked and Color3.fromRGB(255,200,0) or Theme.Accent
        GlowImg.ImageColor3 = locked and Color3.fromRGB(255,200,0) or Theme.Accent
        AccentBar.BackgroundColor3 = locked and Color3.fromRGB(255,200,0) or Theme.Accent

        if locked then
            Notify({Title="Button Locked 🔒",Content="Hold 5 seconds to unlock.",Type="Warning",Duration=2})
        else
            Notify({Title="Button Unlocked 🔓",Content="You can now drag the button.",Type="Info",Duration=2})
        end
    end

    -- ── Drag Logic ──
    local function StartDrag(inputPos)
        if isLocked then return end
        isDragging = true
        local gfPos = GlowFrame.AbsolutePosition
        dragOffset = Vector2.new(
            inputPos.X - gfPos.X,
            inputPos.Y - gfPos.Y
        )
    end

    local function DoDrag(inputPos)
        if not isDragging or isLocked then return end
        local sc = FBGui.AbsoluteSize
        local gfSz = GlowFrame.AbsoluteSize
        local nx = math.clamp(inputPos.X - dragOffset.X, 0, sc.X - gfSz.X)
        local ny = math.clamp(inputPos.Y - dragOffset.Y, 0, sc.Y - gfSz.Y)
        GlowFrame.Position = UDim2.fromOffset(nx, ny)
    end

    local function StopDrag()
        isDragging = false
    end

    -- Hold timer for lock/unlock
    local holdProgress = 0
    local holdConn = nil

    MainBtn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            holdStart = tick()
            holdProgress = 0

            holdConn = RunService.RenderStepped:Connect(function(dt)
                holdProgress = math.min((tick() - holdStart) / 5, 1)
                local pct = math.floor(holdProgress * 100)

                -- Visual ring
                if holdProgress > 0.05 then
                    RingLabel.Text = pct < 100 and (pct.."%") or (isLocked and "🔓" or "🔒")
                    RingLabel.TextColor3 = holdProgress < 1
                        and Color3.fromRGB(255,200,0)
                        or  (isLocked and Color3.fromRGB(0,255,120) or Color3.fromRGB(255,200,0))
                else
                    RingLabel.Text = ""
                end

                Tw(MainBtn,{
                    BackgroundColor3 = holdProgress > 0 and Theme.Search or Theme.Main
                }, TweenInfo.new(0.1))

                if holdProgress >= 1 then
                    if holdConn then holdConn:Disconnect(); holdConn=nil end
                    RingLabel.Text = ""
                    holdProgress   = 0
                    SetLock(not isLocked)
                end
            end)

            if not isLocked then
                StartDrag(Vector2.new(inp.Position.X, inp.Position.Y))
            end
        end
    end)

    MainBtn.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            local elapsed = tick() - holdStart

            -- Cancel hold timer
            if holdConn then holdConn:Disconnect(); holdConn=nil end
            RingLabel.Text = ""
            holdProgress   = 0
            Tw(MainBtn,{BackgroundColor3=Theme.Main},TF)

            StopDrag()

            -- Quick tap = toggle GUI
            if elapsed < 0.3 then
                OnClick()
            end
        end
    end)

    UserInputService.InputChanged:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseMovement
        or inp.UserInputType == Enum.UserInputType.Touch then
            DoDrag(Vector2.new(inp.Position.X, inp.Position.Y))
        end
    end)

    -- Pulse animation
    local pulseUp = true
    RunService.RenderStepped:Connect(function(dt)
        if not isDragging and not isLocked then
            local t = tick()
            local pulse = math.sin(t*2) * 0.15
            GlowImg.ImageTransparency = 0.5 + pulse
        end
    end)

    -- Theme sync
    OnTheme(function()
        GlowImg.ImageColor3  = isLocked and Color3.fromRGB(255,200,0) or Theme.Accent
        BtnStroke.Color      = isLocked and Color3.fromRGB(255,200,0) or Theme.Accent
        MainBtn.BackgroundColor3 = Theme.Main
        AccentBar.BackgroundColor3 = isLocked and Color3.fromRGB(255,200,0) or Theme.Accent
    end)

    local FBObj = {Frame = GlowFrame, Gui = FBGui}
    function FBObj:SetLogo(img) LogoImg.Image = img end
    function FBObj:SetTitle(t) TitleUnder.Text = t end
    function FBObj:SetVisible(v) FBGui.Enabled = v end
    function FBObj:Destroy() FBGui:Destroy() end

    OnReady(FBObj)
    return FBObj
end

