        return {Get=function() return v end}
    end

    function M:Destroy() g:Destroy() end

    -- Animate in
    fr.GroupTransparency = 1
    Tw(fr, {GroupTransparency=0, Size=UDim2.new(0,W,0,H)}, TM)
    return M
end

