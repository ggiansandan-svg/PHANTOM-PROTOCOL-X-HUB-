        function TabObj:Slider(sOpts)
            local compTitle=sOpts.Title or "Slider"
            local Min=sOpts.Min or 0
            local Max=sOpts.Max or 100
            local Decimal=sOpts.Decimal or 0
            local Suffix=sOpts.Suffix or ""
            local Step=sOpts.Step
            local Dual=sOpts.Dual or false
            local Callback=sOpts.Callback or function() end
            local FlagName=sOpts.Flag or (TabObj.Title.."/"..compTitle)

            local CurVal
            if Dual then
                CurVal=type(sOpts.Default)=="table" and {math.clamp(sOpts.Default[1] or Min,Min,Max),math.clamp(sOpts.Default[2] or Max,Min,Max)} or {Min,Max}
            else
                CurVal=math.clamp(sOpts.Default or Min,Min,Max)
            end

            local Row=CreateRow(compTitle)
            local TLbl=New("TextLabel",{Size=UDim2.new(0, IsMobile and 100 or 130, 1, 0),Position=UDim2.new(0,4,0,0),BackgroundTransparency=1,Text=compTitle,TextColor3=Theme.TextPrimary,Font=Theme.Font,TextSize=SIZE.Body,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=5,Parent=Row})
            local ValLbl=New("TextLabel",{Size=UDim2.new(0, IsMobile and 60 or 80, 1, 0),Position=UDim2.new(1,-160,0,0),BackgroundTransparency=1,Text="",TextColor3=Theme.Accent,Font=Enum.Font.Code,TextSize=SIZE.Small,TextXAlignment=Enum.TextXAlignment.Right,ZIndex=5,Parent=Row})

            local TrackOuter=New("TextButton",{Size=UDim2.new(0, IsMobile and 100 or 140, 0, 16),Position=UDim2.new(1, IsMobile and -108 or -148, 0.5, -8),BackgroundTransparency=1,Text="",AutoButtonColor=false,ZIndex=5,Parent=Row})
            local Track=New("Frame",{Size=UDim2.new(1,0,0,4),Position=UDim2.new(0,0,0.5,-2),BackgroundColor3=Theme.Border,BorderSizePixel=0,ZIndex=5,Parent=TrackOuter})
            Corner(Track,2)
            local Fill=New("Frame",{BackgroundColor3=Theme.Accent,BorderSizePixel=0,ZIndex=6,Parent=Track})
            Corner(Fill,2)
            local H1=New("Frame",{Size=UDim2.new(0,12,0,12),AnchorPoint=Vector2.new(0.5,0.5),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=7,Parent=Track})
            Corner(H1,6); Stroke(H1,Theme.Accent,2)
            local H2=nil
            if Dual then
                H2=New("Frame",{Size=UDim2.new(0,12,0,12),AnchorPoint=Vector2.new(0.5,0.5),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=7,Parent=Track})
                Corner(H2,6); Stroke(H2,Theme.Accent,2)
            end

            local function Fmt(v)
                local s=Decimal>0 and string.format("%."..Decimal.."f",v) or tostring(math.floor(v))
                return s..Suffix
            end
            local function Snap(v) if not Step or Step<=0 then return v end return math.clamp(math.round((v-Min)/Step)*Step+Min,Min,Max) end
            local function UpdVis(val)
                if Dual then
                    local a1=math.clamp((val[1]-Min)/(Max-Min),0,1)
                    local a2=math.clamp((val[2]-Min)/(Max-Min),0,1)
                    Tw(Fill,{Position=UDim2.new(a1,0,0,0),Size=UDim2.new(a2-a1,0,1,0)},T0)
                    Tw(H1,{Position=UDim2.new(a1,0,0.5,0)},T0)
                    if H2 then Tw(H2,{Position=UDim2.new(a2,0,0.5,0)},T0) end
                    ValLbl.Text=Fmt(val[1]).."-"..Fmt(val[2])
                else
                    local a=math.clamp((val-Min)/(Max-Min),0,1)
                    Tw(Fill,{Position=UDim2.new(0,0,0,0),Size=UDim2.new(a,0,1,0)},T0)
                    Tw(H1,{Position=UDim2.new(a,0,0.5,0)},T0)
                    ValLbl.Text=Fmt(val)
                end
            end
            local function SetValue(val,fire)
                if Dual then
                    CurVal={math.clamp(Snap(val[1] or Min),Min,Max),math.clamp(Snap(val[2] or Max),Min,Max)}
                    if CurVal[1]>CurVal[2] then CurVal[1]=CurVal[2] end
                else CurVal=math.clamp(Snap(val),Min,Max) end
                UpdVis(CurVal)
                if fire then Callback(CurVal) end
            end

            local drag=false; local ah=1
            local function DoDrag(inp)
                local rel=math.clamp((inp.Position.X-Track.AbsolutePosition.X)/Track.AbsoluteSize.X,0,1)
                local raw=Min+rel*(Max-Min)
                local snapped=Snap(raw)
                if Dual then
                    local nv={CurVal[1],CurVal[2]}
                    nv[ah]=snapped
                    if ah==1 and nv[1]>nv[2] then nv[1]=nv[2]
                    elseif ah==2 and nv[2]<nv[1] then nv[2]=nv[1] end
                    CurVal=nv
                else CurVal=snapped end
                UpdVis(CurVal); Callback(CurVal)
            end

            TrackOuter.InputBegan:Connect(function(i)
                if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
                drag=true
                if Dual then
                    local rel=math.clamp((i.Position.X-Track.AbsolutePosition.X)/Track.AbsoluteSize.X,0,1)
                    local a1=(CurVal[1]-Min)/(Max-Min); local a2=(CurVal[2]-Min)/(Max-Min)
                    ah=math.abs(rel-a1)<=math.abs(rel-a2) and 1 or 2
                end
                DoDrag(i)
            end)
            UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end end)
            UserInputService.InputChanged:Connect(function(i) if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then DoDrag(i) end end)

            OnTheme(function() TLbl.TextColor3=Theme.TextPrimary ValLbl.TextColor3=Theme.Accent Track.BackgroundColor3=Theme.Border Fill.BackgroundColor3=Theme.Accent Stroke(H1,Theme.Accent,2) if H2 then Stroke(H2,Theme.Accent,2) end end)

            SetValue(CurVal,false)
            local obj={}
            function obj:GetComponentType() return "Slider" end
            function obj:GetValue() return CurVal end
            function obj:SetValue(v) SetValue(v,true) end
            Library.Flags[FlagName]=obj
            return obj
        end

