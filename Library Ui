        New("UIGradient",{Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.1,0),NumberSequenceKeypoint.new(0.9,0),NumberSequenceKeypoint.new(1,1)}),Parent=wf:FindFirstChildOfClass("Frame")})

        local wTxt=New("TextLabel",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text=initText or "",RichText=true,TextColor3=Theme.TextPrimary,Font=Enum.Font.Code,TextSize=IsMobile and 10 or 11,ZIndex=9502,Parent=wf})
