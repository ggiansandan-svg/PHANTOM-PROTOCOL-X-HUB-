        --// ── SLIDER ──
        function TabObj:Slider(sOpts)
            local compTitle =sOpts.Title     or "Slider"
            local Min       =sOpts.Min       or 0
            local Max       =sOpts.Max       or 100
            local Decimal   =sOpts.Decimal   or 0
            local Suffix    =sOpts.Suffix    or ""
            local Prefix    =sOpts.Prefix    or ""
            local Dual      =sOpts.Dual      or false
            local Step      =sOpts.Step      or nil
            local ZeroNum   =sOpts.ZeroNumber or Min
            local Callback  =sOpts.Callback  or function() end
            local FlagName  =sOpts.Flag      or (TabObj.Title.."/"..compTitle)

            local CurVal
            if Dual then
                CurVal=type(sOpts.Default)=="table" and {math.clamp(sOpts.Default[1] or Min,Min,Max),math.clamp(sOpts.Default[2] or Max,Min,Max)} or {Min,Max}
            else
                CurVal=math.clamp(sOpts.Default or Min,Min,Max)
            end

            local Row=CreateRow(compTitle)

            local TLbl=New("TextLabel",{Size=UDim2.new(0,160,1,0),Position=UDim2.new(0,8,0,0),BackgroundTransparency=1,Text=compTitle,TextColor3=Theme.TextPrimary,Font=Theme.Font,TextSize=14,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=5,Parent=Row})
            local ValLbl=New("TextLabel",{Size=UDim2.new(0,100,1,0),Position=UDim2.new(1,-290,0,0),BackgroundTransparency=1,Text="",TextColor3=Theme.Accent,Font=Enum.Font.Code,TextSize=12,TextXAlignment=Enum.TextXAlignment.Right,ZIndex=5,Parent=Row})

            local TrackOuter=New("TextButton",{Size=UDim2.new(0,175,0,20),Position=UDim2.new(1,-183,0.5,-10),BackgroundTransparency=1,Text="",AutoButtonColor=false,ZIndex=5,Parent=Row})
            local Track=New("Frame",{Size=UDim2.new(1,0,0,5),Position=UDim2.new(0,0,0.5,-2.5),BackgroundColor3=Theme.Border,BorderSizePixel=0,ZIndex=5,Parent=TrackOuter})
            Corner(Track,3)
            local Fill=New("Frame",{BackgroundColor3=Theme.Accent,BorderSizePixel=0,ZIndex=6,Parent=Track})
            Corner(Fill,3)
            New("UIGradient",{Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.2),NumberSequenceKeypoint.new(0.5,0),NumberSequenceKeypoint.new(1,0.2)}),Parent=Fill})

            local H1=New("Frame",{Size=UDim2.new(0,14,0,14),AnchorPoint=Vector2.new(0.5,0.5),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=7,Parent=Track})
            Corner(H1,7); Stroke(H1,Theme.Accent,2)

            local H2=nil
            if Dual then
                H2=New("Frame",{Size=UDim2.new(0,14,0,14),AnchorPoint=Vector2.new(0.5,0.5),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=7,Parent=Track})
                Corner(H2,7); Stroke(H2,Theme.Accent,2)
            end

            local TipF=New("Frame",{Size=UDim2.new(0,50,0,22),AnchorPoint=Vector2.new(0.5,1),BackgroundColor3=Theme.Sidebar,Visible=false,ZIndex=100,Parent=Track})
            Corner(TipF,4); Stroke(TipF,Theme.Border,1)
            local TipL=New("TextLabel",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="",TextColor3=Theme.TextPrimary,Font=Enum.Font.Code,TextSize=11,ZIndex=101,Parent=TipF})

            local ZeroAlpha=math.clamp((ZeroNum-Min)/(Max-Min),0,1)

            local function Fmt(v)
                local s=Decimal>0 and string.format("%."..Decimal.."f",v) or tostring(math.floor(v))
                return Prefix..s..Suffix
            end
            local function Snap(v)
                if not Step or Step<=0 then return v end
                return math.clamp(math.round((v-Min)/Step)*Step+Min,Min,Max)
            end
            local function UpdateVis(val)
                if Dual then
                    local a1=math.clamp((val[1]-Min)/(Max-Min),0,1)
                    local a2=math.clamp((val[2]-Min)/(Max-Min),0,1)
                    Tw(Fill,{Position=UDim2.new(a1,0,0,0),Size=UDim2.new(a2-a1,0,1,0)},T0)
                    Tw(H1,{Position=UDim2.new(a1,0,0.5,0)},T0)
                    if H2 then Tw(H2,{Position=UDim2.new(a2,0,0.5,0)},T0) end
                    ValLbl.Text=Fmt(val[1]).." – "..Fmt(val[2])
                else
                    local a=math.clamp((val-Min)/(Max-Min),0,1)
                    local s=math.min(a,ZeroAlpha); local sz=math.abs(a-ZeroAlpha)
                    Tw(Fill,{Position=UDim2.new(s,0,0,0),Size=UDim2.new(sz,0,1,0)},T0)
                    Tw(H1,{Position=UDim2.new(a,0,0.5,0)},T0)
                    ValLbl.Text=Fmt(val)
                    TipF.Position=UDim2.new(a,0,0,-5)
                    TipL.Text=Fmt(val)
                end
            end
            local function SetValue(val,fire)
                if Dual then
                    CurVal={math.clamp(Snap(val[1] or Min),Min,Max),math.clamp(Snap(val[2] or Max),Min,Max)}
                    if CurVal[1]>CurVal[2] then CurVal[1]=CurVal[2] end
                else
                    CurVal=math.clamp(Snap(val),Min,Max)
                end
                UpdateVis(CurVal)
                if fire then Callback(CurVal) end
            end

            local drag=false; local ah=1
            local function DoDrag(inp)
                local rel=math.clamp((inp.Position.X-Track.AbsolutePosition.X)/Track.AbsoluteSize.X,0,1)
                local raw=Min+rel*(Max-Min)
                local snapped=Snap(raw)
                if Dual then
                    local nv={CurVal[1],CurVal[2]}
                    nv[ah]=snapped
                    if ah==1 and nv[1]>nv[2] then nv[1]=nv[2] elseif ah==2 and nv[2]<nv[1] then nv[2]=nv[1] end
                    CurVal=nv
                else CurVal=snapped end
                UpdateVis(CurVal); Callback(CurVal)
                if not Dual then TipF.Visible=true end
            end

            TrackOuter.InputBegan:Connect(function(i)
                if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
                drag=true
                if Dual then
                    local rel=math.clamp((i.Position.X-Track.AbsolutePosition.X)/Track.AbsoluteSize.X,0,1)
                    local a1=(CurVal[1]-Min)/(Max-Min); local a2=(CurVal[2]-Min)/(Max-Min)
                    ah=math.abs(rel-a1)<=math.abs(rel-a2) and 1 or 2
                end
                DoDrag(i)
                local h=(Dual and ah==2) and H2 or H1
                if h then Tw(h,{Size=UDim2.new(0,18,0,18)},TF) end
            end)
            UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
                if drag then
                    drag=false; TipF.Visible=false
                    local h=(Dual and ah==2) and H2 or H1
                    if h then Tw(h,{Size=UDim2.new(0,14,0,14)},TF) end
                end
            end)
            UserInputService.InputChanged:Connect(function(i)
                if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then DoDrag(i) end
            end)

            OnTheme(function()
                TLbl.TextColor3=Theme.TextPrimary; ValLbl.TextColor3=Theme.Accent
                Track.BackgroundColor3=Theme.Border; Fill.BackgroundColor3=Theme.Accent
                Stroke(H1,Theme.Accent,2); if H2 then Stroke(H2,Theme.Accent,2) end
                TipF.BackgroundColor3=Theme.Sidebar; TipL.TextColor3=Theme.TextPrimary
            end)

            SetValue(CurVal,false)

            local obj={}
            function obj:GetComponentType() return "Slider" end
            function obj:GetValue() return CurVal end
            function obj:SetValue(v) SetValue(v,true) end
            function obj:SetMin(v) Min=v SetValue(CurVal,true) end
            function obj:SetMax(v) Max=v SetValue(CurVal,true) end
            Library.Flags[FlagName]=obj
            return obj
        end

