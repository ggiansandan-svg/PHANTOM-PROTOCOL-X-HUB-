        local lbl=New("TextLabel",{Size=UDim2.new(1,-60,1,0),BackgroundTransparency=1,Text=tTitle,TextColor3=Theme.TextPrimary,Font=Theme.Font,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=3,Parent=row})

        -- FIXED TOGGLE DESIGN
        local togBg=New("Frame",{
            Size=UDim2.new(0,44,0,24),
            Position=UDim2.new(1,-50,0.5,-12),
            BackgroundColor3=state and Theme.ToggleOn or Theme.ToggleOff,
            BorderSizePixel=0,
            ZIndex=3,
            Parent=row,
        })
        Corner(togBg,12)

        local togCircle=New("Frame",{
            Size=UDim2.new(0,18,0,18),
            Position=state and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9),
            BackgroundColor3=Color3.new(1,1,1),
            BorderSizePixel=0,
            ZIndex=4,
            Parent=togBg,
        })
        Corner(togCircle,9)
        Stroke(togCircle,Color3.fromRGB(200,200,200),1)

        local togBtn=New("TextButton",{
            Size=UDim2.new(1,0,1,0),
            BackgroundTransparency=1,
            Text="",
            ZIndex=5,
            Parent=togBg,
        })

        local function SetTog(s,fire)
            state=s
            Tw(togBg,{BackgroundColor3=s and Theme.ToggleOn or Theme.ToggleOff},TF)
            Tw(togCircle,{Position=s and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9)},TF)
            if fire and cb then cb(state) end
        end

        togBtn.MouseButton1Click:Connect(function() SetTog(not state,true) end)

        OnTheme(function()
            lbl.TextColor3=Theme.TextPrimary
            Tw(togBg,{BackgroundColor3=state and Theme.ToggleOn or Theme.ToggleOff},TF)
        end)

        return {GetValue=function() return state end,SetValue=function(v) SetTog(v,true) end}
    end

    function MObj:Slider(sTitle,min,max,default,cb)
        local curVal=math.clamp(default or min,min,max)
        local row=New("Frame",{Size=UDim2.new(1,0,0,50),BackgroundTransparency=1,ZIndex=3,Parent=Content})

        local top=New("Frame",{Size=UDim2.new(1,0,0,18),BackgroundTransparency=1,ZIndex=3,Parent=row})
        List(top,4,Enum.FillDirection.Horizontal,Enum.HorizontalAlignment.Left,Enum.VerticalAlignment.Center)
        New("TextLabel",{Size=UDim2.new(1,-40,1,0),BackgroundTransparency=1,Text=sTitle,TextColor3=Theme.TextPrimary,Font=Theme.Font,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=1,ZIndex=3,Parent=top})
        local valL=New("TextLabel",{Size=UDim2.new(0,36,1,0),BackgroundTransparency=1,Text=tostring(curVal),TextColor3=Theme.Accent,Font=Enum.Font.Code,TextSize=12,TextXAlignment=Enum.TextXAlignment.Right,LayoutOrder=2,ZIndex=3,Parent=top})

        local track=New("TextButton",{Size=UDim2.new(1,0,0,6),Position=UDim2.new(0,0,0,26),BackgroundColor3=Theme.Search,Text="",AutoButtonColor=false,BorderSizePixel=0,ZIndex=3,Parent=row})
        Corner(track,3)
        local fill=New("Frame",{Size=UDim2.new((curVal-min)/(max-min),0,1,0),BackgroundColor3=Theme.Accent,BorderSizePixel=0,ZIndex=4,Parent=track})
        Corner(fill,3)
        local handle=New("Frame",{Size=UDim2.new(0,14,0,14),Position=UDim2.new((curVal-min)/(max-min),0,0.5,-7),AnchorPoint=Vector2.new(0.5,0.5),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=5,Parent=track})
        Corner(handle,7)
        Stroke(handle,Theme.Accent,2)

        local drag=false
        local function drag_fn(inp)
            local rel=math.clamp((inp.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
            curVal=math.floor(min+rel*(max-min))
            Tw(fill,{Size=UDim2.new(rel,0,1,0)},T0)
            Tw(handle,{Position=UDim2.new(rel,0,0.5,-7)},T0)
            valL.Text=tostring(curVal)
            if cb then cb(curVal) end
        end
        track.InputBegan:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=true drag_fn(i) end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then drag_fn(i) end
        end)

        OnTheme(function()
            track.BackgroundColor3=Theme.Search
            fill.BackgroundColor3=Theme.Accent
            Stroke(handle,Theme.Accent,2)
        end)

        return {GetValue=function() return curVal end}
    end

    function MObj:Resize(w,h)
        origH=h
        Tw(MFrame,{Size=UDim2.new(0,w,0,minimized and 32 or h)},TS)
    end

    function MObj:SetVisible(v)
        Tw(MFrame,{GroupTransparency=v and 0 or 1},TS)
        task.delay(0.3,function() MFrame.Visible=v end)
    end

    function MObj:Destroy()
        MGui:Destroy()
    end

    return MObj
end

