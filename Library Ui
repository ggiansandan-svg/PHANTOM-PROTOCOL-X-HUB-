    function MObj:Button(bTitle,cb)
        local bf=New("TextButton",{Size=UDim2.new(1,0,0,SIZE.BtnH),BackgroundColor3=Theme.Accent,Text=bTitle,TextColor3=Theme.Main,Font=Enum.Font.GothamBold,TextSize=SIZE.Body,AutoButtonColor=false,ZIndex=3,Parent=Content})
        Corner(bf,6)
        bf.MouseButton1Click:Connect(function()
            Tw(bf,{BackgroundColor3=Theme.Search},TF)
            task.delay(0.15,function() Tw(bf,{BackgroundColor3=Theme.Accent},TF) end)
            if cb then cb() end
        end)
        OnTheme(function() bf.BackgroundColor3=Theme.Accent bf.TextColor3=Theme.Main end)
        return bf
    end

    function MObj:Toggle(tTitle,default,cb)
        local state=default or false
        local row=New("Frame",{Size=UDim2.new(1,0,0,32),BackgroundTransparency=1,ZIndex=3,Parent=Content})

        local lbl=New("TextLabel",{Size=UDim2.new(1,-52,1,0),BackgroundTransparency=1,Text=tTitle,TextColor3=Theme.TextPrimary,Font=Theme.Font,TextSize=SIZE.Body,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=3,Parent=row})

        local togBg=New("Frame",{
            Size=UDim2.new(0, SIZE.ToggleW, 0, SIZE.ToggleH),
            Position=UDim2.new(1, -SIZE.ToggleW-4, 0.5, -SIZE.ToggleH/2),
            BackgroundColor3=state and Theme.ToggleOn or Theme.ToggleOff,
            BorderSizePixel=0,
            ZIndex=3,
            Parent=row,
        })
        Corner(togBg, SIZE.ToggleH/2)

        local togCircle=New("Frame",{
            Size=UDim2.new(0, SIZE.ToggleCircle, 0, SIZE.ToggleCircle),
            Position=state and UDim2.new(1, -SIZE.ToggleCircle-3, 0.5, -SIZE.ToggleCircle/2) or UDim2.new(0, 3, 0.5, -SIZE.ToggleCircle/2),
            BackgroundColor3=Color3.new(1,1,1),
            BorderSizePixel=0,
            ZIndex=4,
            Parent=togBg,
        })
        Corner(togCircle, SIZE.ToggleCircle/2)
        Stroke(togCircle, Color3.fromRGB(180,180,180),1)

        local togBtn=New("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="",ZIndex=5,Parent=togBg})

        local function SetTog(s,fire)
            state=s
            Tw(togBg,{BackgroundColor3=s and Theme.ToggleOn or Theme.ToggleOff},TF)
            Tw(togCircle,{Position=s and UDim2.new(1,-SIZE.ToggleCircle-3,0.5,-SIZE.ToggleCircle/2) or UDim2.new(0,3,0.5,-SIZE.ToggleCircle/2)},TF)
            if fire and cb then cb(state) end
        end

        togBtn.MouseButton1Click:Connect(function() SetTog(not state,true) end)

        OnTheme(function()
            lbl.TextColor3=Theme.TextPrimary
            Tw(togBg,{BackgroundColor3=state and Theme.ToggleOn or Theme.ToggleOff},TF)
        end)

        return {GetValue=function() return state end, SetValue=function(v) SetTog(v,true) end}
    end

    function MObj:Slider(sTitle,min,max,default,cb)
        local curVal=math.clamp(default or min, min, max)
        local row=New("Frame",{Size=UDim2.new(1,0,0,46),BackgroundTransparency=1,ZIndex=3,Parent=Content})

        local top=New("Frame",{Size=UDim2.new(1,0,0,18),BackgroundTransparency=1,ZIndex=3,Parent=row})
        List(top,4,Enum.FillDirection.Horizontal,Enum.HorizontalAlignment.Left,Enum.VerticalAlignment.Center)
        New("TextLabel",{Size=UDim2.new(1,-36,1,0),BackgroundTransparency=1,Text=sTitle,TextColor3=Theme.TextPrimary,Font=Theme.Font,TextSize=SIZE.Small,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=1,ZIndex=3,Parent=top})
        local valL=New("TextLabel",{Size=UDim2.new(0,32,1,0),BackgroundTransparency=1,Text=tostring(curVal),TextColor3=Theme.Accent,Font=Enum.Font.Code,TextSize=SIZE.Small,TextXAlignment=Enum.TextXAlignment.Right,LayoutOrder=2,ZIndex=3,Parent=top})

        local track=New("TextButton",{Size=UDim2.new(1,0,0,5),Position=UDim2.new(0,0,0,24),BackgroundColor3=Theme.Search,Text="",AutoButtonColor=false,BorderSizePixel=0,ZIndex=3,Parent=row})
        Corner(track,3)
        local fill=New("Frame",{Size=UDim2.new((curVal-min)/(max-min),0,1,0),BackgroundColor3=Theme.Accent,BorderSizePixel=0,ZIndex=4,Parent=track})
        Corner(fill,3)
        local handle=New("Frame",{Size=UDim2.new(0,12,0,12),Position=UDim2.new((curVal-min)/(max-min),0,0.5,-6),AnchorPoint=Vector2.new(0.5,0.5),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=5,Parent=track})
        Corner(handle,6)
        Stroke(handle,Theme.Accent,2)

        local drag=false
        local function df(i)
            local rel=math.clamp((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
            curVal=math.floor(min+rel*(max-min))
            Tw(fill,{Size=UDim2.new(rel,0,1,0)},T0)
            Tw(handle,{Position=UDim2.new(rel,0,0.5,-6)},T0)
            valL.Text=tostring(curVal)
            if cb then cb(curVal) end
        end
        track.InputBegan:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=true df(i) end
        end)
        UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end end)
        UserInputService.InputChanged:Connect(function(i) if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then df(i) end end)

        OnTheme(function()
            track.BackgroundColor3=Theme.Search
            fill.BackgroundColor3=Theme.Accent
            Stroke(handle,Theme.Accent,2)
        end)

        return {GetValue=function() return curVal end}
    end

    function MObj:Destroy() MGui:Destroy() end

    -- Entry animation
    MFrame.GroupTransparency=1
    MFrame.Size=UDim2.new(0,W,0,0)
    Tw(MFrame,{GroupTransparency=0,Size=UDim2.new(0,W,0,H)},TSp)

    return MObj
end

