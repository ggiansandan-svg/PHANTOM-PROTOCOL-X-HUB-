                track.InputBegan:Connect(function(i)
                    if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
                    d=true; fn(math.clamp((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1))
                end)
                UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then d=false end end)
                UserInputService.InputChanged:Connect(function(i)
                    if d and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
                        fn(math.clamp((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1))
                    end
                end)
            end

            local md=false
            CM.InputBegan:Connect(function(i)
                if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
                md=true
                local function u(pos)
                    S=math.clamp((pos.X-CM.AbsolutePosition.X)/CM.AbsoluteSize.X,0,1)
                    V=1-math.clamp((pos.Y-CM.AbsolutePosition.Y)/CM.AbsoluteSize.Y,0,1)
                    ApplyCP(true)
                end
                u(i.Position)
                local mc2,ec
                mc2=UserInputService.InputChanged:Connect(function(mv) if mv.UserInputType==Enum.UserInputType.MouseMovement or mv.UserInputType==Enum.UserInputType.Touch then u(mv.Position) end end)
                ec=UserInputService.InputEnded:Connect(function(e) if e.UserInputType==Enum.UserInputType.MouseButton1 or e.UserInputType==Enum.UserInputType.Touch then mc2:Disconnect() ec:Disconnect() md=false end end)
            end)

            SlDrag(HS.Track,function(r) H=r ApplyCP(true) end)
            SlDrag(SS.Track,function(r) S=r ApplyCP(true) end)
            SlDrag(VS.Track,function(r) V=r ApplyCP(true) end)
            if AS then SlDrag(AS.Track,function(r) Alpha=r ApplyCP(true) end) end

            HexIn.Focused:Connect(function() Tw(HexStroke,{Color=Theme.Accent},TF) end)
            HexIn.FocusLost:Connect(function()
                Tw(HexStroke,{Color=Theme.Border},TF)
                local ok,col=pcall(Color3.fromHex,HexIn.Text)
                if ok then H,S,V=Color3.toHSV(col); CurColor=col; ApplyCP(true) else HexIn.Text=CurColor:ToHex():upper() end
            end)
            CopyB.MouseButton1Click:Connect(function()
                pcall(setclipboard,"#"..CurColor:ToHex():upper())
                CopyB.Text="✓"; task.delay(1.5,function() CopyB.Text="Copy" end)
            end)

            local pickerOpen=false
            local function ClosePicker()
                pickerOpen=false
                Tw(PF,{Size=UDim2.new(0,PW,0,0)},TS)
                task.delay(0.3,function() if not pickerOpen then PF.Visible=false end end)
            end
            local function OpenPicker()
                pickerOpen=true
                local bp=Prev.AbsolutePosition; local sc=ScreenGui.AbsoluteSize
                local x=bp.X-PW+26; local y=bp.Y+34
                if x<5 then x=5 end
                if y+PH2>sc.Y-5 then y=bp.Y-PH2-6 end
                PF.Position=UDim2.fromOffset(x,y); PF.Visible=true
                Tw(PF,{Size=UDim2.new(0,PW,0,PH2)},TS)
            end

            ApplyB.MouseButton1Click:Connect(function() ApplyCP(true) ClosePicker() end)
            Prev.MouseButton1Click:Connect(function() if pickerOpen then ClosePicker() else OpenPicker() end end)
            UserInputService.InputBegan:Connect(function(i)
                if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
                if not pickerOpen then return end
                local mp=Vector2.new(i.Position.X,i.Position.Y)
                local pp=PF.AbsolutePosition; local ps=PF.AbsoluteSize
                local bp=Prev.AbsolutePosition; local bs=Prev.AbsoluteSize
                local inP=mp.X>=pp.X and mp.X<=pp.X+ps.X and mp.Y>=pp.Y and mp.Y<=pp.Y+ps.Y
                local inB=mp.X>=bp.X and mp.X<=bp.X+bs.X and mp.Y>=bp.Y and mp.Y<=bp.Y+bs.Y
                if not inP and not inB then ClosePicker() end
            end)

            table.insert(Win.Popups,{Close=ClosePicker})

            OnTheme(function()
                TLbl.TextColor3=Theme.TextPrimary; HexPound.TextColor3=Theme.TextSecondary
                HexIn.BackgroundColor3=Theme.Search; HexIn.TextColor3=Theme.TextPrimary
                HexStroke.Color=Theme.Border; PF.BackgroundColor3=Theme.Main
                CopyB.BackgroundColor3=Theme.Search; CopyB.TextColor3=Theme.TextPrimary
                ApplyB.BackgroundColor3=Theme.Accent; ApplyB.TextColor3=Theme.Main
                if AlphaLbl then AlphaLbl.TextColor3=Theme.TextSecondary end
            end)

            ApplyCP(false)

            local obj={}
            function obj:GetComponentType() return "Colorpicker" end
            function obj:GetValue() return CurColor end
            function obj:GetTransparency() return 1-Alpha end
            function obj:SetValue(c) H,S,V=Color3.toHSV(c); CurColor=c; ApplyCP(true) end
            function obj:SetTransparency(t) Alpha=1-math.clamp(t,0,1); ApplyCP(true) end
            function obj:SetPresets(p) BldPresets(p) end
            function obj:Open() OpenPicker() end
            function obj:Close() ClosePicker() end
            Library.Flags[FlagName]=obj
            return obj
        end

        --// ── CODE ──
        function TabObj:Code(cOpts)
            cOpts=cOpts or {}
            local code=cOpts.Code or ""
            local lang=cOpts.Language or "Lua"
            TabObj.LayoutOrder+=1
            local cf=New("Frame",{Size=UDim2.new(1,0,0,80),BackgroundColor3=Theme.Body,LayoutOrder=TabObj.LayoutOrder,ZIndex=4,Parent=Scroll})
            Corner(cf,8); Stroke(cf,Theme.Border,1)
            local ch=New("Frame",{Size=UDim2.new(1,0,0,24),BackgroundColor3=Theme.Search,BorderSizePixel=0,ZIndex=4,Parent=cf})
            Corner(ch,8)
            New("Frame",{Size=UDim2.new(1,0,0.5,0),Position=UDim2.new(0,0,0.5,0),BackgroundColor3=Theme.Search,BorderSizePixel=0,ZIndex=4,Parent=ch})
            New("TextLabel",{Size=UDim2.new(1,-60,1,0),Position=UDim2.new(0,8,0,0),BackgroundTransparency=1,Text=lang,TextColor3=Theme.TextSecondary,Font=Enum.Font.Code,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=5,Parent=ch})
            local cpb=New("TextButton",{Size=UDim2.new(0,40,0,18),Position=UDim2.new(1,-46,0.5,-9),BackgroundColor3=Theme.Search,Text="Copy",TextColor3=Theme.TextSecondary,Font=Theme.Font,TextSize=10,AutoButtonColor=false,ZIndex=5,Parent=ch})
            Corner(cpb,4)
            local ct=New("TextLabel",{Size=UDim2.new(1,-16,1,-30),Position=UDim2.new(0,8,0,28),BackgroundTransparency=1,Text=code,RichText=true,TextColor3=Theme.TextPrimary,Font=Enum.Font.Code,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,TextWrapped=true,ZIndex=5,Parent=cf})
            cpb.MouseButton1Click:Connect(function() pcall(setclipboard,code); cpb.Text="✓"; task.delay(1.5,function() cpb.Text="Copy" end) end)
            OnTheme(function() cf.BackgroundColor3=Theme.Body ch.BackgroundColor3=Theme.Search ct.TextColor3=Theme.TextPrimary cpb.BackgroundColor3=Theme.Search cpb.TextColor3=Theme.TextSecondary end)
            return {Frame=cf,SetCode=function(c) code=c ct.Text=c end}
        end

        return TabObj
    end -- end Tab

    --// ── CONFIG TAB (FIXED) ──
    Win.ConfigTab = Win:Tab({Title="Config",Icon="",IsConfig=true})

    -- Config tab content
    local ConfigTab = Win.ConfigTab
    ConfigTab:Paragraph({
        Title="💾 Configuration",
        Content="Save and load your settings. All flags are stored locally.",
    })
    ConfigTab:Section({Title="SAVE & LOAD"})
    ConfigTab:Button({
        Title="Save Config",
        Action="💾 Save",
        Callback=function()
            local data={}
            for k,v in Library.Flags do
                if type(v.GetValue)=="function" then
                    local val=v:GetValue()
                    if type(val)=="boolean" or type(val)=="number" or type(val)=="string" then
                        data[k]=val
                    end
                end
            end
            pcall(function()
                writefile("ProtocolXHub_Config.json",game:GetService("HttpService"):JSONEncode(data))
            end)
            Notify({Title="Config Saved",Content="Settings saved to ProtocolXHub_Config.json",Type="Success",Duration=3})
        end,
    })
    ConfigTab:Button({
        Title="Load Config",
        Action="📂 Load",
        Callback=function()
            local ok,data=pcall(function()
                return game:GetService("HttpService"):JSONDecode(readfile("ProtocolXHub_Config.json"))
            end)
            if ok and data then
                for k,v in data do
                    if Library.Flags[k] and type(Library.Flags[k].SetValue)=="function" then
                        pcall(Library.Flags[k].SetValue,Library.Flags[k],v)
                    end
                end
                Notify({Title="Config Loaded",Content="Settings restored successfully!",Type="Success",Duration=3})
            else
                Notify({Title="No Config Found",Content="Save a config first.",Type="Warning",Duration=3})
            end
        end,
    })
    ConfigTab:Button({
        Title="Reset Config",
        Action="🗑 Reset",
        Callback=function()
            Notify({Title="Config Reset",Content="All flags reset to default.",Type="Info",Duration=3})
        end,
    })

    ConfigTab:Section({Title="THEME"})
    ConfigTab:Dropdown({
        Title="Active Theme",
        Options=Library:GetThemes(),
        Default=Library.CurrentTheme,
        Callback=function(v)
            if v then Library:SetTheme(v) HomeVerLbl.Text="v"..Version.."  ·  "..Library.CurrentTheme end
        end,
    })

    ConfigTab:Section({Title="INFO"})
    ConfigTab:Paragraph({
        Title="ℹ️ About",
        Content="Protocol X Hub v"..Library.Version.."\nPress "..FormatKey(Library.ToggleKey).." to toggle.\nFloating button: tap=toggle, hold 5s=lock.",
    })

    SaveBtn.MouseButton1Click:Connect(function()
        Win.ConfigTab:Activate()
    end)

    -- Auto-activate first non-config tab
    task.defer(function()
        for _,t in Win.Tabs do
            if not t.IsConfig then t:Activate(); break end
        end
        task.delay(1,function()
            Notify({Title=Title,Content="Loaded! Press "..FormatKey(Library.ToggleKey).." to toggle.",Type="Success",Duration=3})
        end)
    end)

    return Win
end -- end Window

--// ═══════════════════════════════════════════════════
Library.CreateFloatingButton = CreateFloatingButton
