--// Helpers
local function New(cls, p)
    local o = Instance.new(cls)
    for k,v in p do
        if k~="Parent" then pcall(function() o[k]=v end) end
    end
    if p.Parent then o.Parent=p.Parent end
    return o
end
local function Corner(par,r)
    return New("UICorner",{CornerRadius=UDim.new(0,r or SIZE.CornerR),Parent=par})
end
local function Stroke(par,c,t)
    return New("UIStroke",{Color=c or Color3.new(),Thickness=t or 1,Parent=par})
end
local function Pad(par,t,b,l,r)
    return New("UIPadding",{PaddingTop=UDim.new(0,t or 0),PaddingBottom=UDim.new(0,b or 0),PaddingLeft=UDim.new(0,l or 0),PaddingRight=UDim.new(0,r or 0),Parent=par})
end
local function List(par,pad,fd,ha,va)
    return New("UIListLayout",{SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,pad or 4),FillDirection=fd or Enum.FillDirection.Vertical,HorizontalAlignment=ha or Enum.HorizontalAlignment.Left,VerticalAlignment=va or Enum.VerticalAlignment.Top,Parent=par})
end
local function FormatKey(k)
    if not k then return "None" end
    local m={MouseButton1="MB1",MouseButton2="MB2",LeftShift="LShift",RightShift="RShift",LeftControl="LCtrl",RightControl="RCtrl",Return="Enter",BackSpace="Bksp"}
    return m[k.Name] or k.Name
end

