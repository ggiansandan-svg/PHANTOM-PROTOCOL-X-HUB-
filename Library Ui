local FBG, MainFB
function Lib:FloatButton(o)
    o = o or {}
    if FBG then FBG:Destroy() end
    FBG = C("ScreenGui",{Name="PXH_FB",ResetOnSpawn=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
    pcall(function() FBG.Parent = CG end)
    if not FBG.Parent then FBG.Parent = LP:WaitForChild("PlayerGui") end

    local sz = S(70)
    local Logo = o.Logo or ""
    local Title = o.Title or "Hub"

    MainFB = C("Frame",{
        Size=UDim2.new(0,sz+8,0,sz+8),
        Position=UDim2.new(0.01,0,0.4,0),
        BackgroundTransparency=1,
        Parent=FBG,
    })

    local glow = C("ImageLabel",{
        Size=UDim2.new(1,16,1,16),
        Position=UDim2.new(0,-8,0,-8),
        BackgroundTransparency=1,
        Image="rbxassetid://6015897843",
        ImageColor3=TH.Acc,
        ImageTransparency=0.5,
        ScaleType=Enum.ScaleType.Slice,
        SliceCenter=Rect.new(49,49,450,450),
        Parent=MainFB,
    })

    local btn = C("ImageButton",{
        Size=UDim2.new(0,sz,0,sz),
        Position=UDim2.new(0.5,0,0.5,0),
        AnchorPoint=Vector2.new(0.5,0.5),
        BackgroundColor3=TH.Main,
        Image="",
        AutoButtonColor=false,
        Parent=MainFB,
    })
    CR(btn, sz/4)
    local btnSt = ST(btn, TH.Acc, 2)
    C("Frame",{Size=UDim2.new(1,0,0.5,0),BackgroundColor3=Color3.new(1,1,1),BackgroundTransparency=0.92,BorderSizePixel=0,Parent=btn})
    C("ImageLabel",{Size=UDim2.new(1,-12,1,-12),Position=UDim2.new(0,6,0,6),BackgroundTransparency=1,Image=Logo,ScaleType=Enum.ScaleType.Fit,Parent=btn})
    C("TextLabel",{Size=UDim2.new(1,0,0,10),Position=UDim2.new(0,0,1,-12),BackgroundTransparency=1,Text=Title,TextColor3=Color3.new(1,1,1),TextTransparency=0.3,Font=Enum.Font.GothamBold,TextSize=7,TextXAlignment=Enum.TextXAlignment.Center,Parent=btn})

    local lockInd = C("Frame",{Size=UDim2.new(0,14,0,14),Position=UDim2.new(1,-2,0,-2),BackgroundColor3=Color3.fromRGB(255,200,0),BackgroundTransparency=1,BorderSizePixel=0,Parent=btn})
    CR(lockInd, 7)
    C("TextLabel",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="🔒",TextScaled=true,Parent=lockInd})

    local holdLbl = C("TextLabel",{Size=UDim2.new(1.3,0,1.3,0),Position=UDim2.new(-0.15,0,-0.15,0),BackgroundTransparency=1,Text="",TextColor3=TH.Acc,Font=Enum.Font.GothamBold,TextSize=12,Parent=btn})

    local locked = false
    local drag = false
    local startPos = 0
    local offset = Vector2.new()
    local holdConn

    local function SetLock(v)
        locked = v
        Tw(lockInd, {BackgroundTransparency = v and 0 or 1}, TF)
        Tw(btnSt, {Color = v and Color3.fromRGB(255,200,0) or TH.Acc}, TF)
        Tw(glow, {ImageColor3 = v and Color3.fromRGB(255,200,0) or TH.Acc}, TF)
        if v then Lib:Notify({Title="Locked 🔒",Content="Hold 5s to unlock"}) end
    end

    btn.InputBegan:Connect(function(i)
        if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
        startPos = tick()
        if holdConn then holdConn:Disconnect() end
        holdConn = RS.RenderStepped:Connect(function()
            local e = tick() - startPos
            if e >= 5 then
                holdConn:Disconnect(); holdConn = nil
                holdLbl.Text = ""
                SetLock(not locked)
            else
                local p = math.floor(e/5*100)
                holdLbl.Text = p > 3 and (p..(p>=100 and "" or "%")) or ""
            end
        end)
        if not locked then
            drag = true
            local p = MainFB.AbsolutePosition
            offset = Vector2.new(i.Position.X-p.X, i.Position.Y-p.Y)
        end
    end)

    btn.InputEnded:Connect(function(i)
        if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
        if holdConn then holdConn:Disconnect(); holdConn = nil end
        holdLbl.Text = ""
        local e = tick() - startPos
        drag = false
        if e < 0.4 and e >= 0.05 and o.OnClick then
            o.OnClick()
        end
    end)

    UIS.InputChanged:Connect(function(i)
        if drag and not locked and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local sc = FBG.AbsoluteSize
            local sz = MainFB.AbsoluteSize
            local x = math.clamp(i.Position.X - offset.X, 0, sc.X-sz.X)
            local y = math.clamp(i.Position.Y - offset.Y, 0, sc.Y-sz.Y)
            MainFB.Position = UDim2.fromOffset(x, y)
        end
    end)

    RS.RenderStepped:Connect(function()
        if not drag and not locked then
            glow.ImageTransparency = 0.5 + math.sin(tick()*2)*0.15
        end
    end)

    OnT(function()
        Tw(glow, {ImageColor3 = locked and Color3.fromRGB(255,200,0) or TH.Acc}, TF)
        Tw(btn, {BackgroundColor3 = TH.Main}, TF)
        Tw(btnSt, {Color = locked and Color3.fromRGB(255,200,0) or TH.Acc}, TF)
    end)

    return MainFB
end

