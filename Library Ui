--//  HELPERS
--// ═══════════════════════════════
local function New(cls, props)
    local o = Instance.new(cls)
    for k,v in props do
        if k~="Parent" then pcall(function() o[k]=v end) end
    end
    if props.Parent then o.Parent = props.Parent end
    return o
end
local function Corner(p,r) return New("UICorner",{CornerRadius=UDim.new(0,r or 8),Parent=p}) end
local function Stroke(p,c,t) return New("UIStroke",{Color=c or Color3.new(),Thickness=t or 1,Parent=p}) end
local function Pad(p,t,b,l,r) return New("UIPadding",{PaddingTop=UDim.new(0,t or 0),PaddingBottom=UDim.new(0,b or 0),PaddingLeft=UDim.new(0,l or 0),PaddingRight=UDim.new(0,r or 0),Parent=p}) end
local function List(p,pad,fd,ha,va)
    return New("UIListLayout",{SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,pad or 6),FillDirection=fd or Enum.FillDirection.Vertical,HorizontalAlignment=ha or Enum.HorizontalAlignment.Left,VerticalAlignment=va or Enum.VerticalAlignment.Top,Parent=p})
end
local function FormatKey(k)
    if not k then return "None" end
    local m={MouseButton1="MB1",MouseButton2="MB2",LeftShift="LShift",RightShift="RShift",LeftControl="LCtrl",RightControl="RCtrl",Return="Enter",BackSpace="Bksp"}
    return m[k.Name] or k.Name
end

