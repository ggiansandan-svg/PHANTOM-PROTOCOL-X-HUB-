--// Tween Infos
local TF  = TweenInfo.new(0.15, Enum.EasingStyle.Quad,  Enum.EasingDirection.Out)
local TS  = TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local TSp = TweenInfo.new(0.3,  Enum.EasingStyle.Back,  Enum.EasingDirection.Out)
local T0  = TweenInfo.new(0.04)

local function Tw(o, p, i)
    local t = TweenService:Create(o, i or TS, p)
    t:Play()
    return t
end

