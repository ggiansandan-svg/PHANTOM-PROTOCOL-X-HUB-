            local CurColor=Default

            local Row=CreateRow(compTitle)
            local TLbl=New("TextLabel",{Size=UDim2.new(0, IsMobile and 100 or 140, 1, 0),Position=UDim2.new(0,4,0,0),BackgroundTransparency=1,Text=compTitle,TextColor3=Theme.TextPrimary,Font=Theme.Font,TextSize=SIZE.Body,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=5,Parent=Row})

            local CPRight=New("Frame",{Size=UDim2.new(0, IsMobile and 130 or 160, 1, 0),Position=UDim2.new(1, IsMobile and -136 or -166, 0, 0),BackgroundTransparency=1,ZIndex=5,Parent=Row})
            List(CPRight,4,Enum.FillDirection.Horizontal,Enum.HorizontalAlignment.Right,Enum.VerticalAlignment.Center)

            local HexPound=New("TextLabel",{Size=UDim2.new(0,8,0,18),BackgroundTransparency=1,Text="#",TextColor3=Theme.TextSecondary,Font=Enum.Font.Code,TextSize=SIZE.Small,LayoutOrder=1,ZIndex=5,Parent=CPRight})
            local HexIn=New("TextBox",{Size=UDim2.new(0, IsMobile and 56 or 64, 0, S(24)),BackgroundColor3=Theme.Search,Text=CurColor:ToHex():upper(),TextColor3=Theme.TextPrimary,Font=Enum.Font.Code,TextSize=SIZE.Small,TextXAlignment=Enum.TextXAlignment.Center,ClearTextOnFocus=false,LayoutOrder=2,ZIndex=5,Parent=CPRight})
            Corner(HexIn,4); Stroke(HexIn,Theme.Border,1)
            local Prev=New("TextButton",{Size=UDim2.new(0, S(22), 0, S(22)),BackgroundColor3=CurColor,Text="",AutoButtonColor=false,LayoutOrder=3,ZIndex=5,Parent=CPRight})
            Corner(Prev,4); Stroke(Prev,Theme.Border,1)

            local PW=IsMobile and 200 or 220
            local PH2=170
            local PF=New("Frame",{Size=UDim2.new(0,PW,0,0),BackgroundColor3=Theme.Main,Visible=false,ClipsDescendants=true,ZIndex=8000,BorderSizePixel=0,Parent=ScreenGui})
            Corner(PF,8); Stroke(PF,Theme.Border,1)
            New("Frame",{Size=UDim2.new(1,0,1,0),BackgroundColor3=Color3.new(1,1,1),BackgroundTransparency=0.93,BorderSizePixel=0,ZIndex=8000,Parent=PF})
            New("UIDragDetector",{Parent=PF})
            Pad(PF,8,8,8,8)
            local PFL=List(PF,5)

            local CM=New("Frame",{Size=UDim2.new(1,0,0, S(100)),BackgroundColor3=Color3.fromHSV(H,1,1),ClipsDescendants=true,LayoutOrder=1,ZIndex=8001,Parent=PF})
            Corner(CM,5)
            New("Frame",{Size=UDim2.new(1,0,1,0),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=8002,Parent=CM})
            New("UIGradient",{Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,1)}),Parent=CM:FindFirstChildOfClass("Frame")})
            New("Frame",{Size=UDim2.new(1,0,1,0),BackgroundColor3=Color3.new(0,0,0),BorderSizePixel=0,ZIndex=8003,Parent=CM})
            New("UIGradient",{Rotation=90,Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)}),Parent=CM:FindFirstChildOfClass("Frame",true)})
            local MC=New("Frame",{Size=UDim2.new(0,12,0,12),AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.new(S,0,1-V,0),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=8004,Parent=CM})
            Corner(MC,6); Stroke(MC,Color3.new(1,1,1),2)

            local HS=MkSlider("Hue",true,2)
            local SS=MkSlider("Sat",false,3)
            local VS=MkSlider("Val",false,4)
            
            -- Helpers
            function MkSlider(lbl, hueGrad, lo)
                local sf=New("Frame",{Size=UDim2.new(1,0,0, S(36)),BackgroundTransparency=1,LayoutOrder=lo,ZIndex=8001,Parent=PF})
                local top=New("Frame",{Size=UDim2.new(1,0,0,12),BackgroundTransparency=1,ZIndex=8001,Parent=sf})
                List(top,2,Enum.FillDirection.Horizontal,Enum.HorizontalAlignment.Left,Enum.VerticalAlignment.Center)
                New("TextLabel",{Size=UDim2.new(1,-30,1,0),BackgroundTransparency=1,Text=lbl,TextColor3=Theme.TextSecondary,Font=Theme.Font,TextSize=SIZE.Small,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=1,ZIndex=8001,Parent=top})
                local vl=New("TextLabel",{Size=UDim2.new(0,28,1,0),BackgroundTransparency=1,Text="0",TextColor3=Theme.TextPrimary,Font=Enum.Font.Code,TextSize=SIZE.Small,TextXAlignment=Enum.TextXAlignment.Right,LayoutOrder=2,ZIndex=8001,Parent=top})
                local tr=New("TextButton",{Size=UDim2.new(1,0,0,8),Position=UDim2.new(0,0,0,18),BackgroundColor3=Theme.Search,Text="",AutoButtonColor=false,BorderSizePixel=0,ZIndex=8001,Parent=sf})
                Corner(tr,4)
                local gf=New("Frame",{Size=UDim2.new(1,0,1,0),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=8002,Parent=tr})
                Corner(gf,4)
                if hueGrad then New("UIGradient",{Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(255,0,0)),ColorSequenceKeypoint.new(0.17,Color3.fromRGB(255,255,0)),ColorSequenceKeypoint.new(0.33,Color3.fromRGB(0,255,0)),ColorSequenceKeypoint.new(0.5,Color3.fromRGB(0,255,255)),ColorSequenceKeypoint.new(0.67,Color3.fromRGB(0,0,255)),ColorSequenceKeypoint.new(0.83,Color3.fromRGB(255,0,255)),ColorSequenceKeypoint.new(1,Color3.fromRGB(255,0,0))}),Parent=gf}) end
                local cur=New("Frame",{Size=UDim2.new(0,12,0,12),AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.new(0,0,0.5,0),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=8003,Parent=tr})
                Corner(cur,6); Stroke(cur,Theme.Border,2)
                return {Track=tr,GF=gf,ValLbl=vl,Cursor=cur}
            end

            local function UpdSatG()
                local p=Color3.fromHSV(H,1,1)
                SS.GF.BackgroundColor3=p
                New("UIGradient",{Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.new(1,1,1)),ColorSequenceKeypoint.new(1,p)}),Parent=SS.GF})
            end
            local function UpdValG()
                New("UIGradient",{Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.new(0,0,0)),ColorSequenceKeypoint.new(1,Color3.fromHSV(H,S,1))}),Parent=VS.GF})
            end
            function ApplyCP(fire)
                CurColor=Color3.fromHSV(H,S,V)
                CM.BackgroundColor3=Color3.fromHSV(H,1,1)
                Tw(MC,{Position=UDim2.new(S,0,1-V,0)},T0)
                Tw(HS.Cursor,{Position=UDim2.new(H,0,0.5,0)},T0); HS.ValLbl.Text=math.floor(H*360).."°"
                UpdSatG(); Tw(SS.Cursor,{Position=UDim2.new(S,0,0.5,0)},T0); SS.ValLbl.Text=math.floor(S*100).."%"
                UpdValG(); Tw(VS.Cursor,{Position=UDim2.new(V,0,0.5,0)},T0); VS.ValLbl.Text=math.floor(V*100).."%"
                Prev.BackgroundColor3=CurColor; HexIn.Text=CurColor:ToHex():upper()
                if fire then Callback(CurColor) end
            end

            local function SlDrag(track,fn)
                local d=false
                track.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then d=true fn(math.clamp((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)) end end)
                UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then d=false end end)
                UserInputService.InputChanged:Connect(function(i) if d and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then fn(math.clamp((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)) end end)
            end

            CM.InputBegan:Connect(function(i)
                if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
                local function u(p)
                    S=math.clamp((p.X-CM.AbsolutePosition.X)/CM.AbsoluteSize.X,0,1)
                    V=1-math.clamp((p.Y-CM.AbsolutePosition.Y)/CM.AbsoluteSize.Y,0,1)
                    ApplyCP(true)
                end
                u(i.Position)
                local mc2,ec
                mc2=UserInputService.InputChanged:Connect(function(mv) if mv.UserInputType==Enum.UserInputType.MouseMovement or mv.UserInputType==Enum.UserInputType.Touch then u(mv.Position) end end)
                ec=UserInputService.InputEnded:Connect(function(e) if e.UserInputType==Enum.UserInputType.MouseButton1 or e.UserInputType==Enum.UserInputType.Touch then mc2:Disconnect() ec:Disconnect() end end)
            end)

            SlDrag(HS.Track,function(r) H=r ApplyCP(true) end)
            SlDrag(SS.Track,function(r) S=r ApplyCP(true) end)
            SlDrag(VS.Track,function(r) V=r ApplyCP(true) end)

            HexIn.FocusLost:Connect(function()
                local ok,col=pcall(Color3.fromHex,HexIn.Text)
                if ok then H,S,V=Color3.toHSV(col); CurColor=col; ApplyCP(true) else HexIn.Text=CurColor:ToHex():upper() end
            end)

            local pickerOpen=false
            local function ClosePicker()
                pickerOpen=false
                Tw(PF,{Size=UDim2.new(0,PW,0,0)},TS)
                task.delay(0.3,function() if not pickerOpen then PF.Visible=false end end)
            end
            local function OpenPicker()
                pickerOpen=true
                local bp=Prev.AbsolutePosition; local sc=ScreenGui.AbsoluteSize
                local x=bp.X-PW+20; local y=bp.Y+30
                if x<5 then x=5 end
                if y+PH2>sc.Y-5 then y=bp.Y-PH2-4 end
                PF.Position=UDim2.fromOffset(x,y); PF.Visible=true
                Tw(PF,{Size=UDim2.new(0,PW,0,PH2)},TS)
            end
            Prev.MouseButton1Click:Connect(function() if pickerOpen then ClosePicker() else OpenPicker() end end)
            UserInputService.InputBegan:Connect(function(i)
                if i.UserInputType~=Enum.UserInputType.MouseButton1 then return end
                if not pickerOpen then return end
                local mp=Vector2.new(i.Position.X,i.Position.Y)
                local pp=PF.AbsolutePosition; local ps=PF.AbsoluteSize
                local bp=Prev.AbsolutePosition; local bs=Prev.AbsoluteSize
                local inP=mp.X>=pp.X and mp.X<=pp.X+ps.X and mp.Y>=pp.Y and mp.Y<=pp.Y+ps.Y
                local inB=mp.X>=bp.X and mp.X<=bp.X+bs.X and mp.Y>=bp.Y and mp.Y<=bp.Y+bs.Y
                if not inP and not inB then ClosePicker() end
            end)

            table.insert(Win.Popups,{Close=ClosePicker})
            OnTheme(function() TLbl.TextColor3=Theme.TextPrimary HexIn.BackgroundColor3=Theme.Search HexIn.TextColor3=Theme.TextPrimary PF.BackgroundColor3=Theme.Main end)

            ApplyCP(false)
            local obj={}
            function obj:GetComponentType() return "Colorpicker" end
            function obj:GetValue() return CurColor end
            function obj:SetValue(c) H,S,V=Color3.toHSV(c); CurColor=c; ApplyCP(true) end
            function obj:Open() OpenPicker() end
            function obj:Close() ClosePicker() end
            Library.Flags[FlagName]=obj
            return obj
        end

        return TabObj
    end

    --// ── CONFIG TAB ──
    Win.ConfigTab = Win:Tab({Title="Config", Emoji="💾", IsConfig=true})

    local ConfigTab = Win.ConfigTab
    ConfigTab:Paragraph({Title="💾 Configuration",Content="Save and load your settings locally."})
    ConfigTab:Section({Title="SAVE & LOAD"})
    ConfigTab:Button({Title="Save Config",Action="💾 Save",Callback=function()
        local data={}
        for k,v in Library.Flags do
            if type(v.GetValue)=="function" then
                local val=v:GetValue()
                if type(val)=="boolean" or type(val)=="number" or type(val)=="string" then
                    data[k]=val
                end
            end
        end
        pcall(function() writefile("ProtocolXHub_Config.json",game:GetService("HttpService"):JSONEncode(data)) end)
        Library.Notify({Title="Config Saved",Content="Settings saved!",Type="Success",Duration=3})
    end})
    ConfigTab:Button({Title="Load Config",Action="📂 Load",Callback=function()
        local ok,data=pcall(function() return game:GetService("HttpService"):JSONDecode(readfile("ProtocolXHub_Config.json")) end)
        if ok and data then
            for k,v in data do
                if Library.Flags[k] and type(Library.Flags[k].SetValue)=="function" then
                    pcall(Library.Flags[k].SetValue,Library.Flags[k],v)
                end
            end
            Library.Notify({Title="Config Loaded",Content="Settings restored!",Type="Success",Duration=3})
        else
            Library.Notify({Title="No Config",Content="Save first.",Type="Warning",Duration=3})
        end
    end})
    ConfigTab:Button({Title="Reset Config",Action="🗑 Reset",Callback=function()
        Library.Notify({Title="Reset",Content="All flags reset.",Type="Info",Duration=2})
    end})
    ConfigTab:Section({Title="THEME"})
    ConfigTab:Dropdown({Title="Active Theme",Options=Library:GetThemes(),Default=Library.CurrentTheme,Callback=function(v) if v then Library:SetTheme(v) HomeVerLbl.Text="v"..Version.."  ·  "..Library.CurrentTheme end end})
    ConfigTab:Section({Title="INFO"})
    ConfigTab:Paragraph({Title="ℹ️ About",Content="Protocol X Hub v"..Library.Version.."\nPress "..FormatKey(Library.ToggleKey).." to toggle.\nFloat button: tap=toggle, hold 5s=lock."})

    SaveBtn.MouseButton1Click:Connect(function() Win.ConfigTab:Activate() end)

    -- Auto-activate first tab
    task.defer(function()
        for _,t in Win.Tabs do
            if not t.IsConfig then t:Activate(); break end
        end
        task.delay(0.8,function()
            Library.Notify({Title=Title,Content="Loaded! Press "..FormatKey(Library.ToggleKey).." to toggle.",Type="Success",Duration=3})
        end)
    end)

    Library._WinRef = Win
    return Win
end

return Library
