local function Tw(o, p, i) TweenService:Create(o, i or TM, p):Play() end

--// HELPER
local function C(cls, p)
    local x = Instance.new(cls)
    for k,v in pairs(p) do if k ~= "Parent" then pcall(function() x[k] = v end) end end
    if p.Parent then x.Parent = p.Parent end
    return x
end

local function CR(o, r) return C("UICorner", {CornerRadius = UDim.new(0, r or 8), Parent = o}) end
local function ST(o, cl, t) return C("UIStroke", {Color = cl or Color3.new(), Thickness = t or 1, Parent = o}) end

local function FK(k)
    if not k then return "None" end
    local m = {MouseButton1="MB1",LeftShift="LShift",RightShift="RShift",LeftControl="LCtrl",RightControl="RCtrl",Return="Enter"}
    return m[k.Name] or k.Name
end

