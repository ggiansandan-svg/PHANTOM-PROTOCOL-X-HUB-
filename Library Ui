            wTxt.TextColor3=Theme.TextPrimary
        end)

        local wmO={Frame=wf,Pos="TopLeft",Text=initText or ""}

        function wmO:UpdateSize()
            local clean=self.Text:gsub("<[^>]->","")
            local w=TextService:GetTextSize(clean, IsMobile and 10 or 11, Enum.Font.Code, Vector2.new(10000, S(26))).X
            wf.Size=UDim2.fromOffset(w+20, S(26))
        end

        function wmO:UpdatePosition()
            local mfp=Main.AbsolutePosition; local mfs=Main.AbsoluteSize
            local ws_=wf.AbsoluteSize; local pad=6
            local p
            if Win.Visible then
                p={
                    TopLeft    ={UDim2.fromOffset(mfp.X, mfp.Y-ws_.Y-pad), Vector2.new(0,0)},
                    TopRight   ={UDim2.fromOffset(mfp.X+mfs.X, mfp.Y-ws_.Y-pad), Vector2.new(1,0)},
                    BottomLeft ={UDim2.fromOffset(mfp.X, mfp.Y+mfs.Y+pad), Vector2.new(0,0)},
                    BottomRight={UDim2.fromOffset(mfp.X+mfs.X, mfp.Y+mfs.Y+pad), Vector2.new(1,0)},
                }
            else
                p={
                    TopLeft    ={UDim2.new(0,8,0,8), Vector2.new(0,0)},
                    TopRight   ={UDim2.new(1,-8,0,8), Vector2.new(1,0)},
                    BottomLeft ={UDim2.new(0,8,1,-8), Vector2.new(0,1)},
                    BottomRight={UDim2.new(1,-8,1,-8), Vector2.new(1,1)},
                }
            end
            local pp=p[self.Pos] or p.TopLeft
            wf.Position=pp[1]; wf.AnchorPoint=pp[2]
        end

        function wmO:SetText(t) self.Text=t wTxt.Text=t self:UpdateSize() self:UpdatePosition() end
        function wmO:SetPosition(p) self.Pos=p self:UpdatePosition() end
        function wmO:SetVisible(v) wf.Visible=v end

        wf:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() wmO:UpdatePosition() end)
        Main:GetPropertyChangedSignal("AbsolutePosition"):Connect(function() wmO:UpdatePosition() end)
        Main:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() wmO:UpdatePosition() end)

        wmO:UpdateSize()
        wmO:SetPosition("TopLeft")
        task.defer(function() wmO:UpdatePosition() end)
        table.insert(Win.Watermarks,wmO)
        return wmO
    end

