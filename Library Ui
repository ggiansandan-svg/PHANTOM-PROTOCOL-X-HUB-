    Flags        = {},
    CurrentTheme = "Dark",
    Version      = "3.0.0",
}
local Theme      = Themes["Dark"]
local ThemeCBs   = {}
local function OnTheme(fn) table.insert(ThemeCBs,fn) end
local function FireTheme() for _,fn in ThemeCBs do task.spawn(fn) end end

function Library:SetTheme(name)
    if not Themes[name] then return end
    Theme = Themes[name]
    self.CurrentTheme = name
    FireTheme()
end
function Library:GetThemes()
    local t={} for k in Themes do table.insert(t,k) end table.sort(t) return t
end
function Library:SetWindowKeybind(k) self.ToggleKey=k end

