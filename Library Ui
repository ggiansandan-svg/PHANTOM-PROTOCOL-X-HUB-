--// LIBRARY
local Lib = {Flags={}, CurTheme="Dark", ToggleKey=Enum.KeyCode.RightControl, Win=nil}
local TH = Themes.Dark
local TCBs = {}
local function OnT(fn) table.insert(TCBs,fn) end
local function FireT() for _,fn in TCBs do task.spawn(fn) end end

function Lib:SetTheme(n)
    if not Themes[n] then return end
    TH = Themes[n]
    self.CurTheme = n
    FireT()
end

function Lib:GetThemes()
    local t = {} for k in Themes do table.insert(t,k) end table.sort(t) return t
end

function Lib:BindKey(k) self.ToggleKey = k end

--// NOTIFY
local NotifGui
function Lib:Notify(o)
    o = o or {}
    if not NotifGui or not NotifGui.Parent then
        NotifGui = C("ScreenGui",{Name="PXH_Notif",ResetOnSpawn=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
        pcall(function() NotifGui.Parent = CG end)
        if not NotifGui.Parent then NotifGui.Parent = LP:WaitForChild("PlayerGui") end
    end
    local title = o.Title or "Notice"
    local msg = o.Content or ""
    local dur = o.Duration or 3
    local clrs = {Info=Color3.fromRGB(47,129,247),Success=Color3.fromRGB(46,200,110),Warning=Color3.fromRGB(240,190,0),Error=Color3.fromRGB(230,70,60)}
    local cl = clrs[o.Type or "Info"] or clrs.Info

    local card = C("Frame",{Size=UDim2.new(0,S(280),0,S(56)),BackgroundColor3=TH.Main,Position=UDim2.new(1,10,0,0),Parent=NotifGui})
    CR(card, 8); ST(card, TH.Brd)
    C("Frame",{Size=UDim2.new(0,3,1,-12),Position=UDim2.new(0,8,0,6),BackgroundColor3=cl,BorderSizePixel=0,Parent=card})
    C("TextLabel",{Size=UDim2.new(1,-24,0,S(16)),Position=UDim2.new(0,18,0,S(6)),BackgroundTransparency=1,Text=title,TextColor3=TH.T1,Font=Enum.Font.GothamBold,TextSize=S(11),TextXAlignment=Enum.TextXAlignment.Left,Parent=card})
    C("TextLabel",{Size=UDim2.new(1,-24,0,S(28)),Position=UDim2.new(0,18,0,S(22)),BackgroundTransparency=1,Text=msg,TextColor3=TH.T2,Font=Enum.Font.Gotham,TextSize=S(10),TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true,Parent=card})
    C("Frame",{Size=UDim2.new(1,0,0,2),Position=UDim2.new(0,0,1,-2),BackgroundColor3=cl,BorderSizePixel=0,Parent=card})

    Tw(card, {Position=UDim2.new(0,0,0,0)}, TM)
    TweenService:Create(card:FindFirstChildWhichIsA("Frame",true), TweenInfo.new(dur, Enum.EasingStyle.Linear), {Size=UDim2.new(0,0,0,2)}):Play()
    task.delay(dur, function() Tw(card,{Position=UDim2.new(1,10,0,0)},TM) task.wait(0.3) card:Destroy() end)
end

