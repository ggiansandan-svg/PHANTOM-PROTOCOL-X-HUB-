            UIS.InputChanged:Connect(function(i) if d and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then dd(i) end end)
            OnT(function() tk.BackgroundColor3=TH.Search fl.BackgroundColor3=TH.Acc ST(hd,TH.Acc,2) end)
            local o = {}
            function o:Type() return "Slider" end
            function o:Get() return v end
            function o:Set(x) v=math.clamp(snap(x),mn,mx) uv() cb(v) end
