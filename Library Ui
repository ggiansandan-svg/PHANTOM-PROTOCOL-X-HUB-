local _NotifGui, _NotifList
local function EnsureNotif()
    if _NotifGui and _NotifGui.Parent then return end
    _NotifGui = New("ScreenGui",{Name="PXH_Notifs",ResetOnSpawn=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
    pcall(function() _NotifGui.Parent=CoreGui end)
    if not _NotifGui.Parent then _NotifGui.Parent=LocalPlayer:WaitForChild("PlayerGui") end
    _NotifList = New("Frame",{
        Size=UDim2.new(0,300,1,-20),
        Position=UDim2.new(1,-310,0,10),
        BackgroundTransparency=1,
        Parent=_NotifGui
    })
    List(_NotifList,8,Enum.FillDirection.Vertical,Enum.HorizontalAlignment.Right,Enum.VerticalAlignment.Bottom)
end

local function Notify(opts)
    EnsureNotif()
    opts=opts or {}
    local title=opts.Title or "Notice"
    local content=opts.Content or ""
    local dur=opts.Duration or 3
    local ntype=opts.Type or "Info"
    local cols={Info=Color3.fromRGB(47,129,247),Success=Color3.fromRGB(46,200,110),Warning=Color3.fromRGB(240,190,0),Error=Color3.fromRGB(230,70,60)}
    local col=cols[ntype] or cols.Info

    local card=New("Frame",{Size=UDim2.new(1,0,0,74),BackgroundColor3=Theme.Main,ClipsDescendants=true,Position=UDim2.new(1,10,0,0),Parent=_NotifList})
    Corner(card,10)
    Stroke(card,Theme.Border,1)

    -- Glass effect
    New("Frame",{Size=UDim2.new(1,0,1,0),BackgroundColor3=Color3.new(1,1,1),BackgroundTransparency=0.92,BorderSizePixel=0,ZIndex=0,Parent=card})

    local topLine=New("Frame",{Size=UDim2.new(1,0,0,2),BackgroundColor3=col,BorderSizePixel=0,ZIndex=2,Parent=card})
    New("UIGradient",{Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.1,0),NumberSequenceKeypoint.new(0.9,0),NumberSequenceKeypoint.new(1,1)}),Parent=topLine})

    local sideBar=New("Frame",{Size=UDim2.new(0,3,1,-16),Position=UDim2.new(0,10,0,8),BackgroundColor3=col,BorderSizePixel=0,ZIndex=2,Parent=card})
    Corner(sideBar,2)

    New("TextLabel",{Size=UDim2.new(1,-40,0,22),Position=UDim2.new(0,22,0,10),BackgroundTransparency=1,Text=title,TextColor3=Theme.TextPrimary,Font=Enum.Font.GothamBold,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=2,Parent=card})
    New("TextLabel",{Size=UDim2.new(1,-28,0,34),Position=UDim2.new(0,22,0,34),BackgroundTransparency=1,Text=content,TextColor3=Theme.TextSecondary,Font=Theme.Font,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true,ZIndex=2,Parent=card})

    local closeB=New("TextButton",{Size=UDim2.new(0,18,0,18),Position=UDim2.new(1,-24,0,8),BackgroundTransparency=1,Text="✕",TextColor3=Theme.TextSecondary,Font=Enum.Font.GothamBold,TextSize=12,ZIndex=3,Parent=card})

    local prog=New("Frame",{Size=UDim2.new(1,0,0,2),Position=UDim2.new(0,0,1,-2),BackgroundColor3=col,BorderSizePixel=0,ZIndex=2,Parent=card})
    Corner(prog,1)

    Tw(card,{Position=UDim2.new(0,0,0,0)},TS)
    Tw(prog,{Size=UDim2.new(0,0,0,2)},TweenInfo.new(dur,Enum.EasingStyle.Linear))

    local closed=false
    local function Close()
        if closed then return end; closed=true
        Tw(card,{Position=UDim2.new(1,10,0,0)},TS)
        task.delay(0.3,function() card:Destroy() end)
    end
    closeB.MouseButton1Click:Connect(Close)
    task.delay(dur,Close)
    return {Close=Close}
end
Library.Notify = Notify

