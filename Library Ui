local function CreateFloatingButton(opts)
    opts = opts or {}
    local Logo     = opts.Logo     or ""
    local Title    = opts.Title    or "Protocol X Hub"
    local OnClick  = opts.OnClick  or function() end

    local FBGui = New("ScreenGui",{Name="PXH_FloatBtn",ResetOnSpawn=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling})
    pcall(function() FBGui.Parent=CoreGui end)
    if not FBGui.Parent then FBGui.Parent=LocalPlayer:WaitForChild("PlayerGui") end

    local sz = SIZE.FBSize
    local startX = IsMobile and 0.01 or 0.005
    local startY = IsMobile and 0.32 or 0.4

    -- Outer glow frame
    local GlowFrame = New("Frame",{
        Size=UDim2.new(0, sz+10, 0, sz+10),
        Position=UDim2.new(startX,0,startY,0),
        BackgroundTransparency=1,
        Parent=FBGui,
    })

    local GlowImg = New("ImageLabel",{
        Size=UDim2.new(1,20,1,20),
        Position=UDim2.new(0,-10,0,-10),
        BackgroundTransparency=1,
        Image="rbxassetid://6015897843",
        ImageColor3=Theme.Accent,
        ImageTransparency=0.4,
        ScaleType=Enum.ScaleType.Slice,
        SliceCenter=Rect.new(49,49,450,450),
        Parent=GlowFrame,
    })

    -- Main button
    local MainBtn = New("ImageButton",{
        Size=UDim2.new(0,sz,0,sz),
        Position=UDim2.new(0.5,0,0.5,0),
        AnchorPoint=Vector2.new(0.5,0.5),
        BackgroundColor3=Theme.Main,
        Image="",
        AutoButtonColor=false,
        ZIndex=2,
        Parent=GlowFrame,
    })
    Corner(MainBtn, sz/4)
    local BtnStroke = Stroke(MainBtn, Theme.Accent, 2)

    -- Glass overlay
    New("Frame",{
        Size=UDim2.new(1,0,0.5,0),
        BackgroundColor3=Color3.new(1,1,1),
        BackgroundTransparency=0.92,
        BorderSizePixel=0,
        ZIndex=3,
        Parent=MainBtn,
    })

    -- Logo image (PROPERLY SIZED)
    local LogoImg = New("ImageLabel",{
        Size=UDim2.new(0, sz-20, 0, sz-20),
        Position=UDim2.new(0, 10, 0, 10),
        BackgroundTransparency=1,
        Image=Logo,
        ScaleType=Enum.ScaleType.Fit,
        ZIndex=4,
        Parent=MainBtn,
    })

    -- Title text below logo
    local TitleUnder = New("TextLabel",{
        Size=UDim2.new(1,0,0,12),
        Position=UDim2.new(0,0,1,-14),
        BackgroundTransparency=1,
        Text=Title,
        TextColor3=Color3.new(1,1,1),
        TextTransparency=0.2,
        Font=Enum.Font.GothamBold,
        TextSize=IsMobile and 7 or 8,
        TextXAlignment=Enum.TextXAlignment.Center,
        ZIndex=5,
        Parent=MainBtn,
    })

    -- Bottom accent bar
    local AccentBar = New("Frame",{
        Size=UDim2.new(0,sz-12,0,3),
        Position=UDim2.new(0,6,1,3),
        BackgroundColor3=Theme.Accent,
        BorderSizePixel=0,
        ZIndex=2,
        Parent=GlowFrame,
    })
    Corner(AccentBar,2)

    -- Lock indicator
    local LockIndicator = New("Frame",{
        Size=UDim2.new(0, IsMobile and 14 or 16, 0, IsMobile and 14 or 16),
        Position=UDim2.new(1,-2,0,-2),
        BackgroundColor3=Color3.fromRGB(255,200,0),
        BackgroundTransparency=1,
        ZIndex=6,
        Parent=MainBtn,
    })
    Corner(LockIndicator, 8)
    local LockIcn = New("TextLabel",{
        Size=UDim2.new(1,0,1,0),
        BackgroundTransparency=1,
        Text="🔒",
        TextScaled=true,
        ZIndex=7,
        Parent=LockIndicator,
    })

    local isLocked   = false
    local isDragging = false
    local holdStart  = 0
    local dragOffset = Vector2.new()

    -- Hold progress
    local HoldLabel = New("TextLabel",{
        Size=UDim2.new(1.2,0,1.2,0),
        Position=UDim2.new(-0.1,0,-0.1,0),
        BackgroundTransparency=1,
        Text="",
        TextColor3=Theme.Accent,
        Font=Enum.Font.GothamBold,
        TextSize=IsMobile and 12 or 14,
        ZIndex=8,
        Parent=MainBtn,
    })

    local holdConn = nil

    local function SetLock(locked)
        isLocked = locked
        LockIndicator.BackgroundTransparency = locked and 0 or 1
        BtnStroke.Color = locked and Color3.fromRGB(255,200,0) or Theme.Accent
        GlowImg.ImageColor3 = locked and Color3.fromRGB(255,200,0) or Theme.Accent
        AccentBar.BackgroundColor3 = locked and Color3.fromRGB(255,200,0) or Theme.Accent

        if locked then
            Library.Notify({Title="Button Locked 🔒",Content="Hold 5 seconds to unlock.",Type="Warning",Duration=2})
        else
            Library.Notify({Title="Button Unlocked 🔓",Content="You can now drag the button.",Type="Info",Duration=2})
        end
    end

    local function StartDrag(inp)
        if isLocked then return end
        isDragging=true
        local gp=GlowFrame.AbsolutePosition
        dragOffset=Vector2.new(inp.X-gp.X, inp.Y-gp.Y)
    end

    local function DoDrag(inp)
        if not isDragging or isLocked then return end
        local sc=FBGui.AbsoluteSize
        local gs=GlowFrame.AbsoluteSize
        local nx=math.clamp(inp.X-dragOffset.X, 0, sc.X-gs.X)
        local ny=math.clamp(inp.Y-dragOffset.Y, 0, sc.Y-gs.Y)
        GlowFrame.Position=UDim2.fromOffset(nx,ny)
    end

    MainBtn.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
            holdStart=tick()

            if holdConn then holdConn:Disconnect() end
            holdConn=RunService.RenderStepped:Connect(function()
                local elapsed=tick()-holdStart
                if elapsed>=5 then
                    holdConn:Disconnect(); holdConn=nil
                    HoldLabel.Text=""
                    SetLock(not isLocked)
                else
                    local pct=math.floor(elapsed/5*100)
                    if pct>3 then
                        HoldLabel.Text=pct..(pct>=100 and "" or "%")
                    end
                end
            end)

            if not isLocked then StartDrag(inp) end
        end
    end)

    MainBtn.InputEnded:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
            local elapsed=tick()-holdStart
            if holdConn then holdConn:Disconnect(); holdConn=nil end
            HoldLabel.Text=""
            isDragging=false
            if elapsed<0.3 and elapsed>=0.05 then
                OnClick()
            end
        end
    end)

    UserInputService.InputChanged:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch then
            DoDrag(inp)
        end
    end)

    -- Pulse
    RunService.RenderStepped:Connect(function()
        if not isDragging and not isLocked then
            local t=tick()
            GlowImg.ImageTransparency = 0.4 + math.sin(t*2)*0.15
        end
    end)

    OnTheme(function()
        GlowImg.ImageColor3 = isLocked and Color3.fromRGB(255,200,0) or Theme.Accent
        BtnStroke.Color = isLocked and Color3.fromRGB(255,200,0) or Theme.Accent
        MainBtn.BackgroundColor3 = Theme.Main
        AccentBar.BackgroundColor3 = isLocked and Color3.fromRGB(255,200,0) or Theme.Accent
    end)

    local FBObj = {Frame=GlowFrame, Gui=FBGui}
    function FBObj:SetLogo(img) LogoImg.Image=img end
    function FBObj:SetTitle(t) TitleUnder.Text=t end
    function FBObj:SetVisible(v) FBGui.Enabled=v end
    function FBObj:Destroy() FBGui:Destroy() end

    return FBObj
end

